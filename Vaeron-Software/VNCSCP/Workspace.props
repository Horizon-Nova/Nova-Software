<Project>
  <!--
    工作區慣例。新工作區只需修改本檔。
    Directory.Build.props / .targets 與 Structure.targets 全部讀這裡,不寫死任何名稱。
  -->
  <PropertyGroup>
    <WorkspacePrefix>Vaeron</WorkspacePrefix>
    <SharedFolderName>Shared</SharedFolderName>
    <BuildFolderName>Build</BuildFolderName>
    <TemplateFolderName>Templates</TemplateFolderName>

    <BaseTfm>net10.0</BaseTfm>
    <WindowsTfm>net10.0-windows</WindowsTfm>

    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
