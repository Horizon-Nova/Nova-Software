<UserControl x:Class="Vaeron.VNCSCP.Internal.Wpf.Components.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vaeron.VNCSCP.Internal.Wpf.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <PasswordBox x:Name="MaskedBox" Margin="0"
                         Tag="{Binding Watermark, RelativeSource={RelativeSource AncestorType={x:Type local:RevealablePasswordBox}}}" />
            <TextBox x:Name="RevealedBox" Margin="0" Visibility="Collapsed"
                     Tag="{Binding RevealedWatermark, RelativeSource={RelativeSource AncestorType={x:Type local:RevealablePasswordBox}}}" />
        </Grid>

        <Button Grid.Column="1" Style="{StaticResource FlatIconButtonStyle}" ToolTip="顯示／隱藏已存密碼"
                Click="OnToggleRevealClick">
            <Path Data="{StaticResource IconEyeGeometry}" Stroke="{StaticResource TextSecondary}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="15" Height="15" Stretch="Uniform" />
        </Button>
    </Grid>
</UserControl>
