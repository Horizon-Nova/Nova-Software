<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 圖示向量幾何具名資源 -->

    <!-- plus.svg：新增 -->
    <PathGeometry x:Key="IconPlusGeometry" Figures="M5 12h14 M12 5v14" />

    <!-- trash-2.svg：刪除 -->
    <PathGeometry x:Key="IconDeleteGeometry"
                  Figures="M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

    <!-- x.svg：取消/關閉 -->
    <PathGeometry x:Key="IconCloseGeometry" Figures="M18,6 L6,18 M6,6 L18,18" />

    <!-- menu.svg：側邊欄摺疊漢堡鈕 -->
    <PathGeometry x:Key="IconMenuGeometry" Figures="M4 5h16 M4 12h16 M4 19h16" />

    <!-- minus.svg：視窗最小化 -->
    <PathGeometry x:Key="IconMinimizeGeometry" Figures="M5 12h14" />

    <!-- maximize.svg：視窗最大化 -->
    <PathGeometry x:Key="IconMaximizeGeometry"
                  Figures="M8 3H5a2 2 0 0 0-2 2v3 M21 8V5a2 2 0 0 0-2-2h-3 M3 16v3a2 2 0 0 0 2 2h3 M16 21h3a2 2 0 0 0 2-2v-3" />

    <!-- copy.svg：視窗還原 -->
    <GeometryGroup x:Key="IconRestoreGeometry">
        <RectangleGeometry Rect="8,8,14,14" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </GeometryGroup>

    <!-- search.svg：搜尋框 -->
    <GeometryGroup x:Key="IconSearchGeometry">
        <EllipseGeometry Center="11,11" RadiusX="8" RadiusY="8" />
        <LineGeometry StartPoint="21,21" EndPoint="16.66,16.66" />
    </GeometryGroup>

    <!-- chevron-down.svg：展開/收合 -->
    <PathGeometry x:Key="IconChevronDownGeometry" Figures="M6,9 L12,15 L18,9" />

    <!-- pencil.svg：編輯 -->
    <PathGeometry x:Key="IconEditGeometry"
                  Figures="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z M15 5l4 4" />

    <!-- wifi.svg：測試連線／測試全部 -->
    <GeometryGroup x:Key="IconTestGeometry">
        <PathGeometry Figures="M2 8.82a15 15 0 0 1 20 0 M5 12.859a10 10 0 0 1 14 0 M8.5 16.429a5 5 0 0 1 7 0" />
        <LineGeometry StartPoint="12,20" EndPoint="12.01,20" />
    </GeometryGroup>

    <!-- list.svg：側邊導覽「連線管理」圖示 -->
    <PathGeometry x:Key="IconListGeometry"
                  Figures="M3 5h.01 M3 12h.01 M3 19h.01 M8 5h13 M8 12h13 M8 19h13" />

    <!-- check.svg：確認/新增/儲存等提交類動作 -->
    <PathGeometry x:Key="IconCheckGeometry" Figures="M20 6 9 17l-5-5" />

    <!-- clipboard-list.svg：批次貼上 -->
    <GeometryGroup x:Key="IconClipboardListGeometry">
        <RectangleGeometry Rect="8,2,8,4" RadiusX="1" RadiusY="1" />
        <PathGeometry Figures="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M12 11h4 M12 16h4 M8 11h.01 M8 16h.01" />
    </GeometryGroup>

    <!-- copy.svg：複製明細到剪貼簿 -->
    <GeometryGroup x:Key="IconCopyGeometry">
        <RectangleGeometry Rect="8,8,14,14" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </GeometryGroup>

    <!-- rotate-cw.svg：重試單台部署 -->
    <PathGeometry x:Key="IconRetryGeometry" Figures="M21 12a9 9 0 1 1-3-6.74L21 8 M21 3v5h-5" />

    <!-- eye.svg：RevealablePasswordBox 顯示已存密碼用 -->
    <GeometryGroup x:Key="IconEyeGeometry">
        <PathGeometry Figures="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3" />
    </GeometryGroup>

    <!-- 狀態圖示徽章：連線管理五態，形狀＋顏色雙重編碼，不單靠顏色分辨 -->
    <EllipseGeometry x:Key="IconStatusDotGeometry" Center="6,6" RadiusX="4" RadiusY="4" />

    <!-- key.svg：密碼錯誤 -->
    <PathGeometry x:Key="IconKeyGeometry"
                  Figures="M21 2 L19 4 M12.5 11.5 a5.5 5.5 0 1 0 -8 8 a5.5 5.5 0 0 0 8 -8 z M15 9 L21 3 M18 6 L21 9" />

    <!-- folder.svg：連線群組 -->
    <PathGeometry x:Key="IconGroupGeometry"
                  Figures="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />

    <!-- lock.svg：暫時被鎖定 -->
    <GeometryGroup x:Key="IconLockGeometry">
        <RectangleGeometry Rect="3,11,18,11" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M7 11V7a5 5 0 0 1 10 0v4" />
    </GeometryGroup>

    <!-- upload.svg：部署已選 -->
    <GeometryGroup x:Key="IconDeployGeometry">
        <PathGeometry Figures="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12" />
    </GeometryGroup>

    <!-- file-text.svg：事件日誌 -->
    <GeometryGroup x:Key="IconEventLogGeometry">
        <PathGeometry Figures="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" />
    </GeometryGroup>

</ResourceDictionary>
