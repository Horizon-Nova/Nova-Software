<UserControl x:Class="Vaeron.VNCSCP.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Vaeron.VNCSCP.Internal.Wpf.Components;assembly=Vaeron.VNCSCP.Internal.Wpf"
             xmlns:local="clr-namespace:Vaeron.VNCSCP.Dashboard"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <components:GroupAllSelectedConverter x:Key="GroupAllSelectedConverter" />
        <local:ConnectionStatusGeometryConverter x:Key="ConnectionStatusGeometryConverter" />

        <!-- 不套色塊背景，維持既有線條配色語言 -->
        <Style x:Key="DeployStateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeployStateText}" Value="成功">
                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeployStateText}" Value="失敗">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EventLevelInlineTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 連線狀態文字色（ConnectionStatus 五態） -->
        <Style x:Key="ConnectionStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Reachable">
                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WrongPassword">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Locked">
                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreachable">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            連線狀態圖示：形狀＋顏色雙重編碼，不單靠顏色分辨（色盲友善）。
            畫法比照既有操作鈕圖示（測試／展開／刪除）：無底色線條，只換 Stroke 顏色，不套色底容器。
        -->
        <Style x:Key="ConnectionStatusIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource TextTertiary}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Reachable">
                    <Setter Property="Stroke" Value="{StaticResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WrongPassword">
                    <Setter Property="Stroke" Value="{StaticResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Locked">
                    <Setter Property="Stroke" Value="{StaticResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreachable">
                    <Setter Property="Stroke" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 沿用 ComboBox 下拉選單同一套邊框＋陰影樣式，不另立一套浮層視覺語言 -->
        <Style x:Key="FlyoutPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="10" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- 行內表單改用 Popup，避免內容量把表格擠壓變形 -->
    <Grid Margin="20" Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Connections.Count, StringFormat='連線清單（{0} 筆）'}"
                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentLabel}"
                   Margin="0,0,0,12" VerticalAlignment="Center" />

        <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding HasLoadError, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="10,0" Height="{StaticResource ControlHeightMd}">
                <DockPanel LastChildFill="True">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconSearchGeometry}" Stroke="{StaticResource TextTertiary}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" Margin="8,0,0,0" Padding="0"
                             VerticalContentAlignment="Center" Tag="搜尋名稱或 IP" ToolTip="搜尋名稱或 IP" />
                </DockPanel>
            </Border>

            <!-- 就地篩選，不重新查詢資料庫 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <RadioButton Style="{StaticResource StatusFilterToggleStyle}" GroupName="ConnectionStatusFilter"
                             Content="全部" ToolTip="顯示全部連線"
                             IsChecked="{Binding ShowOnlyAbnormal, Converter={StaticResource InverseBoolConverter}}" />
                <RadioButton Style="{StaticResource StatusFilterToggleStyle}" GroupName="ConnectionStatusFilter"
                             Content="異常" ToolTip="只顯示密碼錯誤／被鎖定／無法連線的連線"
                             IsChecked="{Binding ShowOnlyAbnormal}" />
            </StackPanel>

            <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="測試全部連線"
                    Command="{Binding ApplyTestAllCommand}">
                <Path Data="{StaticResource IconTestGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Grid.Column="4" ToolTip="測試已勾選的連線"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding ApplyTestSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconTestGeometry}" Stroke="{StaticResource Ink}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat='測試已選（{0}）'}" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="5" x:Name="DeployPanelButton" ToolTip="部署到已勾選的連線"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding ApplyToggleDeployPanelCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDeployGeometry}" Stroke="{StaticResource Ink}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat='部署已選（{0}）'}" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="6" ToolTip="刪除已勾選的連線"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding ApplyDeleteSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDeleteGeometry}" Stroke="{StaticResource Danger}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat='刪除已選（{0}）'}" Foreground="{StaticResource Danger}" />
                </StackPanel>
            </Button>
            <!-- 完整查詢/匯出密度跟逐列近期 5 筆不同，開獨立次視窗 -->
            <Button Grid.Column="7" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="開啟事件日誌"
                    Command="{Binding ApplyOpenEventLogCommand}">
                <Path Data="{StaticResource IconEventLogGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Grid.Column="8" x:Name="GroupPanelButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="管理群組"
                    Command="{Binding ApplyToggleGroupPanelCommand}">
                <Path Data="{StaticResource IconGroupGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Grid.Column="9" x:Name="AddConnectionButton" Style="{StaticResource PrimaryToolbarIconButtonStyle}" ToolTip="新增連線"
                    Command="{Binding ApplyToggleAddRowCommand}">
                <Path Data="{StaticResource IconPlusGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="15" Height="15" Stretch="Uniform" />
            </Button>
        </Grid>

        <Popup PlacementTarget="{Binding ElementName=AddConnectionButton}" Placement="Bottom"
               IsOpen="{Binding IsAddRowExpanded}" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutPanelBorderStyle}" Width="620">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名稱" Style="{StaticResource FieldLabelLeftStyle}" />
                        <TextBox Grid.Column="1" Margin="0,0,14,0" Tag="名稱"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Grid.Column="2" Text="IP" Style="{StaticResource FieldLabelLeftStyle}" />
                        <TextBox Grid.Column="3" Margin="0,0,14,0" FontFamily="{StaticResource MonoFontFamily}" Tag="192.168.0.22"
                                 Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Grid.Column="4" Text="Port" Style="{StaticResource FieldLabelLeftStyle}" />
                        <TextBox Grid.Column="5" Width="64" Margin="0,0,14,0" FontFamily="{StaticResource MonoFontFamily}" Tag="5900" ToolTip="預設 5900"
                                 Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Grid.Column="6" Text="VNC 密碼" Style="{StaticResource FieldLabelLeftStyle}" />
                        <PasswordBox Grid.Column="7" x:Name="AddPasswordBox" Tag="密碼" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="群組" Style="{StaticResource FieldLabelLeftStyle}" />
                        <ComboBox Grid.Column="1" Width="130" IsEditable="True" ItemsSource="{Binding Groups}"
                                  Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空即為未分組，可輸入新群組名稱" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="確認新增" Click="OnAddConnectionClick">
                                <Path Data="{StaticResource IconCheckGeometry}" Stroke="{StaticResource Accent}"
                                      StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="取消" Command="{Binding ApplyToggleAddRowCommand}">
                                <Path Data="{StaticResource IconCloseGeometry}" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Popup PlacementTarget="{Binding ElementName=GroupPanelButton}" Placement="Bottom"
               IsOpen="{Binding IsGroupPanelExpanded}" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutPanelBorderStyle}" Width="320">
                <StackPanel>
                    <!-- 群組不是獨立實體，沒有「新增空群組」動作；輸入新連線的群組欄位打上新名稱即成立。 -->
                    <!-- 群組數量無上限，MaxHeight 避免面板無限拉長 -->
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GroupManagementRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBox Grid.Column="0" Margin="0,0,10,0"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="重新命名"
                                                    Command="{Binding DataContext.ApplyStartGroupRenameCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconEditGeometry}" Stroke="{StaticResource TextSecondary}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonWarningHoverStyle}" ToolTip="取消群組"
                                                    Command="{Binding DataContext.ApplyUngroupCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconDeleteGeometry}" Stroke="{StaticResource TextSecondary}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="確認重新命名"
                                                    Command="{Binding DataContext.ApplySaveGroupRenameCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconCheckGeometry}" Stroke="{StaticResource Accent}"
                                                      StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                            <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="取消"
                                                    Command="{Binding DataContext.ApplyCancelGroupRenameCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconCloseGeometry}" Stroke="{StaticResource TextSecondary}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 目標＝目前已勾選的連線，不需要另一個目標多選 UI -->
        <Popup PlacementTarget="{Binding ElementName=DeployPanelButton}" Placement="Bottom"
               IsOpen="{Binding IsDeployPanelExpanded}" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutPanelBorderStyle}" Width="480">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCount, StringFormat='部署到已勾選的 {0} 台'}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="本地來源" Style="{StaticResource FieldLabelLeftStyle}" />
                        <TextBox Grid.Column="1" Margin="0,0,8,0" Tag="要部署的本地檔案或資料夾路徑"
                                 Text="{Binding DeployLocalSourcePath, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="檔案" Click="OnBrowseDeployFileClick" />
                            <Button Content="資料夾" Click="OnBrowseDeployFolderClick" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="遠端路徑" Style="{StaticResource FieldLabelLeftStyle}" />
                        <TextBox Grid.Column="1" Tag="各機台共用的遠端絕對路徑，例如 C:\deploy"
                                 Text="{Binding DeployRemoteTargetPath, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <RadioButton Content="立即" GroupName="DeployTiming" Margin="0,0,14,0" VerticalAlignment="Center"
                                         IsChecked="{Binding IsDeployScheduled, Converter={StaticResource InverseBoolConverter}}" />
                            <RadioButton Content="排程" GroupName="DeployTiming" Margin="0,0,10,0" VerticalAlignment="Center"
                                         IsChecked="{Binding IsDeployScheduled}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="150" HorizontalAlignment="Left" Tag="yyyy-MM-dd HH:mm"
                                 Text="{Binding DeployScheduledAtText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsDeployScheduled, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="提交部署任務" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ApplySubmitDeploySelectedCommand}" />
                            <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="取消" Margin="6,0,0,0"
                                    Command="{Binding ApplyToggleDeployPanelCommand}">
                                <Path Data="{StaticResource IconCloseGeometry}" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 載入失敗：不得與「無資料」共用同一畫面 -->
        <Grid Grid.Row="2" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding LoadErrorMessage}" Foreground="{StaticResource Danger}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <Button Content="重新整理" Command="{Binding ApplyReloadCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding HasLoadError, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="名稱／狀態" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="3" Text="IP:Port" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="4" Text="上次測試" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="5" Text="操作" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding ConnectionsView}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,14,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      IsChecked="{Binding Converter={StaticResource GroupAllSelectedConverter}, Mode=OneWay}"
                                                      Command="{Binding DataContext.ApplyToggleGroupSelectionCommand,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsSelected}" />

                                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{Binding Status, Converter={StaticResource ConnectionStatusGeometryConverter}}"
                                              Style="{StaticResource ConnectionStatusIconStyle}" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding StatusDisplayText}" Style="{StaticResource ConnectionStatusTextStyle}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondary}">
                                            <Run Text="{Binding Ip, Mode=OneWay}" />
                                            <Run Text=":" />
                                            <Run Text="{Binding Port, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Grid.Column="4" Text="{Binding LastTestedDisplay}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                                   Foreground="{StaticResource TextTertiary}" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ProgressBar Width="24" Height="3" IsIndeterminate="True"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{StaticResource Accent}"
                                                         Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="測試連線"
                                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding DataContext.ApplyTestConnectionCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconTestGeometry}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                            <Button Style="{StaticResource ExpandToggleButtonStyle}" ToolTip="展開／收合"
                                                    Command="{Binding DataContext.ApplyToggleExpandCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnToggleExpandClick">
                                                <Path Data="{StaticResource IconChevronDownGeometry}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonWarningHoverStyle}" ToolTip="刪除"
                                                    Command="{Binding DataContext.ApplyDeleteConnectionCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconDeleteGeometry}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 不做分頁切換，三塊資訊都常駐顯示 -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="56,0,14,14">
                                        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondary}">
                                                <Run Text="目前狀態：" />
                                                <Run Text="{Binding StatusDisplayText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondary}">
                                                <Run Text="上次測試：" />
                                                <Run Text="{Binding LastTestedDisplay, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" />
                                            </TextBlock>
                                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,10,0,0" />
                                        </StackPanel>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="名稱" Style="{StaticResource FieldLabelLeftStyle}" />
                                                <TextBox Grid.Column="1" Margin="0,0,14,0"
                                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                <TextBlock Grid.Column="2" Text="IP" Style="{StaticResource FieldLabelLeftStyle}" />
                                                <TextBox Grid.Column="3" Margin="0,0,14,0" FontFamily="{StaticResource MonoFontFamily}"
                                                         Text="{Binding EditIp, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                <TextBlock Grid.Column="4" Text="Port" Style="{StaticResource FieldLabelLeftStyle}" />
                                                <TextBox Grid.Column="5" Width="64" Margin="0,0,14,0" FontFamily="{StaticResource MonoFontFamily}"
                                                         Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                <TextBlock Grid.Column="6" Text="VNC 密碼" Style="{StaticResource FieldLabelLeftStyle}" />
                                                <components:RevealablePasswordBox Grid.Column="7" />
                                                <TextBlock Grid.Column="8" Text="群組" Style="{StaticResource FieldLabelLeftStyle}" Margin="14,0,8,0" />
                                                <ComboBox Grid.Column="9" Width="130" IsEditable="True" ItemsSource="{Binding DataContext.Groups,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          Text="{Binding EditGroupName, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空即為未分組，可輸入新群組名稱" />
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="儲存變更" Click="OnSaveEditClick">
                                                    <Path Data="{StaticResource IconCheckGeometry}" Stroke="{StaticResource Accent}"
                                                          StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="15" Height="15" Stretch="Uniform" />
                                                </Button>
                                                <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="還原成目前連線的值" Click="OnResetEditClick">
                                                    <Path Data="{StaticResource IconCloseGeometry}" Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,12,0,0">
                                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="部署狀態：" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                                    <TextBlock Text="{Binding DeployStateText, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold"
                                                               Style="{StaticResource DeployStateTextStyle}" Margin="4,0,0,0" />
                                                    <TextBlock Text="{Binding DeployMessage, Mode=OneWay}" FontSize="10.5"
                                                               Foreground="{StaticResource TextTertiary}" Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTip="重試這一台部署"
                                                        Visibility="{Binding CanRetryDeploy, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.ApplyRetryDeployItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconRetryGeometry}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0">
                                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />
                                            <TextBlock Text="近期事件" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding RecentEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Message}" FontSize="10.5"
                                                                       Style="{StaticResource EventLevelInlineTextStyle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding OccurredAt, StringFormat='yyyy-MM-dd HH:mm'}" FontSize="10"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       Foreground="{StaticResource TextTertiary}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="尚無連線，請先新增"
                               Foreground="{StaticResource TextTertiary}" FontSize="12.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                               Visibility="{Binding HasNoConnections, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding HasNoDeployTasks, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

            <Border Grid.Column="2" Margin="0,10,0,0"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0" Padding="14,0,0,0"
                    Visibility="{Binding HasNoDeployTasks, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="進行中任務" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DeployTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 提交時間讓人判斷任務是否卡住 -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Label, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" FontSize="9.5" Foreground="{StaticResource TextTertiary}"
                                                           FontFamily="{StaticResource MonoFontFamily}" Margin="6,0,0,0"
                                                           Text="{Binding SubmittedAtDisplay, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2,0,0" Text="{Binding SummaryText, Mode=OneWay}" />

                                            <ProgressBar Grid.Row="2" Height="3" Margin="0,6,0,0"
                                                         Minimum="0" Maximum="{Binding Total}" Value="{Binding DoneCount, Mode=OneWay}"
                                                         Background="{StaticResource BorderSubtle}" BorderThickness="0"
                                                         Foreground="{StaticResource Accent}" />

                                            <!-- 永久顯示，不用 ToolTip：審查時要直接看到，不必 hover -->
                                            <TextBlock Grid.Row="3" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,6,0,0" TextWrapping="Wrap">
                                                <Run Text="目標：" />
                                                <Run Text="{Binding AllTargetNamesText, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="4" FontSize="10" Foreground="{StaticResource TextTertiary}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Text="{Binding PathDisplay, Mode=OneWay}" />

                                            <TextBlock Grid.Row="5" FontSize="10" Foreground="{StaticResource Danger}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasFailedItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Run Text="失敗：" />
                                                <Run Text="{Binding FailedConnectionNamesText, Mode=OneWay}" />
                                            </TextBlock>

                                            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="重試全部失敗" FontSize="10" Foreground="{StaticResource Danger}"
                                                        Visibility="{Binding HasFailedItems, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.ApplyRetryAllDeployFailedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButtonStyle}" ToolTip="取消任務" Margin="4,0,0,0"
                                                        Visibility="{Binding IsCancelable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.ApplyCancelDeployTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconCloseGeometry}" Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="11" Height="11" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
