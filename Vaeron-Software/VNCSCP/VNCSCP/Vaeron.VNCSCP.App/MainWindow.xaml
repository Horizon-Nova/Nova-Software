<Window x:Class="Vaeron.VNCSCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VNCSCP"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="440"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackground}">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                             ResizeBorderThickness="5"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 頂列 -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="VNCSCP" Foreground="{StaticResource Ink}"
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="12.5" FontWeight="Bold"
                           Margin="14,0,0,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClick" ToolTip="最小化">
                        <Path Data="{StaticResource IconMinimizeGeometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeRestoreClick" ToolTip="最大化">
                        <Grid>
                            <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximizeGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform" />
                            <Path x:Name="RestoreIcon" Data="{StaticResource IconRestoreGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick" ToolTip="關閉" Margin="0,0,4,0">
                        <Path Data="{StaticResource IconCloseGeometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主體：單一內容承載區，固定顯示 Dashboard（單頁工具不再需要側邊導覽切換） -->
        <Grid Grid.Row="1" Background="{StaticResource PageBackground}">
            <ContentControl x:Name="ContentHost" />
        </Grid>

        <!-- 底部狀態列 -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="就緒" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource AppFontFamily}"
                       Margin="14,0" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
