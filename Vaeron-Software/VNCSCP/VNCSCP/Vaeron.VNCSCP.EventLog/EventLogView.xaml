<UserControl x:Class="Vaeron.VNCSCP.EventLog.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <!-- 過濾膠囊按鈕（時間／等級） -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentTint}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 等級色標籤外框：底色依 Level -->
        <Style x:Key="EventLevelBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource AccentTint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource DangerBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 等級色標籤文字：字色依 Level -->
        <Style x:Key="EventLevelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="事件日誌"
                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentLabel}"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Button Content="匯出 JSON" Click="OnExportClick"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4"
                    ToolTip="依當前過濾條件匯出為 JSON（UTF-8）" />
        </Grid>

        <!-- 工具列：搜尋 ＋ 時間過濾 ＋ 等級過濾 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="10,0" Height="{StaticResource ControlHeightMd}">
                <DockPanel LastChildFill="True">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconSearchGeometry}" Stroke="{StaticResource TextTertiary}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" Margin="8,0,0,0" Padding="0"
                             VerticalContentAlignment="Center" Tag="搜尋工具名稱或訊息" ToolTip="搜尋工具名稱或訊息" />
                </DockPanel>
            </Border>

            <!-- 時間過濾 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <RadioButton GroupName="TimeRange" Content="全部時間" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedTimeRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=All}" />
                <RadioButton GroupName="TimeRange" Content="今天" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedTimeRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Today}" />
                <RadioButton GroupName="TimeRange" Content="最近 7 天" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedTimeRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Last7}" />
                <RadioButton GroupName="TimeRange" Content="最近 30 天" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedTimeRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Last30}" />
            </StackPanel>

            <!-- 等級過濾 -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton GroupName="Level" Content="全部" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsConverter}, ConverterParameter=All}" />
                <RadioButton GroupName="Level" Content="一般" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Info}" />
                <RadioButton GroupName="Level" Content="警告" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Warning}" />
                <RadioButton GroupName="Level" Content="錯誤" Style="{StaticResource FilterPillStyle}"
                             IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Error}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="僅顯示套用中過濾條件的事件，最新在前，上限 500 筆"
                   FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="2,0,0,10"
                   Visibility="{Binding HasLoadError, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <!-- 載入失敗：不得與「無資料」共用同一畫面 -->
        <Grid Grid.Row="3" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding LoadErrorMessage}" Foreground="{StaticResource Danger}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <Button Content="重新整理" Command="{Binding ApplyReloadCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding HasLoadError, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 表頭 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="等級" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="工具" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Grid.Column="2" Text="訊息" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Grid.Column="3" Text="時間" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                </Grid>
            </Border>

            <!-- 事件清單 -->
            <Grid Grid.Row="1">
                <ListBox BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Events}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource EventLevelBadgeStyle}">
                                        <TextBlock Text="{Binding LevelText}" Style="{StaticResource EventLevelTextStyle}" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="2" Text="{Binding Message}" VerticalAlignment="Center"
                                               FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="3" Text="{Binding OccurredDisplay}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" />

                                    <Button Grid.Column="4" Style="{StaticResource ExpandToggleButtonStyle}" ToolTip="展開明細"
                                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ApplyToggleExpandCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconChevronDownGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                </Grid>

                                <!-- 展開明細：終端機風格的深色區塊，右上角複製鈕 -->
                                <Border Margin="72,0,6,12" CornerRadius="4" Padding="14,12"
                                        Background="{StaticResource Ink}"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 明細內容區 -->
                                        <ScrollViewer Grid.Column="0" MaxHeight="220" Margin="0,0,10,0"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                                       Foreground="{StaticResource PageBackground}" />
                                        </ScrollViewer>
                                        <Button Grid.Column="1" Style="{StaticResource EventCopyButtonStyle}"
                                                ToolTip="複製明細" VerticalAlignment="Top" Click="OnCopyDetailClick">
                                            <Grid>
                                                <!-- 一般狀態：複製圖示 -->
                                                <Path Data="{StaticResource IconCopyGeometry}"
                                                      Stroke="{StaticResource PageBackground}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      Visibility="{Binding IsJustCopied, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <!-- 剛複製：綠色打勾 -->
                                                <Path Data="{StaticResource IconCheckGeometry}"
                                                      Stroke="{StaticResource Success}"
                                                      StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      Visibility="{Binding IsJustCopied, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="尚無事件記錄"
                           Foreground="{StaticResource TextTertiary}" FontSize="12.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                           Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
