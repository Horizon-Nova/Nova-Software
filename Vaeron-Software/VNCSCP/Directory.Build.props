<Project>
  <!--
    預設值層。csproj 可覆寫本檔設定。
    不可被覆寫的強制值置於 Directory.Build.targets(於 csproj 之後載入)。
  -->

  <Import Project="$(MSBuildThisFileDirectory)Workspace.props" />

  <!-- 骨架自我驗證產生的暫存專案。由路徑判定,專案無法自稱。 -->
  <PropertyGroup>
    <ProbeFolderName>_Probe</ProbeFolderName>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Company>$(WorkspacePrefix)</Company>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <_WsRoot>$(MSBuildThisFileDirectory)</_WsRoot>
  </PropertyGroup>

  <!--
    位置判定(靜態階段用)。
    以 Static 前綴命名,標明這份不是權威值——可被 csproj 覆寫,只供還原前的
    TFM 判定與分析器掛載使用。S 規則的檢查使用 Structure.targets 的 Target 內
    以路徑重新計算的那一份(_Check* 前綴),兩者刻意分離。
  -->
  <PropertyGroup>
    <_RelPath>$(MSBuildProjectDirectory.Substring($(_WsRoot.Length)))</_RelPath>
    <_TopFolder>$(_RelPath.Replace('\','/').Split('/')[0])</_TopFolder>

    <StaticIsBuildProject Condition="'$(_TopFolder)'=='$(BuildFolderName)'">true</StaticIsBuildProject>
    <StaticIsBuildProject Condition="'$(StaticIsBuildProject)'==''">false</StaticIsBuildProject>

    <StaticIsTemplateProject Condition="'$(_TopFolder)'=='$(TemplateFolderName)'">true</StaticIsTemplateProject>
    <StaticIsTemplateProject Condition="'$(StaticIsTemplateProject)'==''">false</StaticIsTemplateProject>

    <StaticIsSharedProject Condition="'$(_TopFolder)'=='$(SharedFolderName)'">true</StaticIsSharedProject>
    <StaticIsSharedProject Condition="'$(StaticIsSharedProject)'==''">false</StaticIsSharedProject>

    <StaticIsAppProject Condition="'$(StaticIsBuildProject)'=='false' AND '$(StaticIsTemplateProject)'=='false' AND '$(StaticIsSharedProject)'=='false'">true</StaticIsAppProject>
    <StaticIsAppProject Condition="'$(StaticIsAppProject)'==''">false</StaticIsAppProject>

    <StaticOwningApp Condition="'$(StaticIsAppProject)'=='true'">$(_TopFolder)</StaticOwningApp>

    <StaticIsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</StaticIsTestProject>
    <StaticIsTestProject Condition="'$(StaticIsTestProject)'==''">false</StaticIsTestProject>

    <StaticIsKernelProject Condition="$(MSBuildProjectName.Contains('.Kernel'))">true</StaticIsKernelProject>
    <StaticIsKernelProject Condition="'$(StaticIsKernelProject)'==''">false</StaticIsKernelProject>

    <StaticIsRootProject Condition="$(MSBuildProjectName.EndsWith('.App'))">true</StaticIsRootProject>
    <StaticIsRootProject Condition="'$(StaticIsRootProject)'==''">false</StaticIsRootProject>
  </PropertyGroup>

  <!-- TFM 預設：專案可覆寫(例如上層需 WPF) -->
  <PropertyGroup Condition="'$(TargetFramework)'=='' AND '$(TargetFrameworks)'==''">
    <TargetFramework Condition="$(MSBuildProjectName.EndsWith('.Windows'))">$(WindowsTfm)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)'==''">$(BaseTfm)</TargetFramework>
  </PropertyGroup>
</Project>
