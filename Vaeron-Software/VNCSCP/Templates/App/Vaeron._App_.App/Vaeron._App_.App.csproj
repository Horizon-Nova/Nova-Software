<Project Sdk="Microsoft.NET.Sdk">
  <!-- 根：不被任何組件引用,產出可執行檔。只做組裝,不含業務判斷。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 有畫面時：OutputType=WinExe, TargetFramework=net10.0-windows, UseWPF=true -->
    <!--
      預設就是 Self-contained：dotnet publish 不加任何參數,產出的執行檔就是
      自帶執行環境、單一檔案——不用記得加 -p:PublishProfile=xxx,不用每次口頭
      交代。代價是 dotnet build/restore 也會連帶處理 win-x64 執行環境套件,
      比純 framework-dependent 稍微重一點,拿這個換「不會忘記講」。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Vaeron.Kernel\Vaeron.Kernel.csproj" />
    <ProjectReference Include="..\Vaeron._App_.Feature\Vaeron._App_.Feature.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
