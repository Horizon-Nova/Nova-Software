<UserControl x:Class="HelixStudio.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Body}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <!-- 遮罩：點旁邊就關掉 -->
    <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="Dismiss">
        <Grid MaxWidth="920" MaxHeight="660" Margin="20">

            <!-- 陰影畫在內容底下的另一層；掛在內容上會讓整個對話框的文字失去 ClearType -->
            <Border CornerRadius="16" Background="{DynamicResource Surface}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="64" ShadowDepth="16" Direction="270" Opacity="0.26" />
                </Border.Effect>
            </Border>

        <Border CornerRadius="16"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="1" ClipToBounds="True"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 標頭：標題、搜尋、符合幾項、關閉 -->
                <Border Grid.Row="0" Padding="20,12,16,12"
                        BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource Body}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Width="420" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="0" Content="{Binding SearchPaths}"
                                                Foreground="{DynamicResource TextFaint}"
                                                ContentTemplate="{StaticResource LucideIcon12}"
                                                VerticalAlignment="Center" IsHitTestVisible="False" />

                                <Grid Grid.Column="1" Margin="8,0">
                                    <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Find" />
                                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextFaint}"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Clears}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource WindowButton}" Width="28" Height="28"
                                                    ToolTip="清除搜尋" Click="Clear"
                                                    ContentTemplate="{StaticResource LucideIcon12}"
                                                    Content="{Binding DataContext.ClosePaths, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="{DynamicResource Caption}"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />

                        <Button Grid.Column="4" Style="{StaticResource WindowButton}" Width="32" Height="32"
                                ToolTip="關閉設定（Esc）" Click="Close"
                                ContentTemplate="{StaticResource LucideIcon12}" Content="{Binding ClosePaths}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="192" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左邊：分類與節 -->
                    <Border Grid.Column="0" Background="{DynamicResource ContentBack}"
                            BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12">
                            <ItemsControl ItemsSource="{Binding Nav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- 分類：一顆展開收起的按鈕 -->
                                            <Button Click="Twist">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Height" Value="28" />
                                                        <Setter Property="Padding" Value="4,0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="FontSize" Value="{DynamicResource Caption}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{Binding Paths}"
                                                                    Foreground="{DynamicResource TextFaint}"
                                                                    ContentTemplate="{StaticResource LucideIcon14}"
                                                                    VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" Margin="4,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- 節：選中的有底色與左邊那一條 -->
                                            <Button Click="PickSection" Padding="24,0,8,0" MinHeight="32">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FillButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="Margin" Value="0,0,0,2" />
                                                        <Setter Property="Height" Value="32" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parent}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Chosen}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Background><Binding Path="Back" /></Button.Background>
                                                <Button.Foreground><Binding Path="Ink" /></Button.Foreground>
                                                <Grid>
                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <Border Width="2" Height="16" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" Background="{Binding Bar}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 右邊：這一節的每一群 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,32">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="{DynamicResource Caption}"
                                                   LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap"
                                                   Margin="0,0,0,16" Foreground="{DynamicResource TextMuted}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- 群組標題：下方一條細線 -->
                                            <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1"
                                                    Padding="0,20,0,4" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Body}"
                                                           FontWeight="SemiBold" />
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- 改過的那一列左邊會有一條主色直條 -->
                                                        <Border BorderThickness="2,0,0,0" BorderBrush="{Binding Bar}"
                                                                Padding="16,12,0,12">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               FontSize="{DynamicResource Body}"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Bottom" />
                                                                    <ItemsControl ItemsSource="{Binding Ids}"
                                                                                  VerticalAlignment="Bottom">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding}" Margin="8,0,0,0"
                                                                                           Style="{StaticResource MonoText}"
                                                                                           Foreground="{DynamicResource TextGhost}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ItemsControl ItemsSource="{Binding Moveds}"
                                                                                  VerticalAlignment="Bottom">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button Style="{StaticResource LinkButton}"
                                                                                        Height="20" Padding="4,0" Margin="8,0,0,0"
                                                                                        FontSize="{DynamicResource Caption}"
                                                                                        Click="Reset">
                                                                                    <TextBlock Text="{Binding Label}"
                                                                                               TextDecorations="Underline" />
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <ItemsControl ItemsSource="{Binding Notes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" Margin="0,4,0,0"
                                                                                       MaxWidth="620" HorizontalAlignment="Left"
                                                                                       FontSize="{DynamicResource Caption}"
                                                                                       LineHeight="{DynamicResource CaptionLine}"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="{DynamicResource TextMuted}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 開關 -->
                                                                <ItemsControl ItemsSource="{Binding Toggles}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Style="{StaticResource SettingCheck}"
                                                                                      Margin="0,4,0,0"
                                                                                      IsChecked="{Binding On, Mode=OneWay}"
                                                                                      Checked="Flip" Unchecked="Flip">
                                                                                <TextBlock Text="{Binding Inline}"
                                                                                           FontSize="{DynamicResource Body}"
                                                                                           TextWrapping="Wrap" />
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 選單 -->
                                                                <ItemsControl ItemsSource="{Binding Choices}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ComboBox Style="{StaticResource SettingChoice}"
                                                                                      Margin="0,4,0,0" Width="360"
                                                                                      HorizontalAlignment="Left"
                                                                                      ItemsSource="{Binding Options}"
                                                                                      SelectedItem="{Binding Value, Mode=OneWay}"
                                                                                      SelectionChanged="Choose" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 只是說明 -->
                                                                <ItemsControl ItemsSource="{Binding Infos}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" Margin="0,2,0,0"
                                                                                       Style="{StaticResource MonoText}"
                                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                                       TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 按鈕 -->
                                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource FillButton}"
                                                                                    Margin="0,4,0,0"
                                                                                    HorizontalAlignment="Left"
                                                                                    FontWeight="Normal"
                                                                                    Content="{Binding Label}"
                                                                                    Foreground="{Binding Ink}"
                                                                                    BorderBrush="{Binding Line}"
                                                                                    Click="Act" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Border>
</UserControl>
