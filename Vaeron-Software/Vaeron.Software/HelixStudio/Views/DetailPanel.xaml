<UserControl x:Class="HelixStudio.Views.DetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Body}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <UserControl.Resources>

        <!-- 一塊白底的區塊 -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PanelHead" TargetType="Border">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <!-- 步驟截圖與示範影片的斜線底紋 -->
        <DrawingBrush x:Key="Hatch" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.RelativeTransform>
                <RotateTransform Angle="45" CenterX="0.5" CenterY="0.5" />
            </DrawingBrush.RelativeTransform>
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#f3f3f3">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#ededed">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 麵包屑列 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" Padding="12,0"
                BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FillButton}" Background="Transparent" BorderBrush="Transparent"
                        FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" Click="Back">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{Binding BackPaths}" ContentTemplate="{StaticResource LucideIcon16}"
                                        Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="工具目錄" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="/" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextFaint}" Margin="8,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 標頭：工具是什麼，還有安裝、更新、移除 -->
                <Border Background="{DynamicResource Surface}" Padding="20"
                        BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" VerticalAlignment="Top"
                                    Background="{DynamicResource WindowBack}" Margin="0,0,16,0">
                                <ContentControl Content="{Binding Paths}" Foreground="{DynamicResource TextSecondary}"
                                                ContentTemplate="{StaticResource LucideIcon24}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Heading}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Requireds}" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border MinHeight="20" Padding="8,0" CornerRadius="4" Margin="12,0,0,0"
                                                        BorderBrush="{DynamicResource HairLine}" BorderThickness="1">
                                                    <TextBlock Text="IT 必裝" FontSize="{DynamicResource Caption}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ContentControl Content="{Binding StatePaths}" Foreground="{Binding StateInk}"
                                                    ContentTemplate="{StaticResource LucideIcon14}"
                                                    Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource Caption}" Margin="4,0,0,0"
                                               Foreground="{Binding StateInk}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Caption}" Margin="0,4,0,12"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Body}" LineHeight="{DynamicResource BodyLine}" MaxWidth="640"
                                           HorizontalAlignment="Left" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" MinWidth="176">
                            <Button Style="{StaticResource PageButton}" Content="{Binding PrimaryLabel}"
                                    Background="{Binding PrimaryBack}" Foreground="{Binding PrimaryInk}"
                                    BorderBrush="Transparent" FontWeight="SemiBold"
                                    IsEnabled="{Binding PrimaryEnabled}" Click="Primary" />
                            <Button Style="{StaticResource PageButton}" Margin="0,8,0,0"
                                    Content="{Binding SecondaryLabel}" Foreground="{Binding SecondaryInk}"
                                    BorderBrush="{Binding SecondaryLine}" Click="Secondary" />

                            <ItemsControl ItemsSource="{Binding Runnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="4" Minimum="0" Maximum="100"
                                                         Value="{Binding Pct}" BorderThickness="0"
                                                         Background="{DynamicResource Track}"
                                                         Foreground="{DynamicResource Accent}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                       Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Pct}" /><Run Text="%" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 五個分頁 -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource HairLine}"
                        BorderThickness="0,0,0,1">
                    <ListBox Style="{StaticResource TabList}" ItemContainerStyle="{StaticResource TabItem}"
                             ItemsSource="{Binding Tabs}" SelectedIndex="{Binding Selected, Mode=OneWay}"
                             SelectionChanged="PickTab" DisplayMemberPath="Text" />
                </Border>

                <Grid x:Name="TabBody" Margin="20,16,20,24" Style="{StaticResource Enter}">

                    <!-- 總覽 -->
                    <ItemsControl ItemsSource="{Binding Overviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="功能" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Capabilities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                BorderBrush="{DynamicResource HairLine}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="16" Height="16"
                                                                        CornerRadius="16" Margin="0,4,12,0"
                                                                        VerticalAlignment="Top"
                                                                        Background="{DynamicResource WindowBack}">
                                                                    <ContentControl Content="{Binding DataContext.Overviews[0].CheckPaths, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    ContentTemplate="{StaticResource LucideIcon10}"
                                                                                    Foreground="{DynamicResource TextSecondary}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                                           FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="基本資料" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Facts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                BorderBrush="{DynamicResource HairLine}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="96" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                           FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextMuted}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                           FontFamily="{Binding Mono}" FontSize="{DynamicResource Caption}"
                                                                           LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 怎麼用 -->
                    <ItemsControl ItemsSource="{Binding Guides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Panel}">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="操作前檢查清單" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Checklist}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                BorderBrush="{DynamicResource HairLine}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                                                        Margin="0,4,12,0" VerticalAlignment="Top"
                                                                        Background="{DynamicResource WindowBack}"
                                                                        BorderBrush="{DynamicResource HairLine}" BorderThickness="1">
                                                                    <ContentControl Content="{Binding DataContext.Guides[0].CheckPaths, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    ContentTemplate="{StaticResource LucideIcon10}"
                                                                                    Foreground="{DynamicResource TextSecondary}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{DynamicResource Caption}"
                                                                           LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="操作步驟" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16" BorderThickness="{Binding Line}"
                                                                BorderBrush="{DynamicResource HairLine}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="216" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                                                    <Border Width="20" Height="20" CornerRadius="16"
                                                                            Background="{DynamicResource Accent}" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding No}" Foreground="{DynamicResource OnAccent}"
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Caption}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Margin="12,0,0,0">
                                                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Body}" FontWeight="SemiBold"
                                                                                   Margin="0,0,0,4" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}"
                                                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Height="128" CornerRadius="4" Padding="8"
                                                                        Background="{StaticResource Hatch}"
                                                                        BorderBrush="{DynamicResource HairLine}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding Shot}" Style="{StaticResource MonoText}"
                                                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="示範影片" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <Border Margin="16" MinHeight="176" CornerRadius="4" Padding="16"
                                                    Background="{StaticResource Hatch}"
                                                    BorderBrush="{DynamicResource HairLine}" BorderThickness="1">
                                                <TextBlock Text="{Binding Video}" Style="{StaticResource MonoText}"
                                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Border Style="{StaticResource PanelHead}">
                                                    <TextBlock Text="這支工具做得到" Style="{StaticResource PanelTitle}" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Can}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                    BorderBrush="{DynamicResource HairLine}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="16"
                                                                            Margin="0,4,12,0" VerticalAlignment="Top"
                                                                            Background="{DynamicResource WindowBack}">
                                                                        <ContentControl Content="{Binding DataContext.Guides[0].CheckPaths, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        ContentTemplate="{StaticResource LucideIcon10}"
                                                                                        Foreground="{DynamicResource TextSecondary}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{DynamicResource Caption}"
                                                                               LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Border Style="{StaticResource PanelHead}">
                                                    <TextBlock Text="做不到（要走別的流程）" Style="{StaticResource PanelTitle}" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Cannot}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                    BorderBrush="{DynamicResource HairLine}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="16"
                                                                            Margin="0,4,12,0" VerticalAlignment="Top"
                                                                            Background="{DynamicResource DangerBack}"
                                                                            BorderBrush="{DynamicResource DangerLine}" BorderThickness="1">
                                                                        <ContentControl Content="{Binding DataContext.Guides[0].CrossPaths, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        ContentTemplate="{StaticResource LucideIcon10}"
                                                                                        Foreground="{DynamicResource Danger}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{DynamicResource Caption}"
                                                                               LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="出問題時怎麼辦" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Faq}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                BorderBrush="{DynamicResource HairLine}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Ask}" FontSize="{DynamicResource Body}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Answer}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}"
                                                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondary}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Padding="16,12" Background="{DynamicResource ContentBack}"
                                                    BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource FillButton}" Content="問 AI 助理"
                                                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                                                            BorderBrush="Transparent" Click="AskAi" />
                                                    <Button Style="{StaticResource FillButton}" Margin="8,0,0,0"
                                                            Content="回報給維護團隊" FontWeight="Normal" Click="Report" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="現場 SOP 與負責人" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <StackPanel Margin="16">
                                                <Button Style="{StaticResource FillButton}" Height="Auto" MinHeight="32"
                                                        Padding="12,8" HorizontalAlignment="Left" FontWeight="Normal"
                                                        HorizontalContentAlignment="Left" Click="OpenSop">
                                                    <TextBlock Text="{Binding Sop}" TextWrapping="Wrap" />
                                                </Button>
                                                <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="4"
                                                        Background="{DynamicResource WindowBack}">
                                                    <TextBlock Text="{Binding Owner}" Style="{StaticResource MonoText}"
                                                               Foreground="{DynamicResource TextMuted}" LineHeight="{DynamicResource CaptionLine}"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 還沒寫說明的工具 -->
                    <ItemsControl ItemsSource="{Binding Blanks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelHead}">
                                            <TextBlock Text="怎麼用" Style="{StaticResource PanelTitle}" />
                                        </Border>
                                        <StackPanel Margin="16">
                                            <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}" MaxWidth="560"
                                                       HorizontalAlignment="Left" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Style="{StaticResource FillButton}" Content="問 AI 助理"
                                                        Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                                                        BorderBrush="Transparent" Click="AskAi" />
                                                <Button Style="{StaticResource FillButton}" Margin="8,0,0,0"
                                                        Content="請維護團隊補上說明" FontWeight="Normal" Click="ReportBlank" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 權限與授權 -->
                    <ItemsControl ItemsSource="{Binding Perms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="這個工具會用到" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Permissions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                                BorderBrush="{DynamicResource HairLine}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                                                        Margin="0,4,12,0" VerticalAlignment="Top"
                                                                        Background="{DynamicResource WindowBack}">
                                                                    <ContentControl Content="{Binding DataContext.Perms[0].LockPaths, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    ContentTemplate="{StaticResource LucideIcon10}"
                                                                                    Foreground="{DynamicResource TextSecondary}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{DynamicResource Caption}"
                                                                           LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelHead}">
                                                <TextBlock Text="誰可以用" Style="{StaticResource PanelTitle}" />
                                            </Border>
                                            <StackPanel Margin="16">
                                                <TextBlock Text="{Binding Audience}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Border Width="16" Height="16" CornerRadius="16"
                                                            Background="{Binding EligibleBack}"
                                                            BorderBrush="{Binding EligibleLine}" BorderThickness="1">
                                                        <ContentControl Content="{Binding EligiblePaths}"
                                                                        ContentTemplate="{StaticResource LucideIcon10}"
                                                                        Foreground="{Binding EligibleInk}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding EligibleLabel}" FontSize="{DynamicResource Caption}" FontWeight="SemiBold"
                                                               Margin="8,0,0,0" Foreground="{Binding EligibleInk}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding EligibleNote}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}"
                                                           Margin="0,12,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 更新日誌 -->
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelHead}">
                                            <TextBlock Text="更新日誌" Style="{StaticResource PanelTitle}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="16,12" BorderThickness="{Binding Line}"
                                                            BorderBrush="{DynamicResource HairLine}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Ver}"
                                                                       FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Caption}"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Date}"
                                                                       Style="{StaticResource MonoText}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="{DynamicResource Caption}"
                                                                       LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Latests}"
                                                                          VerticalAlignment="Top">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Height="20" Padding="8,0" CornerRadius="4"
                                                                                BorderBrush="{DynamicResource HairLine}" BorderThickness="1">
                                                                            <TextBlock Text="最新" FontSize="{DynamicResource Caption}" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 席次 -->
                    <ItemsControl ItemsSource="{Binding Seats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" HorizontalAlignment="Left" MinWidth="360">
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelHead}">
                                            <TextBlock Text="授權席次" Style="{StaticResource PanelTitle}" />
                                        </Border>
                                        <StackPanel Margin="16">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Used}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{DynamicResource Display}" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding Total}" FontSize="{DynamicResource Caption}" Margin="8,0,0,4"
                                                               VerticalAlignment="Bottom"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PctText}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{DynamicResource Caption}" FontWeight="Medium" Foreground="{Binding PctInk}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                            </Grid>
                                            <ProgressBar Height="8" Minimum="0" Maximum="100" Margin="0,12,0,0"
                                                         Value="{Binding Pct, Mode=OneWay}" BorderThickness="0"
                                                         Background="{DynamicResource Track}" Foreground="{Binding FillInk}" />
                                            <TextBlock Text="{Binding Note}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}" Margin="0,12,0,0"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 移除必裝工具前先確認 -->
        <ItemsControl Grid.RowSpan="2" ItemsSource="{Binding Asking}">

            <!-- 只會有零筆或一筆；用 Grid 當版面，那一筆才會撐滿整頁，遮罩鋪得滿、對話框才置中 -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Scrim}">
                        <Grid MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- 陰影單獨一層，內容才留得住 ClearType -->
                            <Border CornerRadius="16" Background="{DynamicResource Surface}" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="64" ShadowDepth="16" Direction="270" Opacity="0.26" />
                                </Border.Effect>
                            </Border>

                        <Border Style="{StaticResource Panel}" CornerRadius="16"
                                KeyboardNavigation.TabNavigation="Cycle"
                                BorderBrush="{DynamicResource Divider}">
                            <StackPanel>
                                <StackPanel Margin="20,20,20,16">
                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Heading}" FontWeight="SemiBold"
                                               Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}" Margin="0,0,0,16"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource Caption}" Margin="0,0,0,8"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                                    <Border Style="{StaticResource SearchFrame}">
                                        <TextBox x:Name="ConfirmText" Style="{StaticResource SearchBox}"
                                                 TextChanged="TypeName" Loaded="TakeFocus" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
                                    <Button Style="{StaticResource FillButton}" Content="保留這支工具"
                                            FontWeight="Normal" Click="KeepTool" />
                                    <Button x:Name="ConfirmButton" Style="{StaticResource FillButton}" Margin="8,0,0,0"
                                            Content="{Binding OkLabel}" Background="{DynamicResource Danger}"
                                            Foreground="{DynamicResource OnAccent}" BorderBrush="Transparent" IsEnabled="False"
                                            Loaded="HoldConfirm" Click="RemoveTool" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
