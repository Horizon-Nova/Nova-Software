<UserControl x:Class="HelixStudio.Views.AssistPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Body}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource HairLine}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 標頭：助理是誰、跑在哪裡 -->
            <Border Grid.Row="0" MinHeight="48" Padding="12,8"
                    BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Margin="0,0,8,0"
                            Background="{DynamicResource WindowBack}">
                        <ContentControl Content="{Binding Paths}" Foreground="{DynamicResource Accent}"
                                        ContentTemplate="{StaticResource LucideIcon16}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Sub}" FontSize="{DynamicResource Caption}"
                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource WindowButton}" Width="32" Height="32"
                            ToolTip="收起面板（Ctrl J）" Click="Close"
                            ContentTemplate="{StaticResource LucideIcon12}" Content="{Binding ClosePaths}" />
                </Grid>
            </Border>

            <!-- 現在停在哪一個畫面 -->
            <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource ContentBack}"
                    BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Where}" FontSize="{DynamicResource Caption}"
                           LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}" />
            </Border>

            <!-- 問答：捲動區在上，快速提問固定在下緣 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" x:Name="Stream" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Intros}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Body}"
                                               FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Caption}"
                                               LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Said}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MaxWidth="300" Margin="0,0,0,12" Padding="12" CornerRadius="8"
                                        HorizontalAlignment="{Binding Side}" Background="{Binding Back}"
                                        Style="{StaticResource Enter}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Body}"
                                                   LineHeight="{DynamicResource BodyLine}" TextWrapping="Wrap"
                                                   Foreground="{Binding Ink}" />
                                        <ItemsControl ItemsSource="{Binding Cites}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Thinkings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,8,0"
                                            Background="{DynamicResource Shine}" />
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource Caption}"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

                <!-- 快速提問 -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Prompts}" Margin="12,12,12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PromptButton}" Margin="0,0,8,8" Click="Pick">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 問一句 -->
            <Border Grid.Row="3" Padding="12" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SearchFrame}" Height="44" Margin="0,0,8,0">
                        <Grid>
                        <TextBox x:Name="Draft" Style="{StaticResource SearchBox}"
                                 TextChanged="Type" KeyDown="Send" />
                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextFaint}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Draft}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource FillButton}" Height="44" MinWidth="64"
                            Content="{Binding SendLabel}" Background="{Binding SendBack}"
                            Foreground="{Binding SendInk}" BorderBrush="Transparent"
                            IsEnabled="{Binding SendEnabled}" Click="Ask" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Text="{Binding Note}" Style="{StaticResource MonoText}"
                       Margin="12,0,12,12" LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
