<UserControl x:Class="HelixStudio.Views.HostPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Body}"
             Foreground="{DynamicResource TextPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具列：這是哪一支工具，加上回工具資訊與重新載入 -->
        <Border Grid.Row="0" MinHeight="48" Padding="12,8" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Margin="0,0,12,0"
                        Background="{DynamicResource ContentBack}">
                    <ContentControl Content="{Binding Paths}" Foreground="{DynamicResource TextSecondary}"
                                    ContentTemplate="{StaticResource LucideIcon16}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Line}" FontSize="{DynamicResource Caption}"
                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FillButton}" Content="工具資訊" FontWeight="Normal" Click="Detail" />
                    <Button Style="{StaticResource FillButton}" Content="重新載入" FontWeight="Normal"
                            Margin="8,0,0,0" Click="Again" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具自己的畫面掛在這一區 -->
        <Grid Grid.Row="1" x:Name="Mount" />

        <!-- 載不起來時說原因 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Faults}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="這支工具載不起來" FontSize="{DynamicResource Heading}" FontWeight="SemiBold"
                                   Margin="0,0,0,8" TextAlignment="Center" />
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource Caption}"
                                   LineHeight="{DynamicResource CaptionLine}" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
