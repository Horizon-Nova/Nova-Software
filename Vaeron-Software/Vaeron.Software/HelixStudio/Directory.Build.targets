<Project>

  <!--
    EF、Npgsql 是對 .NET 8 編的，裡面引用 System.Runtime 8.0.0.0；混淆器解析型別要版本完全吻合，
    而它的搜尋路徑只從這個專案的參考清單自動產生。所以在混淆之前把 .NET 8 的參考組件放進清單。
    這時編譯已經結束，多放的這幾個不會影響編譯。
  -->
  <Target Name="AddNet8ReferencesForConfuser"
          BeforeTargets="CreateConfuserProject"
          Condition="'$(Obfuscate)' == 'true'">
    <ItemGroup>
      <ReferencePath Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\8.0.13\ref\net8.0\System.Runtime.dll" />
    </ItemGroup>
  </Target>

</Project>
