<UserControl x:Class="HelixStudio.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Text}"
             Foreground="{DynamicResource TextPrimary}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- 可點的欄名：只有字，滑鼠移上去字變深 -->
        <Style x:Key="HeadButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 頁首一列：標題與筆數、搜尋、符合幾筆 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" Padding="16,0"
                BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="日誌" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Counts}" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextMuted}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />

                <!-- 搜尋框；沒打字時蓋一層提示，有打字時右邊一顆清除 -->
                <Border Style="{StaticResource SearchFrame}" Width="300" Height="{DynamicResource ControlHeight}" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchText" Grid.Column="0" Style="{StaticResource SearchBox}" FontSize="{DynamicResource Text}"
                                 TextChanged="Search" PreviewKeyDown="SearchKey" />
                        <TextBlock Grid.Column="0" Text="以訊息、工具、方法或帳號搜尋" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextFaint}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Clears}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource WindowButton}" Width="20" Height="20"
                                            ToolTip="清除搜尋" Click="Clear"
                                            ContentTemplate="{StaticResource LucideIcon12}" Content="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Matcheds}" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="12,0,0,0" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextMuted}">
                                <Run Text="符合 " /><Run Text="{Binding Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" 筆" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 左邊清單、右邊選中那一件的明細，各自捲 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="618*" />
                <ColumnDefinition Width="382*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 欄名：點了照那一欄排，再點一次反過來；箭頭只在排序那一欄 -->
                    <Border Grid.Row="0" Height="32" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasRows, Converter={StaticResource Shown}}">
                        <Grid TextElement.FontSize="{DynamicResource Text}" TextElement.Foreground="{DynamicResource TextMuted}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="148" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource HeadButton}" Tag="{Binding HeadAt.Key}" Content="{Binding HeadAt.Text}"
                                    Foreground="{Binding HeadAt.Ink}" Click="Sort" />
                            <Button Grid.Column="1" Style="{StaticResource HeadButton}" Tag="{Binding HeadType.Key}" Content="{Binding HeadType.Text}"
                                    Foreground="{Binding HeadType.Ink}" Click="Sort" Margin="12,0,0,0" />
                            <Button Grid.Column="2" Style="{StaticResource HeadButton}" Tag="{Binding HeadTool.Key}" Content="{Binding HeadTool.Text}"
                                    Foreground="{Binding HeadTool.Ink}" Click="Sort" Margin="12,0,0,0" />
                            <Button Grid.Column="3" Style="{StaticResource HeadButton}" Tag="{Binding HeadWho.Key}" Content="{Binding HeadWho.Text}"
                                    Foreground="{Binding HeadWho.Ink}" Click="Sort" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="4" Text="訊息" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 每一件全部列出；只畫看得到的那幾列，捲到哪畫到哪 -->
                    <ListBox x:Name="EventList" Grid.Row="1" ItemContainerStyle="{StaticResource ListRow}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ItemsSource="{Binding Rows}" SelectedIndex="{Binding Chosen, Mode=OneWay}" SelectionChanged="PickRow">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid TextElement.FontSize="{DynamicResource Text}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding At}" ToolTip="{Binding Ago}" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" />
                                    <!-- 事件名：錯誤紅字；選中那一列跟著整列換成主色 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Event}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding EventInk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brand700}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Tool}" ToolTip="{Binding Tool}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Who}" ToolTip="{Binding Who}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Message}" ToolTip="{Binding Message}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 有紀錄但沒有一件符合搜尋字 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Misses}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="420" Margin="0,48" HorizontalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <Run Text="沒有符合「" /><Run Text="{Binding Mode=OneWay}" /><Run Text="」的紀錄" />
                                    </TextBlock>
                                    <TextBlock FontSize="{DynamicResource Text}" LineHeight="{DynamicResource TextLine}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,16" Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="搜尋比對訊息、工具、方法與帳號；換個字，或清除搜尋看全部 " /><Run Text="{Binding DataContext.Total, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" /><Run Text=" 筆。" />
                                    </TextBlock>
                                    <Button Style="{StaticResource FillButton}" Click="Clear"
                                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="Transparent"
                                            FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="看全部" /> <Run Text="{Binding DataContext.Total, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" /> <Run Text="筆" />
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 一件都還沒發生過 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Firsts}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="440" Margin="0,48" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource WindowBack}"
                                            HorizontalAlignment="Center">
                                        <ContentControl Content="{Binding}" Foreground="{DynamicResource TextMuted}"
                                                        ContentTemplate="{StaticResource LucideIcon24}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="還沒有發生過任何事" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center" />
                                    <TextBlock Text="啟用、開啟工具、解鎖工具設定，以及沒被接住的錯誤，發生時都會記在這裡，一件一列、全部留著。"
                                               FontSize="{DynamicResource Text}" LineHeight="{DynamicResource TextLine}" TextWrapping="Wrap"
                                               TextAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 右邊：選中那一件的明細；換選、複製、時間走的時候只重畫這一塊 -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}">
                <ItemsControl x:Name="Detail">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 事件名、時間、工具、帳號、方法；複製整筆 -->
                                <Border Grid.Row="0" Padding="16" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Event}" Foreground="{Binding EventInk}" FontWeight="SemiBold" />
                                            <Grid Margin="0,8,0,0" TextElement.FontSize="{DynamicResource Text}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20" />
                                                    <RowDefinition Height="20" />
                                                    <RowDefinition Height="20" />
                                                    <RowDefinition Height="20" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="時間" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding At}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="工具" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tool}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="帳號" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Who}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="3" Text="方法" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Function}" Style="{StaticResource Mono}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource FillButton}" FontWeight="Normal" VerticalAlignment="Top"
                                                FontSize="{DynamicResource Text}" Foreground="{Binding CopyInk}" Click="Copy"
                                                ToolTip="複製這一筆的時間、事件、工具、帳號、方法、訊息與呼叫堆疊">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Content="{Binding CopyPaths}" ContentTemplate="{StaticResource LucideIcon14}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CopyLabel}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 訊息與呼叫堆疊：長的時候這一塊自己捲 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
                                    <StackPanel TextElement.FontSize="{DynamicResource Text}">
                                        <TextBlock Text="訊息" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Message}" LineHeight="{DynamicResource TextLine}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Stacks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="呼叫堆疊" Foreground="{DynamicResource TextMuted}" Margin="0,16,0,4" />
                                                        <Border Padding="8" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource ContentBack}"
                                                                BorderBrush="{DynamicResource HairLine}" BorderThickness="1">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" LineHeight="{DynamicResource TextLine}"
                                                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
