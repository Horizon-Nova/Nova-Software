<UserControl x:Class="HelixStudio.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Text}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <!-- 遮罩：點旁邊就關掉 -->
    <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="Dismiss">
        <Grid MaxWidth="920" MaxHeight="660" Margin="16">

            <!-- 陰影畫在內容底下的另一層；掛在內容上會讓整個對話框的文字失去 ClearType -->
            <Border CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Surface}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="64" ShadowDepth="16" Direction="270" Opacity="0.26" />
                </Border.Effect>
            </Border>

        <Border CornerRadius="{StaticResource RadiusMd}"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="1" ClipToBounds="True"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 標頭：標題、搜尋、符合幾項、關閉 -->
                <Border Grid.Row="0" Padding="16,12,16,12"
                        BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource Text}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Width="320" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="0" Content="{Binding SearchPaths}"
                                                Foreground="{DynamicResource TextFaint}"
                                                ContentTemplate="{StaticResource LucideIcon12}"
                                                VerticalAlignment="Center" IsHitTestVisible="False" />

                                <Grid Grid.Column="1" Margin="8,0">
                                    <TextBox x:Name="Search" Style="{StaticResource SearchBox}" TextChanged="Find" />
                                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextFaint}"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Clears}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource WindowButton}" Width="24" Height="24"
                                                    ToolTip="清除搜尋" Click="Clear"
                                                    ContentTemplate="{StaticResource LucideIcon12}"
                                                    Content="{Binding DataContext.ClosePaths, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="{DynamicResource Text}"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />

                        <Button Grid.Column="4" Style="{StaticResource WindowButton}" Width="28" Height="28"
                                ToolTip="關閉設定（Esc）" Click="Close"
                                ContentTemplate="{StaticResource LucideIcon12}" Content="{Binding ClosePaths}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左邊：分類與節 -->
                    <Border Grid.Column="0" Background="{DynamicResource ContentBack}"
                            BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12">
                            <ItemsControl ItemsSource="{Binding Nav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- 分類：一顆展開收起的按鈕 -->
                                            <Button Click="Twist">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Height" Value="28" />
                                                        <Setter Property="Padding" Value="4,0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="FontSize" Value="{DynamicResource Text}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{Binding Paths}"
                                                                    Foreground="{DynamicResource TextFaint}"
                                                                    ContentTemplate="{StaticResource LucideIcon14}"
                                                                    VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" Margin="4,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- 節：選中的有底色與左邊那一條 -->
                                            <Button Click="PickSection" Padding="24,0,8,0" MinHeight="{DynamicResource ControlHeight}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FillButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="Margin" Value="0,0,0,2" />
                                                        <Setter Property="Height" Value="28" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parent}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Chosen}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Background><Binding Path="Back" /></Button.Background>
                                                <Button.Foreground><Binding Path="Ink" /></Button.Foreground>
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Button>

                                            <Border Width="2" Height="16" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" Background="{Binding Bar}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 右邊：這一節的每一群 -->
                    <ScrollViewer x:Name="Page" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,16">
                        <StackPanel>
                            <!-- 每一節一段：標題、一項一列、使用紀錄表、危險區 -->
                            <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <!-- 節標題：分類 › 節，下方一條細線 -->
                                            <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1" Padding="0,16,0,4">
                                                <TextBlock ToolTip="{Binding Note}">
                                                    <Run Text="{Binding Area, Mode=OneWay}" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextFaint}" />
                                                    <Run Text="›" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextFaint}" />
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Border>

                                            <!-- 一項一列：名稱、控制項與旁邊那一句、回復預設 -->
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Track}" BorderThickness="0,0,0,1" MinHeight="30">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="200" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="72" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="{DynamicResource Text}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}" />

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                                                                    <ItemsControl ItemsSource="{Binding Toggles}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Style="{StaticResource SettingSwitch}"
                                                                                          IsChecked="{Binding On, Mode=OneWay}"
                                                                                          Checked="Flip" Unchecked="Flip">
                                                                                    <TextBlock Text="{Binding Inline}" FontSize="{DynamicResource Text}"
                                                                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                                                                </CheckBox>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ItemsControl ItemsSource="{Binding Choices}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <ComboBox Style="{StaticResource SettingChoice}" MinWidth="200" Height="{DynamicResource ControlHeight}"
                                                                                          HorizontalAlignment="Left" FontSize="{DynamicResource Text}"
                                                                                          ItemsSource="{Binding Options}"
                                                                                          SelectedItem="{Binding Value, Mode=OneWay}"
                                                                                          SelectionChanged="Choose" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ItemsControl ItemsSource="{Binding Infos}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                                                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Moveds}" VerticalAlignment="Center">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource LinkButton}" Height="{DynamicResource ControlHeight}" Padding="0"
                                                                                    HorizontalAlignment="Right" FontSize="{DynamicResource Text}" Click="Reset">
                                                                                <TextBlock Text="{Binding Label}" TextDecorations="Underline" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 關於本軟體：每支工具的使用紀錄，一格一個值 -->
                                            <ItemsControl ItemsSource="{Binding Ledgers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4,0,0">
                                                            <TextBlock Text="每支工具的使用紀錄，最近用過的在前" FontSize="{DynamicResource Text}"
                                                                       Foreground="{DynamicResource TextMuted}" Margin="0,4" />
                                                            <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1" Height="28">
                                                                <Grid TextElement.FontSize="{DynamicResource Text}" TextElement.Foreground="{DynamicResource TextMuted}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="56" />
                                                                        <ColumnDefinition Width="128" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="工具" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="開啟次數" TextAlignment="Right" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="最後開啟" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="{DynamicResource Track}" BorderThickness="0,0,0,1" Height="28">
                                                                            <Grid TextElement.FontSize="{DynamicResource Text}">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="56" />
                                                                                    <ColumnDefinition Width="128" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding opens}" Style="{StaticResource Mono}" TextAlignment="Right" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding last_open_text, TargetNullValue=—}" Margin="12,0,0,0" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 危險區：有框、放在這一節最後 -->
                                            <ItemsControl ItemsSource="{Binding Dangers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                                                                BorderBrush="{DynamicResource DangerLine}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextSecondary}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="：" /><Run Text="{Binding Tip, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Actions}" Margin="12,0,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource FillButton}" FontWeight="Normal" FontSize="{DynamicResource Text}"
                                                                                    Content="{Binding Label}" Foreground="{Binding Ink}" BorderBrush="{Binding Line}" Click="Act" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 工具的那一節：那支工具自己的設定畫面掛在這裡 -->
                            <ContentControl x:Name="ToolPane" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Border>
</UserControl>
