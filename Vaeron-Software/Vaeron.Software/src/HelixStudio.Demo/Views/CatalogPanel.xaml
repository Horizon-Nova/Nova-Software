<UserControl x:Class="HelixStudio.Views.CatalogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HelixStudio.Views"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Body}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <UserControl.Resources>
        <!-- 清單的一列：高 32，選中的有淺底、主色字、左邊一條主色 -->
        <Style x:Key="ToolRow" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="back" Background="Transparent" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource HoverBack}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource Brand100}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand700}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 頁首一列：標題與總數、搜尋、分類、匯入 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" Padding="16,0"
                BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="工具目錄" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextMuted}"
                           Margin="12,0,0,0" VerticalAlignment="Center">
                    <Run Text="共" /> <Run Text="{Binding Summary.tool_count, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /> <Run Text="支" />
                </TextBlock>

                <!-- 搜尋框；沒打字時蓋一層提示，取得焦點時下面掛最近搜尋 -->
                <Grid Grid.Column="2" Width="260" Margin="20,0,12,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource SearchFrame}" Height="28">
                        <Grid>
                            <TextBox x:Name="SearchText" Style="{StaticResource SearchBox}" FontSize="{DynamicResource Caption}"
                                     TextChanged="Search" GotKeyboardFocus="OpenRecent" LostKeyboardFocus="CloseRecent" />
                            <TextBlock Text="以名稱、維護團隊或用途搜尋" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextFaint}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Popup x:Name="RecentPanel" PlacementTarget="{Binding ElementName=SearchText}"
                           Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="8" Padding="4" Width="260">
                            <StackPanel>
                                <TextBlock Text="最近搜尋" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextFaint}"
                                           Padding="12,8,12,4" />
                                <ItemsControl ItemsSource="{Binding Recents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Height="32"
                                                    Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource Body}"
                                                    HorizontalContentAlignment="Left" Content="{Binding}"
                                                    Click="PickRecent" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 分類與清除篩選 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ListBox Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource ChipItem}"
                             ItemsSource="{Binding Chips}" SelectedIndex="{Binding Selected, Mode=OneWay}"
                             SelectionChanged="PickCat" VerticalAlignment="Center">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Count}" Style="{StaticResource MonoText}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Style="{StaticResource LinkButton}" Content="清除篩選" Click="Clear" VerticalAlignment="Center">
                        <Button.Visibility>
                            <Binding Path="Filtered">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </Button.Visibility>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左邊清單、右邊選中那一支的資訊，各自捲 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="618*" />
                <ColumnDefinition Width="382*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 欄名：數字靠右，排序的那一欄帶箭頭 -->
                    <Border Grid.Row="0" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                        <Grid TextElement.FontSize="{DynamicResource Caption}" TextElement.Foreground="{DynamicResource TextMuted}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="工具" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="維護團隊" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="版本" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="最後開啟 ↓" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="開啟" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ToolList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedIndex="{Binding Chosen, Mode=OneWay}"
                             ItemContainerStyle="{StaticResource ToolRow}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="PickTool" MouseDoubleClick="LaunchTool" KeyDown="ToolKey">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ContentControl Content="{Binding Paths}" ContentTemplate="{StaticResource LucideIcon16}"
                                                        Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Vendor}" Margin="12,0,0,0" FontSize="{DynamicResource Caption}"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Vendor}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Version}" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding LastOpen, TargetNullValue=—}" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Opens}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                                               FontSize="{DynamicResource Caption}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 一支工具都沒有：Demo 的工具跟安裝檔一起來，沒有就是安裝不完整 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Firsts}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="420" Margin="0,48" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource WindowBack}"
                                            HorizontalAlignment="Center">
                                        <ContentControl Content="{Binding}" Foreground="{DynamicResource TextMuted}"
                                                        ContentTemplate="{StaticResource LucideIcon24}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="還沒有工具可以用" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center" />
                                    <TextBlock Text="Demo 的工具跟安裝檔一起來。再執行一次 HelixStudio Demo 安裝檔，再開一次平台。" FontSize="{DynamicResource Caption}"
                                               LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,16" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 有工具但一支都不符合 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Empties}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="420" Margin="0,48" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource WindowBack}"
                                            HorizontalAlignment="Center">
                                        <ContentControl Content="{Binding Paths}" Foreground="{DynamicResource TextMuted}"
                                                        ContentTemplate="{StaticResource LucideIcon24}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="找不到符合的工具" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,16" Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="搜尋「" /><Run Text="{Binding Query, Mode=OneWay}" /><Run Text="」、分類「" /><Run Text="{Binding Cat, Mode=OneWay}" /><Run Text="」沒有相符的工具。" />
                                    </TextBlock>
                                    <Button Style="{StaticResource FillButton}" Click="Clear"
                                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="Transparent"
                                            FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="看全部" /> <Run Text="{Binding DataContext.Summary.tool_count, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" /> <Run Text="支工具" />
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 讀太久才蓋上的骨架：一列一條，光澤由左往右掃 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Skeletons}" Background="{DynamicResource ContentBack}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skeletons.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="32" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                                    <Border Height="11" Width="240" HorizontalAlignment="Left" Background="{DynamicResource Shine}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 右邊這一欄有自己的資料；一支工具都沒有時收起來 -->
            <views:DetailPanel x:Name="Info" Grid.Column="1" />

        </Grid>
    </Grid>
</UserControl>
