<Window x:Class="HelixStudio.Views.LicenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelixStudio" Width="1440" Height="900" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Noto Sans TC"
        FontSize="{DynamicResource Text}" Foreground="#1b1b1b"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=Paste}">

    <!-- 畫面照設計檔 software/DesktopShell.dc.html 的授權畫面「啟用這台電腦」（第 36–120 行） -->
    <Window.Resources>
        <FontFamily x:Key="Plex">IBM Plex Mono, Consolas</FontFamily>

        <!-- 按鈕：圓角 4，滑鼠停上去換成 Tag 給的底色 -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="back" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 區塊標題列：左邊標題，右邊小字 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1b1b1b" />
        </Style>
        <Style x:Key="Aside" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="Foreground" Value="#5c5c5c" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- 貼上授權的框：取得焦點時框線變主色、外圈一道淡藍光暈 -->
        <Style x:Key="PasteRing" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#240f6cc5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PasteFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding PasteLine}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#0f6cbd" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PasteHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=Paste}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="280" />
            <ColumnDefinition Width="3*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- 左欄 -->
        <DockPanel Grid.Column="0" Background="#1f1f1f" LastChildFill="True">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,24,24,32">

                    <!-- 產品 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                        <Image Width="28" Height="28" Source="{StaticResource HelixMark}" />
                        <TextBlock Text="HelixStudio" Foreground="White" FontSize="{DynamicResource Text}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- 標頭 -->
                    <TextBlock Text="啟用這台電腦" FontSize="{DynamicResource Title}" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="這台電腦還沒有授權。照下面三步做，驗過就能進平台。" FontSize="{DynamicResource Text}" Foreground="#d0d0d0"
                               LineHeight="{DynamicResource TextLine}" TextWrapping="Wrap" Margin="0,8,0,32" />

                    <!-- 三步 -->
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                            Background="{Binding Back}" BorderBrush="{Binding Line}" BorderThickness="{Binding Thick}">
                                        <Grid>
                                            <TextBlock Text="{Binding Dot}" FontFamily="{StaticResource Plex}" FontSize="{DynamicResource Text}"
                                                       FontWeight="Medium" Foreground="{Binding Ink}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <ContentControl Content="{Binding Paths}" ContentTemplate="{StaticResource LucideIcon14}"
                                                            Foreground="{Binding Ink}" Focusable="False"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text}" FontWeight="SemiBold" Foreground="{Binding TitleInk}" />
                                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Text}" Foreground="#b8b8b8" LineHeight="{DynamicResource TextLine}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 三條規則：接在三步後面，視窗矮的時候跟著一起捲，不蓋住第三步 -->
                    <Border Margin="0,12,0,0" Padding="0,16,0,0"
                            BorderBrush="#24ffffff" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ContentControl Content="{Binding Paths}" ContentTemplate="{StaticResource LucideIcon14}"
                                                        Foreground="#9ccbf5" Focusable="False" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Text}" Foreground="#d0d0d0"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- 右欄 -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,24">

                    <!-- 申請碼 -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Height="{DynamicResource ControlHeight}" Padding="12,0"
                                FontSize="{DynamicResource Text}" Background="White" Tag="#f3f3f3" Foreground="{Binding CopyInk}"
                                BorderBrush="{Binding CopyLine}" BorderThickness="1" Click="CopyAsk">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{Binding CopyPaths}" ContentTemplate="{StaticResource LucideIcon14}"
                                                Foreground="{Binding CopyInk}" Focusable="False" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CopyLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="申請碼" Style="{StaticResource Label}" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <Border MaxHeight="92" Background="#f5f5f5" BorderBrush="#14000000" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}" Margin="0,0,0,24">
                        <TextBox Text="{Binding Ask, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Padding="10,8" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Plex}"
                                 FontSize="{DynamicResource Text}" Foreground="#1b1b1b" />
                    </Border>

                    <!-- 機器識別 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MarksNote}" Style="{StaticResource Aside}" />
                        <TextBlock Text="機器識別" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Border BorderBrush="#14000000" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True" Margin="0,0,0,24">
                        <ItemsControl ItemsSource="{Binding Marks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding Line}" BorderThickness="0,1,0,0" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{DynamicResource Text}" Foreground="#5c5c5c" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Plex}"
                                                       FontSize="{DynamicResource Text}" Foreground="#1b1b1b" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 貼上授權 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="賣方回給你的那段 KEY" Style="{StaticResource Aside}" />
                        <TextBlock Text="貼上授權" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Border Style="{StaticResource PasteRing}" BorderThickness="3" CornerRadius="7" Margin="-3">
                        <Border Style="{StaticResource PasteFrame}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Background="White">
                            <Grid>
                                <TextBlock Text="貼上賣方提供的 KEY…" Style="{StaticResource PasteHint}" Margin="12,10"
                                           FontFamily="{StaticResource Plex}" FontSize="{DynamicResource Text}" Foreground="#767676" IsHitTestVisible="False" />
                                <TextBox x:Name="Paste" BorderThickness="0" Background="Transparent" Padding="10,8"
                                         FontFamily="{StaticResource Plex}" FontSize="{DynamicResource Text}" Foreground="#1b1b1b"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinLines="4"
                                         VerticalScrollBarVisibility="Auto" TextChanged="Typed" />
                            </Grid>
                        </Border>
                    </Border>
                    <ItemsControl ItemsSource="{Binding PasteErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Margin="0,2,0,0" Focusable="False" VerticalAlignment="Top"
                                                    Content="{Binding DataContext.ErrorPaths, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ContentTemplate="{StaticResource LucideIcon14}" Foreground="#a4262c" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="{DynamicResource Text}" LineHeight="{DynamicResource TextLine}" Foreground="#a4262c"
                                               TextWrapping="Wrap" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 結束在左，套用授權在右：緊接在貼上框下面，貼完就按得到 -->
                    <DockPanel Margin="0,24,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Flat}" Padding="16,0" Background="White"
                                BorderBrush="#24000000" BorderThickness="1" Tag="#f3f3f3" Content="結束" Click="Quit" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Padding="16,0" Background="#0f6cbd"
                                Foreground="White" BorderBrush="Transparent" BorderThickness="1" Tag="#0c5a9e"
                                FontWeight="SemiBold" Content="套用授權" Click="Apply" />
                    </DockPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
