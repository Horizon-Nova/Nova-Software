<UserControl x:Class="HelixStudio.Views.PalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Text}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <!-- 遮罩：點旁邊就關掉；面板貼在上方 -->
    <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="Dismiss">
        <Grid Width="600" MaxHeight="520" Margin="16,72,16,16" VerticalAlignment="Top">

            <!-- 陰影單獨一層，面板裡的字才留得住 ClearType -->
            <Border CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Surface}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="64" ShadowDepth="16" Direction="270" Opacity="0.24" />
                </Border.Effect>
            </Border>

            <Border CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 搜尋列 -->
                    <Border Grid.Row="0" Height="48" Padding="16,0"
                            BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Content="{Binding SearchPaths}"
                                            Foreground="{DynamicResource TextFaint}"
                                            ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="12,0">
                                <TextBox x:Name="Search" TextChanged="Find"
                                         BorderThickness="0" Background="Transparent" FontSize="{DynamicResource Text}"
                                         VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}" Loaded="TakeFocus" />
                                <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextFaint}"
                                           FontSize="{DynamicResource Text}" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource HairLine}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EscLabel}" Style="{StaticResource MonoText}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 分組的每一列 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Label}" Padding="8,8,8,4"
                                                       FontSize="{DynamicResource Text}"
                                                       Foreground="{DynamicResource TextFaint}" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource PaletteRow}" Click="Pick">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="28" Height="28"
                                                                        CornerRadius="{StaticResource RadiusSm}" Margin="0,0,12,0"
                                                                        Background="{DynamicResource WindowBack}">
                                                                    <ContentControl Content="{Binding Paths}"
                                                                                    Foreground="{DynamicResource TextSecondary}"
                                                                                    ContentTemplate="{StaticResource LucideIcon16}"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="{DynamicResource Text}"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Pre, Mode=OneWay}" /><Run
                                                                            Text="{Binding Hit, Mode=OneWay}"
                                                                            Foreground="{DynamicResource Accent}"
                                                                            FontWeight="SemiBold" /><Run
                                                                            Text="{Binding Post, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Hint}"
                                                                               FontSize="{DynamicResource Text}"
                                                                               Foreground="{DynamicResource TextMuted}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}"
                                                                              VerticalAlignment="Center">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Height="20" Padding="8,0" CornerRadius="{StaticResource RadiusSm}"
                                                                                    BorderBrush="{DynamicResource HairLine}"
                                                                                    BorderThickness="1">
                                                                                <TextBlock Text="{Binding}"
                                                                                           FontSize="{DynamicResource Text}"
                                                                                           Foreground="{DynamicResource TextMuted}"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Empties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="16,24" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text}"
                                                       Margin="0,0,0,8" TextAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Text}"
                                                       LineHeight="{DynamicResource TextLine}"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
