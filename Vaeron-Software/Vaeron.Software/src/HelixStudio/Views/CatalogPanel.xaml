<UserControl x:Class="HelixStudio.Views.CatalogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HelixStudio.Views"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Text}"
             Foreground="{DynamicResource TextPrimary}" PreviewKeyDown="Escape">

    <!-- 左邊清單、右邊選中那一支的資訊，各自捲；頂部只有搜尋，沒有分類 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="382*" />
            <ColumnDefinition Width="618*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 搜尋框：caption 字，高照 SmallHeight；沒打字時蓋一層提示，取得焦點時下面掛最近搜尋 -->
                <Grid x:Name="SearchBox" Grid.Row="0" Margin="16,8,16,0">
                    <Border Style="{StaticResource SearchFrame}" Height="{DynamicResource ControlHeight}">
                        <Grid>
                            <TextBox x:Name="SearchText" Style="{StaticResource SearchBox}" FontSize="{DynamicResource Text}"
                                     TextChanged="Search" GotKeyboardFocus="OpenRecent" LostKeyboardFocus="CloseRecent" />
                            <TextBlock Text="以名稱、維護團隊或用途搜尋" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextFaint}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Popup x:Name="RecentPanel" PlacementTarget="{Binding ElementName=SearchText}"
                           Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="4" Width="{Binding ActualWidth, ElementName=SearchBox}">
                            <StackPanel>
                                <TextBlock Text="最近搜尋" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextFaint}"
                                           Padding="12,8,12,4" />
                                <ItemsControl ItemsSource="{Binding Recents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Height="32"
                                                    Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource Text}"
                                                    HorizontalContentAlignment="Left" Content="{Binding}"
                                                    Click="PickRecent" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                    <!-- 欄名：數字靠右，排序的那一欄帶箭頭 -->
                    <Border Grid.Row="1" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                        <Grid TextElement.FontSize="{DynamicResource Text}" TextElement.Foreground="{DynamicResource TextMuted}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="工具" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="最後開啟 ↓" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="開啟" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="金鑰到期" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ToolList" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedIndex="{Binding Chosen, Mode=OneWay}"
                             ItemContainerStyle="{StaticResource ListRow}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="PickTool" MouseDoubleClick="LaunchTool" KeyDown="ToolKey">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ContentControl Content="{Binding Paths}" ContentTemplate="{StaticResource LucideIcon16}"
                                                        Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LastOpen, TargetNullValue=—}" Margin="12,0,0,0" Style="{StaticResource Mono}"
                                               FontSize="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Opens}" Style="{StaticResource Mono}" TextAlignment="Right"
                                               FontSize="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Expires, TargetNullValue=—}" Margin="12,0,0,0"
                                               FontSize="{DynamicResource Text}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 一支工具都沒有 -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Firsts}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="420" Margin="0,48" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource WindowBack}"
                                            HorizontalAlignment="Center">
                                        <ContentControl Content="{Binding}" Foreground="{DynamicResource TextMuted}"
                                                        ContentTemplate="{StaticResource LucideIcon24}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="還沒有工具可以用" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center" />
                                    <TextBlock Text="這台裝置還沒有任何工具。匯入工具套件檔就能開始用。" FontSize="{DynamicResource Text}"
                                               LineHeight="{DynamicResource TextLine}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,16" Foreground="{DynamicResource TextSecondary}" />
                                    <Button Style="{StaticResource FillButton}" Content="匯入工具套件…"
                                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="Transparent"
                                            FontWeight="SemiBold" HorizontalAlignment="Center" Click="OpenImport" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 有工具但一支都不符合 -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Empties}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="420" Margin="0,48" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource WindowBack}"
                                            HorizontalAlignment="Center">
                                        <ContentControl Content="{Binding Paths}" Foreground="{DynamicResource TextMuted}"
                                                        ContentTemplate="{StaticResource LucideIcon24}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="找不到符合的工具" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="{DynamicResource Text}" LineHeight="{DynamicResource TextLine}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,16" Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="名稱、維護團隊、用途都沒有「" /><Run Text="{Binding Query, Mode=OneWay}" /><Run Text="」。" />
                                    </TextBlock>
                                    <Button Style="{StaticResource FillButton}" Click="Clear"
                                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="Transparent"
                                            FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="看全部" /> <Run Text="{Binding DataContext.Summary.tool_count, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" /> <Run Text="支工具" />
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 讀太久才蓋上的骨架：一列一條，光澤由左往右掃 -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Skeletons}" Background="{DynamicResource ContentBack}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skeletons.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="32" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                                    <Border Height="11" Width="240" HorizontalAlignment="Left" Background="{DynamicResource Shine}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <!-- 清單底下：匯入工具套件 -->
                <Border Grid.Row="3" Padding="16,8" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource FillButton}" FontWeight="Normal" HorizontalAlignment="Left" Click="OpenImport">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Width="12" Height="12" Content="{Binding Plus}"
                                            ContentTemplate="{StaticResource LucideIcon}" VerticalAlignment="Center" />
                            <TextBlock Text="匯入工具套件…" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- 右邊這一欄有自己的資料；一支工具都沒有時收起來 -->
        <views:DetailPanel x:Name="Info" Grid.Column="1" />
    </Grid>
</UserControl>