<Window x:Class="HelixStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:HelixStudio.Views"
        Title="HelixStudio" Width="1440" Height="900"
        Background="{DynamicResource WindowBack}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Body}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        ToolTipService.InitialShowDelay="300" PreviewKeyDown="Shortcut">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 標題列：高 36（按鈕 28 ＋ 上下各 4），和側邊導覽列的寬同一組數字；品牌標誌對齊側欄圖示的中線 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="跳至主內容" Click="SkipToMain" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="3">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FillButton}">
                        <Setter Property="Width" Value="0" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
                <Image Width="16" Height="16" Source="{StaticResource HelixMark}" />
                <TextBlock Text="{Binding Product}" FontSize="{DynamicResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CrumbText" Text="{Binding Crumb}" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextMuted}"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource FillButton}" Height="28" MaxWidth="360"
                    Margin="0,4" Padding="8,0" FontWeight="Normal" Click="OpenPalette"
                    ToolTip="{Binding SearchHint}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Width="12" Height="12" VerticalAlignment="Center"
                                    Content="{Binding Icons[search]}" ContentTemplate="{StaticResource LucideIcon}" />
                    <TextBlock Text="{Binding SearchLabel}" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextMuted}"
                               Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Ctrl K" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Caption}"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" ToolTip="最小化" Click="Minimize"
                        Content="{Binding Icons[minus]}" ContentTemplate="{StaticResource LucideIcon12}" />
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" ToolTip="最大化" Click="ToggleMax"
                        Content="{Binding Icons[square]}" ContentTemplate="{StaticResource LucideIcon12}" />
                <Button Style="{StaticResource CloseButton}" ToolTip="關閉" Click="CloseWindow"
                        Content="{Binding Icons[x]}" ContentTemplate="{StaticResource LucideIcon12}" />
            </StackPanel>
        </Grid>

        <!-- 主區：側邊導覽列 36、間隔 8、內容區 -->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Border Width="24" Height="1" Margin="0,4" Background="{DynamicResource Divider}" />
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource GearButton}" Checked="ToggleSettings" Unchecked="ToggleSettings"
                                  ToolTip="設定">
                        <ContentControl Content="{Binding Icons[settings]}" ContentTemplate="{StaticResource LucideIcon16}" />
                    </ToggleButton>
                </StackPanel>

                <ListBox x:Name="RailList" Style="{StaticResource RailList}"
                         ItemContainerStyle="{StaticResource RailItem}"
                         SelectionChanged="PickRail">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Name}">
                                <ContentControl Content="{Binding Paths}" ContentTemplate="{StaticResource LucideIcon16}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" Background="{DynamicResource ContentBack}" BorderBrush="{DynamicResource HairLine}"
                    BorderThickness="1" CornerRadius="8">
                <Grid x:Name="Body">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 出了狀況：停到使用者按重試或關掉為止 -->
                    <ItemsControl x:Name="FaultList" Grid.Row="0" Panel.ZIndex="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Back}" BorderBrush="{Binding Line}"
                                        BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Grid.Column="0" Content="{Binding Paths}" Foreground="{Binding Ink}"
                                                        ContentTemplate="{StaticResource LucideIcon16}"
                                                        VerticalAlignment="Top" Margin="0,4,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Body}" FontWeight="SemiBold"
                                                       Foreground="{Binding Ink}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoText}"
                                                       Margin="0,4,0,0" LineHeight="{DynamicResource CaptionLine}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource FillButton}" Margin="12,0,0,0"
                                                Content="{Binding RetryLabel}" Click="Retry" VerticalAlignment="Top" />
                                        <Button Grid.Column="3" Style="{StaticResource WindowButton}" Width="28" Height="28"
                                                Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="關閉" Click="DropFault"
                                                ContentTemplate="{StaticResource LucideIcon12}"
                                                Content="{Binding DataContext.Icons[x], RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <views:CatalogPanel x:Name="Catalog" Grid.Row="1" />
                    <views:HostPanel x:Name="Host" Grid.Row="1" Visibility="Collapsed" />

                    <!-- 啟用工具：匯入後第一次開，貼一次工具金鑰；蓋住內容區，不蓋側欄 -->
                    <Grid x:Name="Activation" Grid.Row="1" Background="#40000000" Visibility="Collapsed" Panel.ZIndex="1">
                        <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource Surface}" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity=".18" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Margin="20,20,20,12">
                                    <TextBlock x:Name="ActivationTitle" FontSize="{DynamicResource Heading}" FontWeight="SemiBold" />
                                    <TextBlock Text="這支工具剛匯入，第一次開要貼上工具金鑰。啟用一次就好。" FontSize="{DynamicResource Caption}"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="申請碼" FontSize="{DynamicResource Caption}"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SearchFrame}" Height="32">
                                            <TextBox x:Name="ActivationAsk" Style="{StaticResource SearchBox}" IsReadOnly="True"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Caption}" />
                                        </Border>
                                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FillButton}" Width="32" Height="32" Padding="0"
                                                Margin="8,0,0,0" ToolTip="複製申請碼" Click="CopyAsk">
                                            <ContentControl Width="16" Height="16" Content="{Binding Icons[copy]}" ContentTemplate="{StaticResource LucideIcon}" />
                                        </Button>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="工具金鑰" FontSize="{DynamicResource Caption}"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,20,0,0" />
                                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SearchFrame}" Height="88" Margin="0,12,0,0">
                                            <TextBox x:Name="ActivationKey" Style="{StaticResource SearchBox}" AcceptsReturn="False" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Caption}" />
                                        </Border>
                                        <TextBlock x:Name="ActivationFault" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                                   FontSize="{DynamicResource Caption}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" Padding="20,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="啟用" Style="{StaticResource FillButton}" Height="32" Padding="16,0"
                                                Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="Transparent"
                                                Margin="8,0,0,0" Click="Activate" />
                                        <Button DockPanel.Dock="Right" Content="回工具目錄" Style="{StaticResource FillButton}" Height="32" Padding="16,0"
                                                FontWeight="Normal" Click="CancelActivation" />
                                        <TextBlock Text="金鑰綁這台電腦；換電腦要重發。" FontSize="{DynamicResource Caption}"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 通知：右下角，新的把舊的往上推 -->
                    <ItemsControl x:Name="NoteList" Grid.RowSpan="2" Panel.ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MaxWidth="360" Margin="0,8,0,0" Style="{StaticResource Enter}">

                                    <!-- 陰影單獨一層，通知裡的字才留得住 ClearType -->
                                    <Border CornerRadius="8" Background="{DynamicResource Surface}" IsHitTestVisible="False">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.16" />
                                        </Border.Effect>
                                    </Border>

                                <Border CornerRadius="8" Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                        MouseEnter="HoldNote" MouseLeave="ResumeNote">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3" CornerRadius="8,0,0,8" Background="{Binding Ink}" />
                                        <ContentControl Grid.Column="1" Content="{Binding Paths}" Foreground="{Binding Ink}"
                                                        ContentTemplate="{StaticResource LucideIcon16}"
                                                        Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="{DynamicResource Caption}" LineHeight="{DynamicResource CaptionLine}"
                                                   TextWrapping="Wrap" Margin="12,12,12,12" VerticalAlignment="Center" />

                                        <Button Grid.Column="4" Style="{StaticResource WindowButton}" Width="32" Height="32"
                                                ToolTip="關閉" Click="DropNote"
                                                ContentTemplate="{StaticResource LucideIcon12}"
                                                Content="{Binding DataContext.Icons[x], RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 指令面板：蓋在所有東西上面 -->
        <views:PalettePanel x:Name="Palette" Grid.RowSpan="3" Visibility="Collapsed" />

        <!-- 設定：蓋在所有東西上面 -->
        <views:SettingsPanel x:Name="Settings" Grid.RowSpan="3" Visibility="Collapsed" />

        <!-- 狀態列 -->
        <Grid Grid.Row="2" Margin="8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource StatusText}">
                    <Run Text="已安裝" /> <Run Text="{Binding Summary.tool_count, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /> <Run Text="支" />
                </TextBlock>
            </StackPanel>

            <!-- 這台電腦：標籤固定，值讀這台電腦與套件庫 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource StatusText}" Text="離線版" ToolTip="工廠版本，只在這台電腦與廠內運作，不連外部伺服器" />
                <Border Width="1" Height="14" Margin="4,0" Background="{DynamicResource Divider}" />
                <TextBlock Style="{StaticResource StatusText}">
                    <Run Text="電腦" /> <Run Text="{Binding Host, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
                <Border Width="1" Height="14" Margin="4,0" Background="{DynamicResource Divider}" />
                <TextBlock Style="{StaticResource StatusText}">
                    <Run Text="套件庫匯入" /> <Run Text="{Binding Summary.sync_text, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
                <Border Width="1" Height="14" Margin="4,0" Background="{DynamicResource Divider}" />
                <TextBlock Style="{StaticResource StatusText}">
                    <Run Text="用戶端" /> <Run Text="{Binding Client, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
