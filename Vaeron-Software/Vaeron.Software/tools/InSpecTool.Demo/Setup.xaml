<UserControl x:Class="InSpecTool.Setup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextPrimary}"
             Loaded="Ready">

    <UserControl.Resources>
        <!-- 群組標題：下方一條細線，跟平台設定的其他群一樣 -->
        <Style x:Key="Head" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource HairLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,16,0,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="HeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <!-- 行內編輯：平常像一般的字，滑過有淡淡的底，點進去才出現框；字型、大小、內距不變 -->
        <Style x:Key="InlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 開關：軌道 32×16，圓鈕 12，開的時候主色、圓鈕靠右 -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="32" Height="16" CornerRadius="8" Background="{DynamicResource CheckLine}">
                            <Ellipse x:Name="knob" Width="12" Height="12" Margin="2,0" HorizontalAlignment="Left" Fill="{DynamicResource Surface}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 一列的標題：同一列、在輸入框左邊 -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 路徑 -->
        <Border Style="{StaticResource Head}" Padding="0,8,0,4">
            <TextBlock Text="路徑" Style="{StaticResource HeadText}" />
        </Border>
        <Grid Margin="16,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="搜尋資料夾" Style="{StaticResource RowLabel}" />
            <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Height="{DynamicResource ControlHeight}">
                <TextBox x:Name="SearchFolder" Tag="searchFolder" Style="{StaticResource SearchBox}" MaxLength="32767" LostFocus="PathChanged" />
            </Border>
            <Button Grid.Column="2" Content="瀏覽" Tag="searchFolder" Style="{StaticResource FillButton}" Height="{DynamicResource ControlHeight}"
                    Margin="12,0,0,0" Click="Browse" />
        </Grid>

        <!-- 條碼與結果 -->
        <Border Style="{StaticResource Head}">
            <TextBlock Text="條碼與結果" Style="{StaticResource HeadText}" />
        </Border>
        <Grid Margin="16,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="條碼解析間隔" Style="{StaticResource RowLabel}" ToolTip="停止輸入後等這麼久才解析，單位毫秒" />
            <!-- 選項是設計圖上固定的字；Tag 是寫進 number 的毫秒 -->
            <ComboBox x:Name="Interval" Grid.Column="1" Style="{StaticResource SettingChoice}" Width="200"
                      HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="IntervalChanged">
                <ComboBoxItem Content="80"><ComboBoxItem.Tag><sys:Int32>80</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="120"><ComboBoxItem.Tag><sys:Int32>120</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="160"><ComboBoxItem.Tag><sys:Int32>160</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="200"><ComboBoxItem.Tag><sys:Int32>200</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="300"><ComboBoxItem.Tag><sys:Int32>300</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                <ComboBoxItem Content="500"><ComboBoxItem.Tag><sys:Int32>500</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
            </ComboBox>
        </Grid>
        <Grid Margin="16,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="跑完顯示結果" Style="{StaticResource RowLabel}" />
            <CheckBox x:Name="ShowResult" Grid.Column="1" Content="顯示" Style="{StaticResource SettingCheck}" Click="ShowResultChanged" />
        </Grid>

        <!-- 欄位結構：鎖由平台的工具金鑰管；改了當場存 -->
        <Border Style="{StaticResource Head}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="欄位結構" Style="{StaticResource HeadText}"
                           ToolTip="欄位順序就是條碼分段的順序；InSpec 提示要和量測程式裡的提示文字完全相同（不分大小寫）才會自動填入" />
                <TextBlock Grid.Column="1" x:Name="SaveText" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <StackPanel Margin="16,4,0,0">
            <Grid Height="32" Margin="8,0" TextElement.FontSize="{DynamicResource Text}" TextElement.Foreground="{DynamicResource TextMuted}">
                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="欄位" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="InSpec 提示" Margin="20,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="填法" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="主頁可改" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:Name="FieldRows" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" Height="30" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Order}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource Text}"
                                       Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" ToolTip="條碼的第幾段" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineBox}" MaxLength="50" LostFocus="Save" />
                            <TextBox Grid.Column="2" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineBox}" Margin="12,0,0,0"
                                     MaxLength="255" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource Text}" LostFocus="Save" />
                            <ComboBox Grid.Column="3" Style="{StaticResource SettingChoice}" Margin="12,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding Mode}"
                                      SelectionChanged="ModeChanged">
                                <ComboBoxItem Content="直接填" Tag="fill" />
                                <ComboBoxItem Content="先確認再填" Tag="confirm" />
                            </ComboBox>
                            <CheckBox Grid.Column="4" IsChecked="{Binding Editable}" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Click="Save" />
                            <Button Grid.Column="5" Style="{StaticResource WindowButton}" Width="{DynamicResource ControlHeight}" Height="{DynamicResource ControlHeight}" ToolTip="更多動作"
                                    Click="More" ContentTemplate="{StaticResource LucideIcon14}"
                                    Content="{Binding DataContext.MorePaths, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <Button.ContextMenu>
                                    <ContextMenu FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource Text}">
                                        <MenuItem Header="上移" Tag="-1" Click="Move" />
                                        <MenuItem Header="下移" Tag="1" Click="Move" />
                                        <Separator />
                                        <MenuItem Header="移除" Foreground="{DynamicResource Danger}" Click="Remove" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource LinkButton}" Height="44" Padding="40,0,0,0" HorizontalContentAlignment="Left"
                    BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" Click="Add">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding PlusPaths}" ContentTemplate="{StaticResource LucideIcon14}" VerticalAlignment="Center" />
                    <TextBlock Text="新增欄位" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
