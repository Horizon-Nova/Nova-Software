<UserControl x:Class="VNCSCP.Board"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextPrimary}"
             Loaded="Ready" Unloaded="Gone">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- 這一頁用到的圖示（lucide） -->
        <x:Array x:Key="IconCheck" Type="sys:String"><sys:String>M20 6 9 17l-5-5</sys:String></x:Array>
        <x:Array x:Key="IconMinus" Type="sys:String"><sys:String>M5 12h14</sys:String></x:Array>
        <x:Array x:Key="IconX" Type="sys:String"><sys:String>M18 6 6 18</sys:String><sys:String>m6 6 12 12</sys:String></x:Array>
        <x:Array x:Key="IconActivity" Type="sys:String"><sys:String>M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2</sys:String></x:Array>
        <x:Array x:Key="IconPlus" Type="sys:String"><sys:String>M5 12h14</sys:String><sys:String>M12 5v14</sys:String></x:Array>
        <x:Array x:Key="IconEye" Type="sys:String"><sys:String>M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0</sys:String><sys:String>M 9,12 A 3,3 0 1 0 15,12 A 3,3 0 1 0 9,12 Z</sys:String></x:Array>
        <x:Array x:Key="IconEyeOff" Type="sys:String"><sys:String>M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49</sys:String><sys:String>M14.084 14.158a3 3 0 0 1-4.242-4.242</sys:String><sys:String>M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143</sys:String><sys:String>m2 2 20 20</sys:String></x:Array>
        <x:Array x:Key="IconAlert" Type="sys:String"><sys:String>M 2,12 A 10,10 0 1 0 22,12 A 10,10 0 1 0 2,12 Z</sys:String><sys:String>M12 8v4</sys:String><sys:String>M12 16h.01</sys:String></x:Array>
        <x:Array x:Key="IconMonitor" Type="sys:String"><sys:String>M 4,3 L 20,3 A 2,2 0 0 1 22,5 L 22,15 A 2,2 0 0 1 20,17 L 4,17 A 2,2 0 0 1 2,15 L 2,5 A 2,2 0 0 1 4,3 Z</sys:String><sys:String>M8 21h8</sys:String><sys:String>M12 17v4</sys:String></x:Array>
        <x:Array x:Key="IconFiles" Type="sys:String"><sys:String>M20 7h-3a2 2 0 0 1-2-2V2</sys:String><sys:String>M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h7l4 4v10a2 2 0 0 1-2 2Z</sys:String><sys:String>M3 7.6v12.8A1.6 1.6 0 0 0 4.6 22h9.8</sys:String></x:Array>
        <x:Array x:Key="IconFolder" Type="sys:String"><sys:String>m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2</sys:String></x:Array>
        <x:Array x:Key="IconSend" Type="sys:String"><sys:String>M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z</sys:String><sys:String>m21.854 2.147-10.94 10.939</sys:String></x:Array>

        <!-- 次要按鈕：白底細框、一般字重 -->
        <Style x:Key="Plain" TargetType="Button" BasedOn="{StaticResource FillButton}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderBrush" Value="{DynamicResource Track}" />
        </Style>

        <!-- 主要按鈕：主色底、白字、SemiBold -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource FillButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- 只有圖示的小鈕（清除、顯示密碼、關閉） -->
        <Style x:Key="Glyph" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="back" CornerRadius="{StaticResource RadiusSm}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource PressBack}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 整列寬的按鈕（新增機台）：底下一條細線 -->
        <Style x:Key="Strip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="back" Height="32" Padding="12,0" Background="Transparent" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 欄名：可點排序；排序中的那一欄深色字 -->
        <Style x:Key="Head" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 核取方塊 16：勾、部分勾（一橫）、空 -->
        <Style x:Key="Box" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Height="24" Padding="4,0,8,0" CornerRadius="{StaticResource RadiusSm}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="box" Width="16" Height="16" CornerRadius="{StaticResource RadiusSm}" BorderThickness="1"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CheckLine}" VerticalAlignment="Center">
                                    <Grid>
                                        <ContentControl x:Name="tick" Content="{StaticResource IconCheck}" ContentTemplate="{StaticResource LucideIcon}"
                                                        Foreground="{DynamicResource OnAccent}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <ContentControl x:Name="dash" Content="{StaticResource IconMinus}" ContentTemplate="{StaticResource LucideIcon}"
                                                        Foreground="{DynamicResource OnAccent}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="label" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 新增機台的欄位框：錯的那一格紅框，正在打的那一格主色框 -->
        <Style x:Key="Field" TargetType="Border" BasedOn="{StaticResource SearchFrame}">
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderBrush" Value="{DynamicResource Track}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="fault">
                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 遠端路徑：平常看起來是字，滑鼠移到這一列時現出框，點進去是主色框 -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" CornerRadius="{StaticResource RadiusSm}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                <TextBlock x:Name="hint" Text="—" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFaint}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="frame" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="frame" Property="Background" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="hint" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 清單的一列（最近送出、來源的檔）：高 28，只有細線；左右內距與線在哪一邊跟著清單的 Tag 與 BorderThickness -->
        <Style x:Key="LineRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Height="28" Padding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" BorderBrush="{DynamicResource HairLine}"
                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ListBox}}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="BareList" TargetType="ListBox">
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer>
        </ControlTemplate>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Cut" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MonoCut" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="618*" />
            <ColumnDefinition Width="382*" />
        </Grid.ColumnDefinitions>

        <!-- 左：機台與最近送出 -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,1,0">
            <Grid x:Name="Left" SizeChanged="Fit">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- 工具列：全選、搜尋、全選符合的、再選上次送出的；右邊測試連線 -->
                <Border Grid.Row="0" Padding="12,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="TestButton" DockPanel.Dock="Right" Style="{StaticResource Plain}" Height="24" VerticalAlignment="Center" Click="Test">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{StaticResource IconActivity}" ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"><Run Text="測試連線 " /><Run x:Name="TestCount" FontFamily="{StaticResource MonoFont}" /><Run Text=" 台" /></TextBlock>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopTest" DockPanel.Dock="Right" Style="{StaticResource Plain}" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"
                                Content="取消測試" Visibility="Collapsed" Click="Cancel" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="All" Style="{StaticResource Box}" Margin="-4,0,0,0" Click="CheckAll">
                                <TextBlock><Run Text="全選 " /><Run x:Name="AllCount" FontFamily="{StaticResource MonoFont}" /><Run Text=" 台" /></TextBlock>
                            </CheckBox>
                            <TextBlock x:Name="NoMachine" Text="還沒有機台" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="QueryFrame" Style="{StaticResource Field}" Width="240" Margin="12,0,0,0">
                                <Grid>
                                    <TextBox x:Name="Query" Style="{StaticResource SearchBox}" Margin="0,0,20,0" AutomationProperties.Name="搜尋機台"
                                             TextChanged="Search" PreviewKeyDown="QueryKey" />
                                    <TextBlock x:Name="QueryHint" Text="以名稱、IP 或遠端路徑搜尋" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <Button x:Name="ClearQuery" Style="{StaticResource Glyph}" Width="20" Height="20" Margin="0,0,-6,0" HorizontalAlignment="Right"
                                            ToolTip="清除搜尋" Visibility="Collapsed" Click="Unsearch">
                                        <ContentControl Content="{StaticResource IconX}" ContentTemplate="{StaticResource LucideIcon}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Button x:Name="MatchButton" Style="{StaticResource Plain}" Height="24" Margin="8,0,0,0" Visibility="Collapsed" Click="CheckMatched">
                                <TextBlock><Run Text="全選符合的 " /><Run x:Name="MatchCount" FontFamily="{StaticResource MonoFont}" /><Run Text=" 台" /></TextBlock>
                            </Button>
                            <Button x:Name="LastButton" Style="{StaticResource Plain}" Height="24" Margin="8,0,0,0" Visibility="Collapsed" Click="CheckLast">
                                <TextBlock><Run Text="再選上次送出的 " /><Run x:Name="LastCount" FontFamily="{StaticResource MonoFont}" /><Run Text=" 台" /></TextBlock>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 機台表的欄名：點一下照那一欄排，再點一下反過來 -->
                <Border x:Name="Head" Grid.Row="1" Height="32" Padding="12,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource Head}" Margin="0,0,8,0" CommandParameter="name" Content="名稱" Click="Sort" />
                        <Button Grid.Column="2" Style="{StaticResource Head}" Margin="0,0,8,0" CommandParameter="addr" Content="位址" Click="Sort" />
                        <Button Grid.Column="3" Style="{StaticResource Head}" Margin="0,0,8,0" CommandParameter="path" Content="遠端路徑" Click="Sort" />
                        <Button Grid.Column="4" Style="{StaticResource Head}" Margin="0,0,8,0" CommandParameter="diff" Content="差" Click="Sort"
                                      HorizontalContentAlignment="Right" ToolTip="本機修改時間減機台那份的修改時間；滑鼠停在值上看機台那份與上次送達" />
                        <Button Grid.Column="5" Style="{StaticResource Head}" CommandParameter="ping" Content="上次回應" Click="Sort"
                                      HorizontalContentAlignment="Right" ToolTip="上次連線的回應耗時；上次出錯時是錯誤內容" />
                    </Grid>
                </Border>

                <!-- 機台、新增機台、第一次使用：同一個捲動範圍 -->
                <ScrollViewer x:Name="MachineScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="Machines" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" Padding="12,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1" Cursor="{Binding Pointer}"
                                            Tag="{Binding}" MouseLeftButtonUp="Flip">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Checked}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brand100}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brand700}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="152" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="2" Margin="-12,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource Accent}"
                                                       Visibility="{Binding Checked, Converter={StaticResource Shown}}" />
                                            <CheckBox Grid.Column="0" Style="{StaticResource Box}" Margin="-4,0,0,0" IsChecked="{Binding Checked, Mode=OneWay}"
                                                      IsEnabled="{Binding Free}" Tag="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=勾選{0}}"
                                                      Checked="Tick" Unchecked="Tick" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Cut}" Margin="0,0,8,0" ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Address}" Style="{StaticResource MonoCut}" Margin="0,0,8,0" ToolTip="{Binding Address}" />
                                            <TextBox Grid.Column="3" Style="{StaticResource PathBox}" Margin="-5,0,8,0" Text="{Binding Path, Mode=OneWay}" Tag="{Binding}"
                                                     IsEnabled="{Binding Editable}" ToolTip="{Binding PathTitle}" AutomationProperties.Name="遠端路徑"
                                                     PreviewKeyDown="PathKey" LostKeyboardFocus="PathLeave" />
                                            <Grid Grid.Column="4" Grid.ColumnSpan="2" Visibility="{Binding Sending, Converter={StaticResource Shown}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource HairLine}" VerticalAlignment="Center">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="{Binding Bar}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Progress}" Style="{StaticResource MonoCut}" Margin="8,0,0,0" ToolTip="{Binding Progress}" />
                                            </Grid>
                                            <TextBlock Grid.Column="4" Text="{Binding Diff}" Style="{StaticResource Cut}" Margin="0,0,8,0" TextAlignment="Right" ToolTip="{Binding DiffTitle}"
                                                       Visibility="{Binding Idle, Converter={StaticResource Shown}}" />
                                            <!-- 上次回應：毫秒靠右、跟著這一列的字色；沒成功的原因靠左，失敗紅、取消灰 -->
                                            <TextBlock Grid.Column="5" Text="{Binding Reply}" ToolTip="{Binding ReplyTitle}" Visibility="{Binding Idle, Converter={StaticResource Shown}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cut}">
                                                        <Setter Property="TextAlignment" Value="Right" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                <Setter Property="TextAlignment" Value="Left" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Failed}" Value="True" />
                                                                    <Condition Binding="{Binding Cancelled}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="AddOpen" Style="{StaticResource Strip}" Click="OpenAdd">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{StaticResource IconPlus}" ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                                <TextBlock Text="新增機台" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 新增機台：Enter 加入、Esc 收起；IP 與 Port 都要填，不替使用者帶值 -->
                        <StackPanel x:Name="AddPanel" Visibility="Collapsed" PreviewKeyDown="AddKey">
                            <Border Height="32" Padding="32,0,12,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Glyph}" Width="28" Height="28" Margin="4,0,0,0" ToolTip="不新增了" Click="CloseAdd">
                                        <ContentControl Content="{StaticResource IconX}" ContentTemplate="{StaticResource LucideIcon}" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="24" Content="加入" VerticalAlignment="Center" Click="AddMachine" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="名稱" Style="{StaticResource Label}" />
                                        <Border x:Name="NameFrame" Style="{StaticResource Field}" Width="112" Margin="8,0,0,0">
                                            <TextBox x:Name="NewName" Style="{StaticResource SearchBox}" MaxLength="50" AutomationProperties.Name="名稱" />
                                        </Border>
                                        <TextBlock Text="IP" Style="{StaticResource Label}" Margin="16,0,0,0" />
                                        <Border x:Name="IpFrame" Style="{StaticResource Field}" Width="128" Margin="8,0,0,0">
                                            <TextBox x:Name="NewIp" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" MaxLength="45" AutomationProperties.Name="IP" TextChanged="Unfault" />
                                        </Border>
                                        <TextBlock Text="Port" Style="{StaticResource Label}" Margin="16,0,0,0" />
                                        <Border x:Name="PortFrame" Style="{StaticResource Field}" Width="64" Margin="8,0,0,0">
                                            <Grid>
                                                <TextBox x:Name="NewPort" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Port" TextChanged="Unfault" />
                                                <TextBlock x:Name="PortHint" Text="5900" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="VNC 密碼" Style="{StaticResource Label}" Margin="16,0,0,0" />
                                        <Border Style="{StaticResource Field}" Width="112" Margin="8,0,0,0">
                                            <Grid>
                                                <PasswordBox x:Name="NewPw" Style="{StaticResource SearchSecret}" FontFamily="{StaticResource MonoFont}" Margin="0,0,20,0" AutomationProperties.Name="VNC 密碼" />
                                                <TextBox x:Name="NewPwShown" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" Margin="0,0,20,0" Visibility="Collapsed"
                                                         AutomationProperties.Name="VNC 密碼" />
                                                <Button x:Name="ShowPw" Style="{StaticResource Glyph}" Width="20" Height="20" Margin="0,0,-6,0" HorizontalAlignment="Right"
                                                        Focusable="False" ToolTip="顯示密碼" Click="FlipPw">
                                                    <ContentControl x:Name="PwIcon" Content="{StaticResource IconEye}" ContentTemplate="{StaticResource LucideIcon14}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="AddFault" Padding="32,4,12,4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1"
                                    TextElement.Foreground="{DynamicResource Danger}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Content="{StaticResource IconAlert}" ContentTemplate="{StaticResource LucideIcon14}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AddFaultText" Margin="8,0,0,0" LineHeight="{DynamicResource TextLine}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 第一次使用：一台都沒有 -->
                        <StackPanel x:Name="First" MaxWidth="440" Margin="0,48,0,32" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource WindowBack}" HorizontalAlignment="Center">
                                <ContentControl Content="{StaticResource IconMonitor}" ContentTemplate="{StaticResource LucideIcon24}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="把建置好的檔案送到機台" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <TextBlock Text="選一個資料夾或幾個檔，勾要送的機台，透過各台 UltraVNC 的檔案傳輸一次送過去；改完程式再送一次。"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="{DynamicResource TextLine}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource Primary}" Height="24" Content="新增機台" Click="OpenAdd" />
                                <Button Style="{StaticResource Plain}" Height="24" Margin="8,0,0,0" Content="選擇來源資料夾…" Click="PickFolder" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 最近送出與測試 -->
                <Border x:Name="LogHead" Grid.Row="3" Padding="12,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="最近送出與測試" FontWeight="SemiBold" />
                        <TextBlock Text="新的在上" Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="4" Margin="12,0" TextElement.Foreground="{DynamicResource TextMuted}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="時間 ↓" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="機台" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="動作" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="內容" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="耗時" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="錯誤" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="5">
                    <ListBox x:Name="Log" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource LineRow}" Tag="12,0" BorderThickness="0,1,0,0"
                             VirtualizingPanel.IsVirtualizing="True" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding At}" Style="{StaticResource MonoCut}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Machine}" Style="{StaticResource Cut}" Margin="0,0,8,0" ToolTip="{Binding Machine}" />
                                    <!-- 動作：照 event_type 寫 -->
                                    <TextBlock Grid.Column="2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cut}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EventType}" Value="send">
                                                        <Setter Property="Text" Value="送出" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EventType}" Value="test">
                                                        <Setter Property="Text" Value="測試連線" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 內容：送出寫 N 個檔 · X KB → 路徑；測試寫 IP:Port -->
                                    <TextBlock Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cut}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EventType}" Value="send">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.ToolTip>
                                            <TextBlock><Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" 個檔 · " /><Run Text="{Binding KbText, Mode=OneWay}" /><Run Text=" KB → " /><Run Text="{Binding RemotePath, Mode=OneWay}" /></TextBlock>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" 個檔 · " /><Run Text="{Binding KbText, Mode=OneWay}" /><Run Text=" KB → " /><Run Text="{Binding RemotePath, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding Address}" Margin="0,0,8,0" ToolTip="{Binding Address}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoCut}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EventType}" Value="test">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{Binding Took}" Style="{StaticResource MonoCut}" TextAlignment="Right" Margin="0,0,8,0" />
                                    <!-- 錯誤：沒有淡灰 —；取消灰；失敗（note 有值、不是取消）紅 -->
                                    <TextBlock Grid.Column="5" Text="{Binding Note}" ToolTip="{Binding Note}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cut}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Noted}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Error}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="NoLog" Padding="12,4" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="還沒有送出或測試過" Foreground="{DynamicResource TextMuted}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 右：來源 -->
        <Grid Grid.Column="1" Background="{DynamicResource Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button x:Name="FolderButton" DockPanel.Dock="Right" Style="{StaticResource Plain}" Height="24" Margin="8,0,0,0" VerticalAlignment="Center" Click="PickFolder">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{StaticResource IconFolder}" ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                            <TextBlock Text="選擇資料夾…" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FilesButton" DockPanel.Dock="Right" Style="{StaticResource Plain}" Height="24" VerticalAlignment="Center" Click="PickFiles">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{StaticResource IconFiles}" ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                            <TextBlock Text="選擇檔案…" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="來源" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,12" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="位置" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Where" Style="{StaticResource MonoCut}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Grid.Row="1" Text="檔案" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FileSummary" Style="{StaticResource MonoCut}" />
                    <TextBlock Grid.Row="2" Text="本機修改時間" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LocalTime" Style="{StaticResource MonoCut}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                <Grid TextElement.Foreground="{DynamicResource TextMuted}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="檔名" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="大小" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="修改時間 ↓" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <ListBox x:Name="FileList" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource LineRow}" Tag="16,0" BorderThickness="0,0,0,1"
                         VirtualizingPanel.IsVirtualizing="True" Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Cut}" Margin="0,0,8,0" ToolTip="{Binding Full}" />
                                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource MonoCut}" TextAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource MonoCut}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoFiles" Text="還沒選來源。選資料夾會送整個資料夾（含子資料夾），選檔案只送挑的那幾個。" Foreground="{DynamicResource TextMuted}"
                           Margin="16,12" TextWrapping="Wrap" LineHeight="{DynamicResource TextLine}" VerticalAlignment="Top" />
            </Grid>

            <!-- 送出：平常是說明與主要按鈕；送的時候是整體進度與取消 -->
            <Border Grid.Row="4" Padding="16,12,16,16" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel x:Name="IdlePanel">
                        <TextBlock x:Name="SendNote" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button x:Name="SendButton" Style="{StaticResource Primary}" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Send">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{StaticResource IconSend}" ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"><Run Text="送到勾選的 " /><Run x:Name="SendCount" FontFamily="{StaticResource MonoFont}" /><Run Text=" 台" /></TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="BusyPanel" Visibility="Collapsed">
                        <TextBlock x:Name="Overall" Style="{StaticResource MonoCut}" Margin="0,0,0,8" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button Style="{StaticResource Plain}" FontWeight="SemiBold" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Cancel">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{StaticResource IconX}" ContentTemplate="{StaticResource LucideIcon16}" VerticalAlignment="Center" />
                                <TextBlock Text="取消" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 通知：右下角、最多三則；資訊 4 秒自己收起（滑鼠停在上面先不收），錯誤留到按關閉 -->
        <ItemsControl x:Name="Notes" Grid.ColumnSpan="2" Width="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,112" Panel.ZIndex="2" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,8,0,0" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Tag="{Binding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.16" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="7,0,0,7" Background="{Binding Ink}" />
                            <ContentControl Grid.Column="1" Margin="12,0,0,0" Content="{Binding Icon}" ContentTemplate="{StaticResource LucideIcon16}" Foreground="{Binding Ink}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Text}" Margin="12" TextWrapping="Wrap" LineHeight="{DynamicResource TextLine}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Style="{StaticResource Glyph}" Width="32" Height="32" VerticalAlignment="Center" ToolTip="關閉" Tag="{Binding}" Click="DropNote">
                                <ContentControl Content="{StaticResource IconX}" ContentTemplate="{StaticResource LucideIcon}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
