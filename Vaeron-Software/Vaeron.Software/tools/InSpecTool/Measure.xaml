<UserControl x:Class="InSpecTool.Measure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextPrimary}"
             Loaded="Ready" Unloaded="Gone" SizeChanged="Fit">

    <UserControl.Resources>
        <!-- 標籤在左、同一列：12px 次要字色 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Text}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 中間的分隔：看起來 1px，抓得到 12px -->
        <Style x:Key="Divider" TargetType="GridSplitter">
            <Setter Property="Width" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="line" Width="1" Background="{DynamicResource HairLine}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="line" Property="Width" Value="2" />
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="line" Property="Width" Value="2" />
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 量測程式的一列：雙擊就執行；選中的有底色、字加粗 -->
        <Style x:Key="ProgramRow" TargetType="ListBoxItem">
            <EventSetter Event="MouseDoubleClick" Handler="Run" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" BorderBrush="{DynamicResource HairLine}"
                                BorderThickness="0,0,0,1" Padding="16,0" Height="32">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBack}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Brand100}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand700}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 左右兩欄並排、各自捲（兄弟，不是一層包一層）；中間的分隔可以左右拖 -->
    <Grid>
    <Grid x:Name="Columns">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="380" MinWidth="280" />
            <ColumnDefinition Width="12" />
            <!-- 右欄最小 630：最近執行一列放得下 時間 88、量測程式 120、五個欄位各 56、秒 40、歸檔 40、左右留白與捲軸 62 -->
            <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="630" />
        </Grid.ColumnDefinitions>

        <!-- 左：條碼與欄位，欄位多寡由欄位結構決定；這一欄自己捲，最下面是跑完顯示結果 -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Inputs" Margin="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="條碼" Style="{StaticResource Label}" />
                            <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Height="{DynamicResource ControlHeight}">
                                <TextBox x:Name="Barcode" Style="{StaticResource SearchBox}" FontFamily="{DynamicResource MonoFont}"
                                         FontSize="{DynamicResource Text}" TextChanged="Typed" />
                            </Border>
                            <Button Grid.Column="2" Content="清除" Style="{StaticResource FillButton}" FontWeight="Normal"
                                    FontSize="{DynamicResource Text}" Padding="8,0" Margin="8,0,0,0" Click="Clear" />
                        </Grid>
                        <TextBlock x:Name="BarcodeFault" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource Text}" Margin="64,4,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" Text="條碼格式不正確，包含不允許的字元。" />

                        <Border Height="1" Background="{DynamicResource HairLine}" Margin="0,12,0,4" />

                        <ItemsControl x:Name="Fields" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Label}" />
                                        <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Height="{DynamicResource ControlHeight}"
                                                ToolTip="{Binding Hint}">
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding Fixed}"
                                                     Style="{StaticResource SearchBox}" FontSize="{DynamicResource Text}" LostFocus="Edited" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <CheckBox x:Name="ShowAfter" Grid.Row="1" Content="跑完顯示結果" Margin="16,8,16,12" FontSize="{DynamicResource Text}"
                          Style="{StaticResource SettingCheck}" Click="ShowNextChanged" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource Divider}" DragCompleted="Resized" />

        <!-- 右：量測程式佔大的 618，最近執行佔小的 382；兩塊各自捲 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="618*" />
                <RowDefinition Height="56" />
                <RowDefinition Height="28" />
                <RowDefinition Height="382*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="量測程式" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="ProgramCount" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource Text}"
                               Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="AgainButton" Content="重新查找" Style="{StaticResource FillButton}" FontWeight="Normal"
                            FontSize="{DynamicResource Text}" Click="Again" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ListBox x:Name="Programs" BorderThickness="0" Background="Transparent" Padding="0"
                         ItemContainerStyle="{StaticResource ProgramRow}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyDown="ProgramKey">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Path}" />
                                <TextBlock Grid.Column="1" Text="{Binding Changed}" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="{DynamicResource Text}" FontWeight="Normal" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="ProgramsEmpty" Height="32" Padding="16,0" VerticalAlignment="Top">
                    <TextBlock x:Name="ProgramsEmptyText" Text="查無結果" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- 最近執行：一次一列，新的在上；欄位照欄位結構 -->
            <Border Grid.Row="2" Margin="0,16,0,0" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="最近執行" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="新的在上" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 表頭右邊多留一條捲軸寬（14），跟下面每一列的欄對齊 -->
            <Grid Grid.Row="3" Margin="16,0,30,0" TextElement.FontSize="{DynamicResource Text}" TextElement.Foreground="{DynamicResource TextMuted}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="時間" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="量測程式" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="2" x:Name="RecentHeads" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="3" Text="秒" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="歸檔" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ListBox Grid.Row="4" x:Name="Recent" BorderThickness="0" Background="Transparent" Padding="0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Height="28" Padding="16,0" BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid TextElement.FontSize="{DynamicResource Text}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding run_text}" FontFamily="{DynamicResource MonoFont}" />
                            <TextBlock Grid.Column="1" Text="{Binding program_name}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding program_name}" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding field_values}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="3" Text="{Binding seconds_text, TargetNullValue=—}" FontFamily="{DynamicResource MonoFont}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" TextAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="—" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding archived}" Value="True">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>

    <!-- 跑完：這次的結果蓋在整頁上，看完按關閉（Esc 也可以） -->
    <Grid x:Name="ResultLayer" Background="#66000000" Visibility="Collapsed" PreviewKeyDown="ResultKeys">
        <Border x:Name="ResultPanel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                Background="{DynamicResource Surface}" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity=".18" />
            </Border.Effect>
            <StackPanel>
                <Grid MinHeight="36" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="ResultMark" Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                          Data="M20 6 9 17l-5-5" Stroke="#107c10" StrokeThickness="2.5" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Grid.Column="1" x:Name="ResultTitle" FontSize="{DynamicResource Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" x:Name="ResultElapsed" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource Text}"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl x:Name="ResultRows" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{DynamicResource Text}"
                                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{DynamicResource MonoFont}"
                                               FontSize="{DynamicResource Text}" TextWrapping="Wrap" Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ShowNext" Grid.Column="0" Content="下次跑完也顯示結果"
                                  Style="{StaticResource SettingCheck}" Click="ShowNextChanged" />
                        <Button Grid.Column="1" x:Name="CloseButton" Content="關閉" Style="{StaticResource FillButton}" Height="{DynamicResource ControlHeight}" FontSize="{DynamicResource Text}" Padding="16,0"
                                Click="CloseResult" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
