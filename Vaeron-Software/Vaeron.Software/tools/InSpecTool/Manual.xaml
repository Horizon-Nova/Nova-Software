<Window x:Class="InSpecTool.Manual"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="656" ShowInTaskbar="True" Topmost="True" Title="InSpec 寫入了一筆結果"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource Body}" Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="Keys">

    <!-- 平平的對話框：圓角 4、細框、淡陰影 -->
    <Border Margin="8" Background="{DynamicResource Surface}" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4"
            MouseLeftButtonDown="Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity=".18" />
        </Border.Effect>
        <StackPanel Margin="20,12,12,20">
            <!-- 標題：什麼時候寫入、InSpec 開著哪一支 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="InSpec 寫入了一筆結果" FontSize="{DynamicResource Heading}" FontWeight="SemiBold" />
                    <TextBlock x:Name="Origin" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource Caption}"
                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="32" Style="{StaticResource FillButton}" Background="Transparent"
                        BorderBrush="Transparent" Padding="0" ToolTip="關閉" Click="Shut" VerticalAlignment="Top">
                    <Path Data="M18 6 6 18 M6 6l12 12" Stroke="{DynamicResource TextMuted}" StrokeThickness="2" Width="12" Height="12"
                          Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- 路徑、料號、歸檔：同一列；路徑是要存的那個檔，照料號與分析出來的其他值帶好，要改直接改 -->
            <Grid Margin="0,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="618*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="382*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="路徑" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Height="32" CornerRadius="2">
                    <TextBox x:Name="Where" Style="{StaticResource SearchBox}" FontFamily="{DynamicResource MonoFont}"
                             FontSize="{DynamicResource Caption}" TextChanged="WhereTyped" />
                </Border>
                <Button Grid.Column="2" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Style="{StaticResource FillButton}"
                        ToolTip="選擇路徑" Click="Browse">
                    <Path Data="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"
                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <TextBlock Grid.Column="3" Text="料號" FontSize="{DynamicResource Caption}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="12,0,12,0" />
                <Border Grid.Column="4" Style="{StaticResource SearchFrame}" Height="32" CornerRadius="2">
                    <TextBox x:Name="Part" Style="{StaticResource SearchBox}" TextChanged="PartTyped" />
                </Border>
                <Button Grid.Column="5" x:Name="ExportButton" Width="32" Height="32" Margin="12,0,0,0" Padding="0"
                        Style="{StaticResource FillButton}" Background="{DynamicResource Accent}" BorderBrush="Transparent"
                        ToolTip="歸檔到路徑" Click="Export">
                    <Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12" Stroke="{DynamicResource OnAccent}"
                          StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </Grid>
            <TextBlock x:Name="Fault" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource Caption}" TextWrapping="Wrap"
                       Margin="0,4,8,0" Visibility="Collapsed" />

            <!-- InSpec 寫的內容：複製在右上角 -->
            <Grid Margin="0,12,8,0">
                <Border BorderBrush="#24000000" BorderThickness="1" CornerRadius="2">
                    <TextBox x:Name="Body" IsReadOnly="True" Height="240" BorderThickness="0" Padding="8,8,44,8"
                             FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource Caption}" Background="Transparent"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Border>
                <Button x:Name="CopyButton" Width="32" Height="32" Margin="0,4,4,0" Padding="0" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Style="{StaticResource FillButton}" BorderBrush="Transparent" ToolTip="複製"
                        Click="Copy">
                    <Path x:Name="CopyMark" Data="M8 8h13v13H8z M4 16V4a1 1 0 0 1 1-1h11" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
