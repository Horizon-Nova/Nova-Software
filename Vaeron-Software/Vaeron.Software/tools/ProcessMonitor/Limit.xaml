<Window x:Class="ProcessMonitor.Limit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Text}" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary Source="/ProcessMonitor;component/Styles.xaml" />
    </Window.Resources>

    <!-- 遮罩蓋住整個主視窗，對話框在正中間 -->
    <Grid Background="{DynamicResource Scrim}">
        <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <TextBlock FontSize="{DynamicResource Title}" VerticalAlignment="Center">
                        <Run Text="限制 " /><Run Text="{Binding Name, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource Glyph}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel" IsCancel="True">
                        <ContentControl Content="{StaticResource IconX}" ContentTemplate="{StaticResource LucideIcon}" Foreground="{DynamicResource TextMuted}" />
                    </Button>
                </Grid>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextMuted}" Text="空著的不限；套用後一直有效，清空再套用就解除" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="上傳" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Row="1" Text="網路" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Row="2" Text="CPU" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Row="3" Text="記憶體" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SearchFrame}">
                        <Grid>
                            <TextBox x:Name="Up" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" Text="{Binding Up, Mode=OneTime}" />
                            <TextBlock Text="不限" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=Up, Converter={StaticResource Shown}}" />
                        </Grid>
                    </Border>
                    <CheckBox x:Name="Block" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Box}" Margin="-8,0,0,0" Content="不准連網路" IsChecked="{Binding Block, Mode=OneTime}" />
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SearchFrame}">
                        <Grid>
                            <TextBox x:Name="Cpu" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" Text="{Binding Cpu, Mode=OneTime}" />
                            <TextBlock Text="不限" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=Cpu, Converter={StaticResource Shown}}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SearchFrame}">
                        <Grid>
                            <TextBox x:Name="Mem" Style="{StaticResource SearchBox}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" Text="{Binding Mem, Mode=OneTime}" />
                            <TextBlock Text="不限" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=Mem, Converter={StaticResource Shown}}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="MB/s" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="%" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="MB" Margin="8,0,0,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextMuted}">
                        <TextBlock Text="現在 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding UpNow}" />
                        <TextBlock Text=" · 近 10 分鐘最高 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding UpPeak}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextMuted}">
                        <TextBlock Text="現在 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Links}" />
                        <TextBlock Text=" 條連線" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextMuted}">
                        <TextBlock Text="現在 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding CpuNow}" />
                        <TextBlock Text=" · 近 10 分鐘最高 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding CpuPeak}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextMuted}">
                        <TextBlock Text="現在 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding MemNow}" />
                        <TextBlock Text=" · 近 10 分鐘最高 " />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding MemPeak}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Text="記憶體上限比現在用的少時，程式要更多記憶體會被拒絕，多半會直接結束" />

                <TextBlock x:Name="Fault" Margin="0,8,0,0" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="Collapsed" />

                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Plain}" Content="取消" Click="Cancel" />
                    <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Content="套用" Click="Apply" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
