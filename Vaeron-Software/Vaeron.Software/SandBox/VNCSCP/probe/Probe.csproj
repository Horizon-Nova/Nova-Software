<Project Sdk="Microsoft.NET.Sdk">

  <!-- 用反射驅動 VNCSCP 既有的 RfbFileTransferClient，對真的 UltraVNC 伺服器實測傳檔與傳資料夾；只在 SandBox，非產品 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VncscpProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接引用 VNCSCP 建好的組件；Private=true 複製到 probe 輸出，反射時從同一處載入 -->
    <Reference Include="Vaeron.Kernel">
      <HintPath>..\..\..\..\VNCSCP\VNCSCP\Vaeron.VNCSCP.RemoteDeployment\bin\Release\net10.0-windows\Vaeron.Kernel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Vaeron.VNCSCP.Internal.Rfb">
      <HintPath>..\..\..\..\VNCSCP\VNCSCP\Vaeron.VNCSCP.RemoteDeployment\bin\Release\net10.0-windows\Vaeron.VNCSCP.Internal.Rfb.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Vaeron.VNCSCP.RemoteDeployment">
      <HintPath>..\..\..\..\VNCSCP\VNCSCP\Vaeron.VNCSCP.RemoteDeployment\bin\Release\net10.0-windows\Vaeron.VNCSCP.RemoteDeployment.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
