<Window x:Class="InSpecHookDLLHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaeron InSpec — 無畫面量測控制台" Height="760" Width="1180">
    <Window.Resources>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#33888888" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <!-- 外層 ScrollViewer：展開底部 Expander 時整體捲動,不擠壓上方三欄主區 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 狀態列（常駐,FR-1） -->
        <Border Grid.Row="0" Style="{StaticResource StepCard}" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ScanButton" Content="掃描已開啟的 InSpec" MinWidth="150" Click="ScanButton_Click" />
                    <Button x:Name="LaunchHiddenButton" Content="無畫面啟動 InSpec" MinWidth="140" Margin="8,0,0,0"
                            Click="LaunchHiddenButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="InSpec：尚未連線" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- 主流程：橫向三欄 ①選程式 | ②執行 | ③結果（FR-2/3/4/5） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- ① 選程式 -->
            <Border Grid.Column="0" Style="{StaticResource StepCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="① 選程式" Style="{StaticResource StepTitle}" />
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="瀏覽…" MinWidth="64" DockPanel.Dock="Right" Click="BrowseButton_Click" />
                        <TextBox x:Name="SearchDirTextBox" Margin="0,0,8,0" />
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button x:Name="SearchButton" Content="查詢" MinWidth="64" DockPanel.Dock="Right" Click="SearchButton_Click" />
                        <TextBox x:Name="SearchTermTextBox" Margin="0,0,8,0" />
                    </DockPanel>
                    <ListBox x:Name="SearchResultsListBox" Grid.Row="3" Height="320" />
                </Grid>
            </Border>

            <!-- ② 執行 -->
            <Border Grid.Column="1" Style="{StaticResource StepCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="② 執行" Style="{StaticResource StepTitle}" />
                    <TextBlock Grid.Row="1" Text="提示值（程式含提示時填入）" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox x:Name="PromptValueTextBox" Grid.Row="2" Margin="0,0,0,12" />
                    <Button x:Name="RunHeadlessButton" Grid.Row="3" Content="開始量測（無畫面）" Height="40"
                            FontSize="14" FontWeight="SemiBold" Click="RunHeadlessButton_Click" />
                    <TextBlock x:Name="HeadlessNotice" Grid.Row="4" Text="" TextWrapping="Wrap" Opacity="0.8"
                               Margin="0,12,0,0" VerticalAlignment="Top" />

                    <!-- InSpec 摘要面板前端改造：改的是 InSpec 自己顯示的畫面本身，不是我方軟體
                         另開一個控制台去代管 InSpec 的 UI；摘要面板本身不可編輯，這裡只換完成
                         小圖示的樣式/顏色。可編輯的數值目標是 X/Y/Z 座標（見下方進階區）。 -->
                    <Border Grid.Row="5" BorderBrush="#33888888" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="InSpec 摘要面板前端改造" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <CheckBox x:Name="OverlayEnableCheckBox" Content="啟用（完成圖示樣式）"
                                      Checked="OverlayEnableCheckBox_Checked" Unchecked="OverlayEnableCheckBox_Unchecked" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="完成圖示樣式" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                <ComboBox x:Name="OverlaySymbolCombo" SelectedIndex="0" SelectionChanged="OverlaySymbolCombo_SelectionChanged">
                                    <ComboBoxItem Content="打勾（成功）" />
                                    <ComboBoxItem Content="叉叉（失敗）" />
                                    <ComboBoxItem Content="自訂文字" />
                                </ComboBox>
                            </DockPanel>
                            <TextBox x:Name="OverlayCustomTextBox" Text="PASS" Margin="0,0,0,8"
                                     Visibility="Collapsed" TextChanged="OverlayCustomTextBox_TextChanged" />
                            <TextBlock Text="圖示顏色" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="綠" Width="40" Margin="0,0,4,0" Click="ColorGreen_Click" />
                                <Button Content="紅" Width="40" Margin="0,0,4,0" Click="ColorRed_Click" />
                                <Button Content="黃" Width="40" Margin="0,0,4,0" Click="ColorYellow_Click" />
                                <Button Content="藍" Width="40" Click="ColorBlue_Click" />
                            </StackPanel>
                            <TextBlock x:Name="OverlayNotice" Text="" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ③ 結果 -->
            <Border Grid.Column="2" Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="③ 結果（AutoExport 匯出檔）" Style="{StaticResource StepTitle}" />
                    <DataGrid x:Name="ResultsDataGrid" Grid.Row="1" Height="320" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="欄 1" Binding="{Binding C1}" Width="*" />
                            <DataGridTextColumn Header="欄 2" Binding="{Binding C2}" Width="*" />
                            <DataGridTextColumn Header="欄 3" Binding="{Binding C3}" Width="*" />
                            <DataGridTextColumn Header="欄 4" Binding="{Binding C4}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ResultsNotice" Grid.Row="2"
                               Text="欄位語意（元素/值/公差/判定）待非空匯出檔驗證後定版,目前為 Tab 分欄原樣。"
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底列：進階 | Log 左右並排 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" Header="進階 / 展示能力" Margin="0,0,6,0">
                <Border Style="{StaticResource StepCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="HideWindowCheckBox" Content="隱藏 InSpec 視窗"
                                  Checked="HideWindowCheckBox_Checked" Unchecked="HideWindowCheckBox_Unchecked" Margin="0,0,0,8" />
                        <CheckBox x:Name="LiveEditButtonCheckBox" Content="在 InSpec 工具列注入我方按鈕（展示：改前端）"
                                  Checked="LiveEditButtonCheckBox_Checked" Unchecked="LiveEditButtonCheckBox_Unchecked" Margin="0,0,0,8" />
                        <CheckBox x:Name="XyzEditCheckBox" Content="X/Y/Z 座標就地編輯（InSpec 真實 Static 控制項）"
                                  Checked="XyzEditCheckBox_Checked" Unchecked="XyzEditCheckBox_Unchecked" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="立即觸發重新載入" MinWidth="140" DockPanel.Dock="Left" Click="TriggerReloadButton_Click" />
                            <CheckBox x:Name="ReloadButtonCheckBox" Content="在 InSpec 工具列常駐注入重新載入按鈕" Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="ReloadButtonCheckBox_Checked" Unchecked="ReloadButtonCheckBox_Unchecked" />
                        </DockPanel>
                        <CheckBox x:Name="LiveReadCheckBox" Content="即時讀畫面（GDI,需視窗可見；與隱藏互斥）"
                                  Checked="LiveReadCheckBox_Checked" Unchecked="LiveReadCheckBox_Unchecked" Margin="0,0,0,8" />
                        <TextBlock x:Name="LiveSummaryText" Text="即時摘要：（未啟用）" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="legacy 手動驅動（非正式路徑,與 iscmd 互斥）" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExecuteButton" Content="工具列觸發執行" MinWidth="120" Click="ExecuteButton_Click" />
                            <Button x:Name="OpenInInSpecButton" Content="在 InSpec 開啟選取檔" MinWidth="140" Margin="8,0,0,0"
                                    Click="OpenInInSpecButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Grid.Column="1" Header="運作記錄 Log" Margin="6,0,0,0">
                <Border Style="{StaticResource StepCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="開啟 log 檔" MinWidth="90" DockPanel.Dock="Right" Click="OpenLogButton_Click" />
                            <TextBlock x:Name="LogPathText" Text="" VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                        </DockPanel>
                        <TextBox x:Name="LogTextBox" Height="150" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
