<UserControl x:Class="ChecksumTool.Board"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft JhengHei UI" FontSize="13" Foreground="#1b1b1b"
             AllowDrop="True" Drop="Dropped" DragOver="DraggedOver">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="檔案校驗碼" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="算出一個檔案的 SHA-256，跟對方給的值比對，確認傳過來的檔案沒有被改過。"
                       FontSize="12" LineHeight="21" Foreground="#5c5c5c" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 把檔案拖進來，或按一下選檔 -->
        <Border Grid.Row="1" x:Name="Zone" Height="120" CornerRadius="8" Background="#fafafa"
                BorderBrush="#24000000" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pick">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ZoneTitle" Text="把檔案拖進來，或按一下選檔"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="一次一個檔案；檔案只在這台電腦上讀取，不會送到任何地方"
                           FontSize="12" Foreground="#5c5c5c" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 算出來的每一項 -->
        <ItemsControl Grid.Row="2" x:Name="Lines" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Background="White" BorderBrush="#18000000" BorderThickness="1"
                            Padding="16" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Size}" FontSize="12" Foreground="#5c5c5c" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Hash}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="複製" Padding="16,0" Height="32" Margin="16,0,0,0"
                                    VerticalAlignment="Top" Click="Copy" Tag="{Binding Hash}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
