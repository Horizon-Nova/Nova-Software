<?xml version="1.0" encoding="utf-8"?>
<Obfuscator>
  <!-- 只混淆主程式，Contract 與外掛工具不動；InPath、OutPath、AssemblySearchPath 由 dev\Release 依每一版填入 -->
  <Var name="InPath" value="" />
  <Var name="OutPath" value="" />
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="ReuseNames" value="true" />

  <!-- 自帶 .NET 的發佈資料夾裡有每一個相依組件，混淆器從那裡解析 -->
  <AssemblySearchPath path="" />

  <Module file="$(InPath)\HelixStudio.dll">
    <!-- XAML／BAML 綁定與 code-behind：整個 Views 命名空間保留名稱 -->
    <SkipNamespace name="HelixStudio.Views" />
    <!-- 一支功能一支方法的類別，方法名保留讓邏輯可讀；型別本身仍改名 -->
    <SkipType name="HelixStudio.App" />

    <!-- EF 從資料庫產生的模型：屬性名對應欄位，不能改 -->
    <SkipNamespace name="Models.HelixStudio" />

    <!-- 綁定用的 Item／View（RailItem、CardItem、RunItem、LicenceView…）：型別可改，屬性欄位保留 -->
    <SkipType name="*Item" rx="(Item|View)$" skipProperties="true" skipFields="true" skipEvents="true" />

    <!-- 匿名型別：申請碼 JSON 與 HostPanel 的 DataContext 綁定，屬性名不能改 -->
    <SkipType name="*AnonymousType*" skipProperties="true" skipFields="true" />
  </Module>
</Obfuscator>
