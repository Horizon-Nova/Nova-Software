@model TopicLogic.ItemForm
@{
    ViewData["Title"] = "項目";
}

@section Styles {
    @await Html.PartialAsync("Partials/Items/_Styles")
}

@* 這一頁只有外框：要填的那一份表單、查詢的那一格、列表要放的地方。
   列表本身是動態資料，這裡是空的，由 _Scripts 的 Search() 用 POST 取回 Partials/Items/_List 塞進 #itemResults。
   防偽權杖在 _FormData 那一份表單裡，頁面一打開就在，每一支 ajax 都從那裡取。 *@
<div class="container py-4 d-flex flex-column gap-4">
    @await Html.PartialAsync("Partials/Items/_FormData", Model)

    <section class="card" aria-labelledby="itemListTitle">
        <div class="card-body d-flex flex-column gap-3">
            <h2 id="itemListTitle" class="fs-6 fw-semibold mb-0">我的項目</h2>

            <div class="d-flex align-items-end gap-2">
                <div class="flex-grow-1">
                    <label class="form-label" for="itemKeyword">找項目</label>
                    <input type="search" class="form-control" id="itemKeyword" placeholder="以代碼或名稱搜尋" />
                </div>
                <button type="button" class="btn look-quiet d-inline-flex align-items-center gap-1" id="itemSearch" data-busy="false" onclick="Search(this)">
                    <i data-lucide="search" class="icon-idle" aria-hidden="true"></i><i data-lucide="loader-circle" class="icon-busy" aria-hidden="true"></i>查詢
                </button>
            </div>

            <div id="itemResults"></div>
        </div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("Partials/Items/_Scripts")
}
