@model List<TopicLogic.ItemRow>
@{
    Layout = null;
}

@* 這一支是動態資料本身：畫面打開時是空的，由 _Scripts 的 Search() 用 POST 取回這一段標記，
   塞進 #itemResults 再把圖示畫一次。所以它只有列，沒有頁面的外框，也沒有 Layout。
   先後、排第幾、離期限幾小時、期限的字都是 vw_item 算好的，這裡只攤成列；文字靠左、數字靠右用等寬字。
   每一列上的動作把「是哪一筆」與「按的是哪一顆」一起交給函式：onclick="Remove('@@one.code', this)"。 *@
<table class="table align-middle mb-0">
    <thead>
        <tr>
            <th scope="col" class="text-end">排第幾</th>
            <th scope="col">代碼</th>
            <th scope="col">名稱</th>
            <th scope="col">分類</th>
            <th scope="col">期限</th>
            <th scope="col" class="text-end">離期限還有幾小時</th>
            <th scope="col"><span class="visually-hidden">動作</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var one in Model)
        {
            <tr>
                <td class="text-end font-monospace">@one.rank</td>
                <td class="font-monospace">@one.code</td>
                <td>@one.name</td>
                <td>@one.kind_name</td>
                <td class="font-monospace">@one.due_text</td>
                <td class="text-end font-monospace">@one.remaining_hours.ToString("0.0")</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm look-plain look-danger" data-busy="false" data-bs-toggle="tooltip" title="移掉 @one.name" aria-label="移掉 @one.name" onclick="Remove('@one.code', this)">
                        <i data-lucide="trash-2" class="icon-idle" aria-hidden="true"></i><i data-lucide="loader-circle" class="icon-busy" aria-hidden="true"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* 一筆都沒有時的那一行；顯不顯示由 _Styles 照 data-count 決定。 *@
<p class="item-empty text-body-secondary mb-0" data-count="@Model.Count">還沒有項目，填上面那一份存下第一筆。</p>
