@{
    Layout = null;
}

@* 這一頁的行為，也是這個站台每一種 ajax 的樣子。

   使用者在這一頁做得了幾個動作，這裡就有幾支函式，名字就是那個動作，標記上直接 onclick="動作(this)"。
   一支函式從頭寫到尾：把按的那一顆標成忙碌、送出去、照回來那一句提示、成功之後重畫，
   complete 把忙碌拿掉——還原靠請求結束，不靠計時。
   不寫分派器（一支函式收一個字串再決定自己是誰），不寫只被一支函式用到的小函式。

   只有打開頁面用 GET；這裡每一支都是 POST，差別只在 data 那幾行：
     表單（連同檔案）  data: new FormData(表單)，processData 與 contentType 都關掉；沒選檔案也走這一條
     幾個值            data: { code: code }
     一段畫面          data: { keyword: ... }，回來的是 HTML，塞進容器再把圖示畫一次
   每一支都帶防偽權杖，取自頁面一打開就在的那一份表單（#FormDataItem）；
   不取自 ajax 換進來的那一段，第一次查的時候它還不在。

   按鈕上兩顆圖示都寫在標記裡，哪一顆看得見由 data-busy 與 Layout.css 決定，JS 不組 HTML。 *@
<script>
    $(function () {
        // 開場：把標記上的圖示畫出來，然後查第一次——列表是動態資料，進來時容器是空的
        window.lucide?.createIcons?.();
        Search(document.getElementById('itemSearch'));
    });

    // 存這一份：表單與選好的檔案一起用 FormData 送，成功之後清空表單並重查列表
    function Submit(button) {
        $(button).prop('disabled', true).attr('data-busy', 'true');

        var form = document.getElementById('FormDataItem');
        var data = new FormData(form);
        Array.from(document.getElementById('itemFiles').files).forEach(file => data.append('files', file));

        $.ajax({
            url: '@Url.Action("Submit", "Topic")',
            type: 'POST',
            data: data,
            processData: false,
            contentType: false,
            headers: { 'RequestVerificationToken': $('#FormDataItem input[name="__RequestVerificationToken"]').val() },
            success: (answer) => {
                showToast(answer.message, answer.kind);
                [answer].filter(one => one.kind === 'success').forEach(() => {
                    form.reset();
                    Search(document.getElementById('itemSearch'));
                });
            },
            error: () => showToast('[失敗] 存不進去，請稍後再試', 'error'),
            complete: () => $(button).prop('disabled', false).attr('data-busy', 'false')
        });
    }

    // 移掉一個項目：哪一個由按的那一列給，按哪一顆就只鎖哪一顆；成功之後重查列表
    function Remove(code, button) {
        $(button).prop('disabled', true).attr('data-busy', 'true');

        $.ajax({
            url: '@Url.Action("Remove", "Topic")',
            type: 'POST',
            data: { code: code },
            headers: { 'RequestVerificationToken': $('#FormDataItem input[name="__RequestVerificationToken"]').val() },
            success: (answer) => {
                showToast(answer.message, answer.kind);
                [answer].filter(one => one.kind === 'success').forEach(() => Search(document.getElementById('itemSearch')));
            },
            error: () => showToast('[失敗] 移不掉，請稍後再試', 'error'),
            complete: () => $(button).prop('disabled', false).attr('data-busy', 'false')
        });
    }

    // 查一次：回來的是一段畫面，換掉容器裡的內容，新長出來的圖示要再畫一次；換掉之前先收掉還開著的提示框
    function Search(button) {
        $(button).prop('disabled', true).attr('data-busy', 'true');

        $.ajax({
            url: '@Url.Action("Rows", "Topic")',
            type: 'POST',
            data: { keyword: $('#itemKeyword').val() },
            headers: { 'RequestVerificationToken': $('#FormDataItem input[name="__RequestVerificationToken"]').val() },
            success: (html) => {
                $('.tooltip').remove();
                $('#itemResults').html(html);
                window.lucide?.createIcons?.();
            },
            error: () => showToast('[失敗] 列表沒有載入，請稍後再試', 'error'),
            complete: () => $(button).prop('disabled', false).attr('data-busy', 'false')
        });
    }
</script>
