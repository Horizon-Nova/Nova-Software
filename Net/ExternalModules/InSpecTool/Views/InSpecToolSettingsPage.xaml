<UserControl x:Class="ExternalModules.InSpecTool.Views.InSpecToolSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             PreviewMouseWheel="ApplyRootPreviewMouseWheel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InSpecTool;component/Themes/InSpecToolTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="InSpecTool 設定"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Margin="0,6,0,0"
                       Text="右側設定只負責暫時解鎖敏感欄位，不負責保存模組授權。解鎖 3 分鐘後會自動重新上鎖。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource TextTertiary}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,8,12,0"
                               Text="管理解鎖"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <PasswordBox x:Name="UnlockKeyBox"
                                 Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource InSpecBasePasswordFieldStyle}"
                                 PasswordChanged="ApplyUnlockKeyPasswordChanged"/>
                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            MinWidth="88"
                            Style="{StaticResource InSpecJavaButtonStyle}"
                            Content="解鎖"
                            Command="{Binding ApplyUnlockCommand}"/>
                </Grid>
                <TextBlock Margin="120,6,0,0"
                           FontSize="11"
                           Text="{Binding UnlockStatusText}"
                           Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Margin="120,4,0,0"
                           FontSize="11"
                           Text="{Binding LockStateText, StringFormat=欄位狀態：{0}}"
                           Foreground="{DynamicResource TextTertiary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.RowSpan="2"
                           Margin="0,8,12,0"
                           Text="自動化設定"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="條碼解析間隔"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding ScanIntervalOptions}"
                              SelectedItem="{Binding ScanIntervalMs, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="監控輪詢間隔"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding MonitorIntervalOptions}"
                              SelectedItem="{Binding MonitorIntervalMs, Mode=TwoWay}"/>
                </StackPanel>

                <CheckBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,12,0,0"
                          Content="啟用自動監控"
                          Foreground="{DynamicResource TextPrimary}"
                          IsChecked="{Binding EnableAutoMonitoring, Mode=TwoWay}"/>

                <CheckBox Grid.Row="1"
                          Grid.Column="3"
                          Margin="0,12,0,0"
                          Content="啟用自動開啟"
                          Foreground="{DynamicResource TextPrimary}"
                          IsChecked="{Binding EnableAutoRun, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.RowSpan="3"
                           Margin="0,8,12,0"
                           Text="路徑設定"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="搜尋資料夾"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchDirectoryTextBox"
                                 Style="{StaticResource InSpecBaseTextFieldStyle}"
                                 Text="{Binding SearchDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                MinWidth="64"
                                Style="{StaticResource InSpecJavaButtonStyle}"
                                Content="瀏覽"
                                Click="ApplySearchDirectoryBrowse"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="系統紀錄資料夾"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SystemLogDirectoryTextBox"
                                 Style="{StaticResource InSpecBaseTextFieldStyle}"
                                 Text="{Binding SystemLogDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                MinWidth="64"
                                Style="{StaticResource InSpecJavaButtonStyle}"
                                Content="瀏覽"
                                Click="ApplySystemLogDirectoryBrowse"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="備份輸出路徑"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupSavePathTextBox"
                                 Style="{StaticResource InSpecBaseTextFieldStyle}"
                                 Text="{Binding BackupSavePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                MinWidth="64"
                                Style="{StaticResource InSpecJavaButtonStyle}"
                                Content="瀏覽"
                                Click="ApplyBackupSavePathBrowse"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="0,1,0,0"
                IsEnabled="{Binding IsFieldSchemaUnlocked}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,8,12,0"
                           Text="欄位結構"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel Grid.Column="1">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                MinWidth="112"
                                Style="{StaticResource InSpecJavaButtonStyle}"
                                Content="儲存欄位設定"
                                Command="{Binding SaveFieldSchemaCommand}"/>
                        <Button DockPanel.Dock="Right"
                                Margin="0,0,8,0"
                                MinWidth="112"
                                Style="{StaticResource InSpecJavaButtonStyle}"
                                Content="新增欄位設定"
                                Command="{Binding ApplyAddFieldRowCommand}"/>
                    </DockPanel>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding FieldRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="欄位名稱"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Text="對應關鍵字"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="2"
                                               Margin="8,0,0,0"
                                               Text="TargetMode"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="3"
                                               Margin="8,0,0,0"
                                               Text="允許編輯"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"/>

                                    <TextBox Grid.Row="1"
                                             Grid.Column="0"
                                             Margin="0,4,0,0"
                                             Style="{StaticResource InSpecBaseTextFieldStyle}"
                                             IsReadOnly="{Binding IsLocked}"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="8,4,0,0"
                                             Style="{StaticResource InSpecBaseTextFieldStyle}"
                                             Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="2"
                                              Margin="8,4,0,0"
                                              ItemsSource="{Binding DataContext.TargetModeOptions, ElementName=Root}"
                                              SelectedItem="{Binding TargetMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Row="1"
                                              Grid.Column="3"
                                              Margin="8,6,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsEditable, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="1"
                                            Grid.Column="4"
                                            Margin="8,4,0,0"
                                            MinWidth="48"
                                            Style="{StaticResource InSpecJavaButtonStyle}"
                                            Content="移除"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.DeleteFieldRowCommand, ElementName=Root}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource TextTertiary}"
                   Text="{Binding StatusText}"/>
    </Grid>
</UserControl>
