<UserControl x:Class="ExternalModules.CalculatorModule.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CalculatorModule;component/Themes/CalculatorTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CalcBrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="HistoryColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="8">
            <!-- 顯示區 -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CalcBrushDisplayPanel}"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,8"
                    MinHeight="90">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock x:Name="ExpressionText"
                               Foreground="{StaticResource CalcBrushTextSecondary}"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="DisplayText"
                               Text="0"
                               Foreground="{StaticResource CalcBrushTextPrimary}"
                               FontSize="36"
                               FontWeight="Light"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 按鍵區 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 第 1 列：% CE C ÷ -->
                <Button Grid.Row="0" Grid.Column="0" Content="%" Style="{StaticResource CalcFunctionButtonStyle}" Click="FunctionButton_OnClick"/>
                <Button Grid.Row="0" Grid.Column="1" Content="CE" Style="{StaticResource CalcFunctionButtonStyle}" Click="FunctionButton_OnClick"/>
                <Button Grid.Row="0" Grid.Column="2" Content="C" Style="{StaticResource CalcFunctionButtonStyle}" Click="FunctionButton_OnClick"/>
                <Button Grid.Row="0" Grid.Column="3" Content="⌫" Style="{StaticResource CalcFunctionButtonStyle}" Click="FunctionButton_OnClick"/>

                <!-- 第 2 列：7 8 9 × -->
                <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="1" Grid.Column="3" Content="×" Style="{StaticResource CalcOperatorButtonStyle}" Click="OperatorButton_OnClick"/>

                <!-- 第 3 列：4 5 6 - -->
                <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="2" Grid.Column="3" Content="-" Style="{StaticResource CalcOperatorButtonStyle}" Click="OperatorButton_OnClick"/>

                <!-- 第 4 列：1 2 3 + -->
                <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource CalcOperatorButtonStyle}" Click="OperatorButton_OnClick"/>

                <!-- 第 5 列：± 0 . = -->
                <Button Grid.Row="4" Grid.Column="0" Content="±" Style="{StaticResource CalcFunctionButtonStyle}" Click="FunctionButton_OnClick"/>
                <Button Grid.Row="4" Grid.Column="1" Content="0" Style="{StaticResource CalcNumberButtonStyle}" Click="DigitButton_OnClick"/>
                <Button Grid.Row="4" Grid.Column="2" Content="." Style="{StaticResource CalcNumberButtonStyle}" Click="DecimalButton_OnClick"/>
                <Button Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource CalcEqualsButtonStyle}" Click="EqualsButton_OnClick"/>
            </Grid>
        </DockPanel>

        <!-- 運算紀錄區 -->
        <Border Grid.Column="1"
                x:Name="HistoryPanel"
                Background="{StaticResource CalcBrushHistoryBackground}"
                Margin="0,8,8,8"
                CornerRadius="8"
                Padding="8"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="運算紀錄"
                           Foreground="{StaticResource CalcBrushTextSecondary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="4,4,4,8"/>
                <ListBox x:Name="HistoryListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource CalcBrushTextPrimary}"
                         FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
