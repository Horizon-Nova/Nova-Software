{
  "Id": "deployment-tool",
  "DisplayName": "DeploymentTool",
  "Version": "0.1.0",
  "Description": "提供部署專案畫面、VM 資源規劃、Docker 服務描述與部署紀錄總覽，作為 Linux VM 模板與 Docker 串接前的第一版部署工具模組。",
  "IconFile": "icon.svg",
  "EntryAssemblyFile": "bin/DeploymentTool.dll",
  "EntryType": "ExternalModules.DeploymentTool.DeploymentTool",
  "SettingsViewType": "ExternalModules.DeploymentTool.Views.DeploymentToolSettingsView",
  "ReadmeFile": "README.md",
  "MinHostVersion": "",
  "View": {
    "PreferredWidth": 1320,
    "PreferredHeight": 820
  },
  "Settings": [
    {
      "Key": "linuxTemplate",
      "DisplayName": "Linux 模板",
      "Description": "建立部署專案時預設使用的 Linux VM 基底模板。",
      "Editor": "select",
      "EditorOptions": {
        "options": [
          "Ubuntu 24.04 + Docker Base",
          "Ubuntu 22.04 + Docker Base",
          "Debian 12 + Docker Base"
        ]
      },
      "ValueType": "String",
      "DefaultValue": "Ubuntu 24.04 + Docker Base"
    },
    {
      "Key": "defaultCpuCores",
      "DisplayName": "預設 vCPU",
      "Description": "新部署專案預設帶入的虛擬機 CPU 核心數。",
      "Editor": "select",
      "EditorOptions": {
        "options": [ "2", "4", "6", "8", "12" ]
      },
      "ValueType": "Integer",
      "DefaultValue": 4
    },
    {
      "Key": "defaultMemoryMb",
      "DisplayName": "預設 RAM (MB)",
      "Description": "新部署專案預設帶入的虛擬機 RAM 容量。",
      "Editor": "select",
      "EditorOptions": {
        "options": [ "4096", "8192", "12288", "16384", "24576" ]
      },
      "ValueType": "Integer",
      "DefaultValue": 8192
    },
    {
      "Key": "dockerMode",
      "DisplayName": "Docker 模式",
      "Description": "第一版預設採用的 Docker 描述方式。",
      "Editor": "select",
      "EditorOptions": {
        "options": [ "docker compose", "Dockerfile only" ]
      },
      "ValueType": "String",
      "DefaultValue": "docker compose"
    },
    {
      "Key": "workspaceDirectory",
      "DisplayName": "專案工作目錄",
      "Description": "部署專案輸出的預設工作資料夾。",
      "Editor": "directory",
      "ValueType": "String",
      "DefaultValue": ""
    },
    {
      "Key": "autoStartAfterCreate",
      "DisplayName": "建立後自動啟動部署",
      "Description": "建立部署專案後是否直接帶入下一步部署流程。",
      "ValueType": "Boolean",
      "DefaultValue": true
    }
  ]
}
