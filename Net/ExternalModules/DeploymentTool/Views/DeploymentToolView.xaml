<UserControl x:Class="ExternalModules.DeploymentTool.Views.DeploymentToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:ExternalModules.DeploymentTool.Components"
             Focusable="True"
             PreviewKeyDown="Root_OnPreviewKeyDown">
    <UserControl.Resources>
        <DrawingBrush x:Key="DeploymentGridBackgroundBrush"
                      TileMode="Tile"
                      Viewport="0,0,36,36"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,36,36"
                      ViewboxUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ShellLineBrush}"
                             Thickness="0.9"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="36,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,36"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="AddServicePopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ShellMutedForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,3,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource ShellFontSize400}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PopupButtonChrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PopupButtonChrome" Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PopupButtonChrome" Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ShellPrimaryBrush}"
          MouseRightButtonUp="RootGrid_OnMouseRightButtonUp">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <components:PendingChangesBanner x:Name="PendingChangesBanner"
                                             Grid.Row="0"
                                             HorizontalAlignment="Center"
                                             Visibility="Collapsed"/>

            <Grid Grid.Row="2"
                  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CanvasViewportHost"
                        Grid.Column="0"
                        Background="Transparent"
                        ClipToBounds="True">
                    <Grid x:Name="CanvasViewport"
                          Background="Transparent"
                          PreviewMouseDown="CanvasViewport_OnPreviewMouseDown"
                          PreviewMouseUp="CanvasViewport_OnPreviewMouseUp"
                          PreviewMouseMove="CanvasViewport_OnPreviewMouseMove"
                          PreviewMouseWheel="CanvasViewport_OnPreviewMouseWheel"
                          LostMouseCapture="CanvasViewport_OnLostMouseCapture">
                        <Canvas x:Name="CanvasSurface"
                                Width="4000"
                                Height="4000"
                                Background="{StaticResource DeploymentGridBackgroundBrush}">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScaleTransform"
                                                    ScaleX="1"
                                                    ScaleY="1"/>
                                    <TranslateTransform x:Name="CanvasTranslateTransform"
                                                        X="-800"
                                                        Y="-400"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <Canvas x:Name="CanvasPanel"
                                    Width="1600"
                                    Height="1200"
                                    Canvas.Left="900"
                                    Canvas.Top="700"/>
                        </Canvas>
                    </Grid>
                </Border>

                <Border x:Name="ServiceSidePanelHost"
                        Grid.Column="1"
                        Width="0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        ClipToBounds="False"
                        Panel.ZIndex="10">
                    <components:ServiceSidePanel x:Name="ServiceSidePanel"/>
                </Border>
            </Grid>
        </Grid>

        <Popup x:Name="AddServicePopup"
               Placement="MousePoint"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Padding="18"
                    Background="{DynamicResource ShellPrimaryBrush}"
                    BorderBrush="{DynamicResource ShellLineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel MinWidth="220">
                    <TextBlock Text="Add New Service"
                               FontSize="{DynamicResource ShellFontSize300}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellForegroundBrush}"/>

                    <Button Tag="Project Folder"
                            Margin="0,14,0,0"
                            Click="AddServiceOptionButton_OnClick"
                            Style="{StaticResource AddServicePopupButtonStyle}"
                            Content="Project Folder"/>
                    <Button Tag="Database"
                            Click="AddServiceOptionButton_OnClick"
                            Style="{StaticResource AddServicePopupButtonStyle}"
                            Content="Database"/>
                    <Button Tag="Docker Image"
                            Click="AddServiceOptionButton_OnClick"
                            Style="{StaticResource AddServicePopupButtonStyle}"
                            Content="Docker Image"/>
                    <Button Tag="Volume"
                            Click="AddServiceOptionButton_OnClick"
                            Style="{StaticResource AddServicePopupButtonStyle}"
                            Content="Volume"/>
                    <Button Tag="Test"
                            Click="AddServiceOptionButton_OnClick"
                            Style="{StaticResource AddServicePopupButtonStyle}"
                            Content="Test"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
