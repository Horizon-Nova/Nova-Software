<UserControl x:Class="HorizonNova.SampleModule.Views.SampleModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             Background="{DynamicResource SurfaceBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="680">

            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Sample Module" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="示範模組 — HN-Studio 外部模組範例"
                           FontSize="13" Foreground="{DynamicResource TextTertiary}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status card -->
            <Border Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="模組狀態" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusSuccess}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="已載入並啟動" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding WorkspaceText}"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Info card -->
            <Border Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource AccentSoft}"
                    BorderThickness="1,1,1,3" CornerRadius="6"
                    Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="關於此模組" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                               Foreground="{DynamicResource TextSecondary}">
                        <Run Text="此為 HN-Studio 外部模組的示範實作，展示如何："/>
                    </TextBlock>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="• 宣告模組中繼資料（assembly attributes）"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                        <TextBlock Text="• 實作 IModule 介面（CreateView、OnActivated、OnDeactivated）"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                        <TextBlock Text="• 透過 IShellContext 存取殼層服務與工作區資訊"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                        <TextBlock Text="• 內嵌圖示 PNG 至 DLL（ModuleIconResourceAttribute）"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SDK quick-start -->
            <TextBlock Text="SDK 快速入門" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource SurfaceSubtle}"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="16,12">
                <TextBlock FontFamily="Consolas, Cascadia Mono" FontSize="11"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" LineHeight="18">
            <Run Text="// 1. 在 .csproj 中參照 Helix-Studio.ModuleSdk.dll"/>&#x0A;<Run/>&#x0A;
                    <Run Text="// 2. 宣告組件屬性（ModuleInfo.cs）"/>&#x0A;
                    <Run Text="[assembly: ModuleId(&quot;com.company.my-module&quot;)]"/>&#x0A;
                    <Run Text="[assembly: ModuleDisplayName(&quot;My Module&quot;)]"/>&#x0A;
                    <Run Text="[assembly: ModuleVersion(&quot;1.0.0&quot;)]"/>&#x0A;<Run/>&#x0A;
                    <Run Text="// 3. 實作 IModule"/>&#x0A;
                    <Run Text="public class MyModule : IModule { ... }"/>&#x0A;<Run/>&#x0A;
                    <Run Text="// 4. 將輸出資料夾複製至殼層模組目錄"/>
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
