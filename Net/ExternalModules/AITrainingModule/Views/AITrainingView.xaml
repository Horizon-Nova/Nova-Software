<UserControl x:Class="HorizonNova.AITrainingModule.Views.AITrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HorizonNova.AITrainingModule.Views"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             Background="{DynamicResource SurfaceBase}"
             FontSize="13">

    <UserControl.Resources>
        <local:StringEqConverter x:Key="StrEq"/>

        <Style x:Key="GaugeLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width"      Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GaugeValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Width"      Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono"/>
        </Style>

        <!-- Metric chip -->
        <Style x:Key="MetricChip" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="14,10"/>
        </Style>

        <!-- Slider without ticks -->
        <Style TargetType="Slider">
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="Height"        Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Section label above cards -->
        <Style x:Key="CardSection" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AI 視覺訓練"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <!-- Status badge (state-driven) -->
                        <Border x:Name="StatusBadge" Margin="12,3,0,0" Padding="9,3" CornerRadius="10"
                                Background="{DynamicResource SurfaceSubtle}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderLight}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                         Fill="{DynamicResource TextTertiary}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusLabel"
                                           Text="空閒"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="YOLO v11 服裝偵測 · Fashionpedia 46 類"
                               FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Epoch counter (visible while training) -->
                <Border Grid.Column="1" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoft}"
                        BorderBrush="{DynamicResource AccentPrimary}"
                        BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTraining}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Epoch " FontSize="12" Foreground="{DynamicResource AccentPrimary}"/>
                        <TextBlock Text="{Binding CurrentEpoch}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimary}" FontFamily="Consolas, Cascadia Mono"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource AccentPrimary}"/>
                        <TextBlock Text="{Binding TotalEpochs}" FontSize="12"
                                   Foreground="{DynamicResource AccentPrimary}" FontFamily="Consolas, Cascadia Mono"/>
                        <TextBlock Text=" · ETA " FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Eta}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas, Cascadia Mono"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ MAIN TWO-COLUMN ═══════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="296"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT COLUMN ──────────────────────────────────────── -->
                <StackPanel Grid.Column="0">

                    <!-- Metric chips row -->
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Style="{DynamicResource MetricChip}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="mAP50" Style="{DynamicResource CardSection}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LatestMap50, StringFormat={}{0:F3}}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Foreground="{DynamicResource AccentPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource MetricChip}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="mAP50-95" Style="{DynamicResource CardSection}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LatestMap5095, StringFormat={}{0:F3}}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource MetricChip}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Precision" Style="{DynamicResource CardSection}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LatestPrecision, StringFormat={}{0:F3}}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource MetricChip}">
                            <StackPanel>
                                <TextBlock Text="Recall" Style="{DynamicResource CardSection}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LatestRecall, StringFormat={}{0:F3}}"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Loss chart card -->
                    <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="10"/>
                                <!-- legend -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="損失曲線 (Loss)"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" — 訓練 vs 驗證"
                                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Canvas x:Name="LossCanvas" Grid.Row="2"
                                    ClipToBounds="True"
                                    Background="{DynamicResource SurfaceSubtle}"
                                    SizeChanged="LossCanvas_SizeChanged"/>

                            <!-- Placeholder when no data -->
                            <TextBlock Grid.Row="2"
                                       Text="訓練開始後將顯示損失曲線"
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Legend -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <Border Width="24" Height="3" CornerRadius="2" Background="#0F4C81" VerticalAlignment="Center"/>
                                <TextBlock Text="訓練" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="6,0,16,0" VerticalAlignment="Center"/>
                                <Border Width="24" Height="3" CornerRadius="2" Background="#C88400" VerticalAlignment="Center"/>
                                <TextBlock Text="驗證" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- mAP chart card -->
                    <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="110"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="精準度曲線 (mAP50)"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Canvas x:Name="MapCanvas" Grid.Row="2"
                                    ClipToBounds="True"
                                    Background="{DynamicResource SurfaceSubtle}"
                                    SizeChanged="MapCanvas_SizeChanged"/>
                            <TextBlock Grid.Row="2"
                                       Text="訓練開始後將顯示 mAP 曲線"
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Epoch progress card -->
                    <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="訓練進度"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentEpoch}"
                                               FontFamily="Consolas, Cascadia Mono" FontSize="13"
                                               Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" / "
                                               FontFamily="Consolas, Cascadia Mono" FontSize="13"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Text="{Binding TotalEpochs}"
                                               FontFamily="Consolas, Cascadia Mono" FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" epoch"
                                               FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Progress track -->
                            <Border Height="8" CornerRadius="4"
                                    Background="{DynamicResource BorderLight}">
                                <Border x:Name="ProgressFill"
                                        Height="8" CornerRadius="4"
                                        Background="{DynamicResource AccentPrimary}"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="0"/>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="ETA"
                                           FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Eta}"
                                           FontSize="11" FontWeight="SemiBold"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Overfitting warning (only when IsOverfitting) -->
                    <Border Margin="0,0,0,14" CornerRadius="4" Padding="14,12"
                            Background="{DynamicResource StatusWarningSoft}"
                            BorderBrush="{DynamicResource StatusWarning}"
                            BorderThickness="1,1,1,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverfitting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="⚠  過擬合警告"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource StatusWarning}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="最近 5 個 epoch 驗證損失持續高於訓練損失 15% 以上。建議降低學習率、增加 Dropout 或提早停止（patience 參數）。"
                                       FontSize="11" Foreground="{DynamicResource StatusWarning}"
                                       TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Log output -->
                    <Border Style="{DynamicResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="14,10"
                                    BorderBrush="{DynamicResource BorderLight}"
                                    BorderThickness="0,0,0,1"
                                    Background="{DynamicResource SurfaceSubtle}">
                                <TextBlock Text="日誌輸出"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Padding="12,8">
                                <ItemsControl ItemsSource="{Binding LogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas, Cascadia Mono"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ── RIGHT COLUMN ─────────────────────────────────────── -->
                <StackPanel Grid.Column="2">

                    <!-- ─ Actions card ─ -->
                    <Border Style="{DynamicResource Card}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="操作" Style="{DynamicResource CardSection}"/>

                            <Button Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding StartCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                <TextBlock Text="▶  開始訓練"/>
                            </Button>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{DynamicResource GhostButton}"
                                        Command="{Binding StopCommand}"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="■  停止"/>
                                </Button>
                                <Button Grid.Column="2" Style="{DynamicResource GhostButton}"
                                        Command="{Binding ResumeCommand}"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="↺  繼續"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ─ Training config card ─ -->
                    <Border Style="{DynamicResource Card}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="訓練設定" Style="{DynamicResource CardSection}"/>

                            <!-- Project path -->
                            <TextBlock Text="專案目錄" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderBrush="{DynamicResource BorderMedium}"
                                        BorderThickness="1" CornerRadius="3" Padding="8,0">
                                    <TextBlock Text="{Binding ProjectPath}"
                                               FontFamily="Consolas, Cascadia Mono"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Height="26"/>
                                </Border>
                                <Button Grid.Column="2" Style="{DynamicResource GhostButton}"
                                        Command="{Binding BrowseCommand}"
                                        Padding="10,0" Height="26" Content="…"/>
                            </Grid>

                            <!-- Model selection -->
                            <TextBlock Text="模型大小" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Margin="0,0,0,12">
                                <RadioButton Content="yolo11n  (nano · 快速)"
                                             FontSize="12" Margin="0,0,0,4" Cursor="Hand"
                                             IsChecked="{Binding SelectedModel, Converter={StaticResource StrEq}, ConverterParameter=yolo11n.pt}"/>
                                <RadioButton Content="yolo11s  (small · 均衡)"
                                             FontSize="12" Margin="0,0,0,4" Cursor="Hand"
                                             IsChecked="{Binding SelectedModel, Converter={StaticResource StrEq}, ConverterParameter=yolo11s.pt}"/>
                                <RadioButton Content="yolo11m  (medium · 高精)"
                                             FontSize="12" Cursor="Hand"
                                             IsChecked="{Binding SelectedModel, Converter={StaticResource StrEq}, ConverterParameter=yolo11m.pt}"/>
                            </StackPanel>

                            <!-- Epochs -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Epochs" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalEpochs}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="12"
                                           Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Value="{Binding TotalEpochs}" Minimum="10" Maximum="200"
                                    SmallChange="5" LargeChange="10" Margin="0,0,0,10"/>

                            <!-- Batch -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Batch Size" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BatchSize}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Value="{Binding BatchSize}" Minimum="4" Maximum="64"
                                    SmallChange="4" LargeChange="8" Margin="0,0,0,4"/>

                            <CheckBox Content="AMP 混合精度訓練" IsChecked="{Binding EnableAmp}"
                                      FontSize="11" Margin="0,8,0,0" Cursor="Hand"
                                      Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- ─ Augmentation card ─ -->
                    <Border Style="{DynamicResource Card}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="圖片增強" Style="{DynamicResource CardSection}"/>

                            <!-- Flip LR -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="水平翻轉" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AugFliplr, StringFormat={}{0:F2}}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding AugFliplr}" Minimum="0" Maximum="1" Margin="0,0,0,10"/>

                            <!-- Degrees -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="旋轉角度" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AugDegrees, StringFormat={}{0:F0}°}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding AugDegrees}" Minimum="0" Maximum="45" Margin="0,0,0,10"/>

                            <!-- Scale -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="縮放增益" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AugScale, StringFormat={}{0:F2}}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding AugScale}" Minimum="0" Maximum="1" Margin="0,0,0,10"/>

                            <!-- Mosaic -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Mosaic" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AugMosaic, StringFormat={}{0:F2}}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding AugMosaic}" Minimum="0" Maximum="1" Margin="0,0,0,10"/>

                            <!-- Blur -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="高斯模糊" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AugBlur, StringFormat={}{0:F2}}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding AugBlur}" Minimum="0" Maximum="1" Margin="0,0,0,10"/>

                            <!-- HSV-S -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBlock Text="飽和度抖動" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AugHsvS, StringFormat={}{0:F2}}"
                                           FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding AugHsvS}" Minimum="0" Maximum="1" Margin="0,0,0,0"/>

                        </StackPanel>
                    </Border>

                    <!-- ─ System monitor card ─ -->
                    <Border Style="{DynamicResource Card}" Padding="16,14" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="系統監控" Style="{DynamicResource CardSection}"/>

                            <!-- GPU utilization -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource GaugeLabel}" Text="GPU"/>
                                <ProgressBar Grid.Column="1" Height="5" VerticalAlignment="Center"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding GpuUsage}"
                                             Foreground="{DynamicResource AccentPrimary}"
                                             Background="{DynamicResource BorderLight}"
                                             BorderThickness="0"/>
                                <TextBlock Grid.Column="2" Style="{DynamicResource GaugeValue}"
                                           Text="{Binding GpuUsage, StringFormat={}{0:F0}%}"/>
                            </Grid>

                            <!-- VRAM -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource GaugeLabel}" Text="VRAM"/>
                                <ProgressBar Grid.Column="1" Height="5" VerticalAlignment="Center"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding GpuMemProgress}"
                                             Foreground="{DynamicResource NavIndicator}"
                                             Background="{DynamicResource BorderLight}"
                                             BorderThickness="0"/>
                                <TextBlock Grid.Column="2" Style="{DynamicResource GaugeValue}"
                                           Width="Auto" FontSize="9"
                                           Text="{Binding GpuMemText}"/>
                            </Grid>

                            <!-- CPU -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource GaugeLabel}" Text="CPU"/>
                                <ProgressBar Grid.Column="1" Height="5" VerticalAlignment="Center"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding CpuUsage}"
                                             Foreground="{DynamicResource StatusSuccess}"
                                             Background="{DynamicResource BorderLight}"
                                             BorderThickness="0"/>
                                <TextBlock Grid.Column="2" Style="{DynamicResource GaugeValue}"
                                           Text="{Binding CpuUsage, StringFormat={}{0:F0}%}"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
