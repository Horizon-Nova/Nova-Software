<Window x:Class="UsbPowerGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB 防休眠控制" Height="640" Width="660"
        WindowStartupLocation="CenterScreen"
        Background="#1e2330" FontFamily="Microsoft JhengHei UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#252c3d"/>
            <Setter Property="BorderBrush" Value="#2d3548"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1d9e75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8b94a8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#2d3548" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="USB 防休眠控制" FontSize="22" FontWeight="SemiBold" Foreground="#e8ecf2"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8b94a8" Margin="0,6,0,0"
                       Text="防止閒置時 USB 攝影機等裝置被 Windows「USB 選擇性暫停」關閉。新版 Windows 已從設定介面隱藏此選項，此工具直接控制。"/>
        </StackPanel>

        <!-- USB 選擇性暫停 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="USB 選擇性暫停" FontSize="14" FontWeight="SemiBold" Foreground="#e8ecf2"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12" Foreground="#8b94a8" Margin="0,0,0,4">
                            <Run Text="交流電源 (AC)："/><Run x:Name="AcState" Text="—" Foreground="#e8ecf2" FontWeight="Medium"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#8b94a8">
                            <Run Text="電池電源 (DC)："/><Run x:Name="DcState" Text="—" Foreground="#e8ecf2" FontWeight="Medium"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="DisableBtn" Content="停用（建議）" Style="{StaticResource PrimaryBtn}" Click="Disable_Click"/>
                        <Button x:Name="EnableBtn" Content="還原為啟用" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" Click="Enable_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="停用後，閒置時 USB 裝置不會被暫停，攝影機可持續擷取。套用時會要求系統管理員權限。"
                           FontSize="11" Foreground="#5a6478" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- 睡眠狀態報告 -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Text="電源待機方式" FontSize="14" FontWeight="SemiBold" Foreground="#e8ecf2"/>
                    <Button x:Name="RefreshBtn" Content="重新整理" Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Right" Padding="12,5" FontSize="12" Click="Refresh_Click"/>
                </Grid>
                <Border Margin="0,14,0,0" Background="#141925" CornerRadius="8" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="SleepHeadline" FontSize="15" FontWeight="SemiBold" Foreground="#e8ecf2"/>
                        <TextBlock x:Name="SleepDetail" Margin="0,8,0,0" FontSize="12" Foreground="#8b94a8"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 狀態列 -->
        <Border Grid.Row="3" Background="#141925" CornerRadius="6" Padding="12,8">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#8b94a8" Text="就緒。"/>
        </Border>
    </Grid>
</Window>
