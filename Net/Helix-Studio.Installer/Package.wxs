<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- ?瞉???謏???謅Ｗ?????? publish ?謜眾?????dName=AppBuild?謅????-->
  <Package
      Id="HorizonNova.HelixStudio"
      Name="Helix Studio"
      Manufacturer="Horizon Nova"
      Version="1.0.1.0"
      UpgradeCode="b7e2d1c0-8c5e-4b6d-af1e-2c3d4e5f6071"
      Scope="perMachine"
      Language="1028"
      InstallerVersion="500">
    <SummaryInformation Description="Horizon Nova Helix Studio installer package for .NET." />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="偵測到較新的 Helix Studio 版本已安裝，無法繼續安裝此版本。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- WixUI_InstallDir ?????謅Ｗ????????????謜?雓▽?雓???? Id?謅????-->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="HELIXSTUDIO_CREATE_DESKTOP_SHORTCUT" Value="0" />
    <Property Id="HELIXSTUDIO_CREATE_STARTMENU_SHORTCUT" Value="1" />
    <!-- ????????遴狗鞊舫??謅?H=?謚單???鞊莎???頩?EN=????????頩???璇?????謍???????Language ????謅???頩??獢???豲???-->
    <Property Id="EULA_LANG" Value="ZH" />
    <!-- ??????????鞈芰??謘蝓蹎剁 Property ??????播摰???????????頩???謍單???尿???????穿?璇????????????????????豰?????鞈???-->

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Helix Studio 已安裝完成。" />
    <Icon Id="HelixStudioIcon.ico" SourceFile="..\Helix-Studio\Assets\HelixStudioIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="HelixStudioIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CompanyDir" Name="HorizonNova">
        <Directory Id="INSTALLFOLDER" Name="Helix-Studio" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="HelixStudioProgramMenuDir" Name="Helix Studio" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- ????????謅Ｗ擗???-> ?甇Ｙ???-> ?謚單??雓??????-> ??????? -> ?????謅?NStudio_InstallUi.wxs?謅????-->
    <UIRef Id="HelixStudio_InstallDir_X64" />

    <Feature Id="Main" Title="Helix Studio" Level="1">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.AppBuild)\**" />
      <Component Directory="HelixStudioProgramMenuDir" Condition="HELIXSTUDIO_CREATE_STARTMENU_SHORTCUT">
        <Shortcut Id="HelixStudioStartMenuShortcut"
                  Name="Helix Studio"
                  Target="[INSTALLFOLDER]Helix-Studio.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="HelixStudioIcon.ico" />
        <RemoveFolder Id="RemoveHelixStudioProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\HorizonNova\Helix-Studio"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Directory="DesktopFolder" Condition="HELIXSTUDIO_CREATE_DESKTOP_SHORTCUT">
        <Shortcut Id="HelixStudioDesktopShortcut"
                  Name="Helix Studio"
                  Target="[INSTALLFOLDER]Helix-Studio.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="HelixStudioIcon.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\HorizonNova\Helix-Studio"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
