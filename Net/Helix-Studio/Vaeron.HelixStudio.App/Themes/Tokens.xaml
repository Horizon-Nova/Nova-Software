<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- 尺寸取設計稿的基準值（ui-fluid 係數前的數字），彼此比例與設計稿一致。 -->
  <sys:Double x:Key="FsLg">20</sys:Double>
  <sys:Double x:Key="FsBase">16</sys:Double>
  <sys:Double x:Key="FsSm">14</sys:Double>

  <sys:Double x:Key="BtnIcon">34</sys:Double>
  <sys:Double x:Key="BtnIconLg">43.8</sys:Double>
  <sys:Double x:Key="BarTop">57.8</sys:Double>
  <sys:Double x:Key="BarBottom">46</sys:Double>

  <sys:Double x:Key="ColRail">80</sys:Double>
  <sys:Double x:Key="ColSide">260</sys:Double>
  <sys:Double x:Key="ColAi">400</sys:Double>

  <sys:Double x:Key="PadBarX">16</sys:Double>
  <sys:Double x:Key="GapBar">14.4</sys:Double>
  <sys:Double x:Key="PadPanel">16</sys:Double>
  <sys:Double x:Key="GapPanel">8</sys:Double>

  <CornerRadius x:Key="RadiusSm">5.6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8.8</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">14.4</CornerRadius>
  <CornerRadius x:Key="RadiusInner">5.6</CornerRadius>

  <!-- WindowChrome 最大化時視窗矩形四邊各超出工作區這麼多，等於 SystemParameters
       的 WindowResizeBorderThickness(3.2) + WindowNonClientFrameThickness 左右邊(3.2)。 -->
  <Thickness x:Key="MaximizedFrameCompensation">6.4</Thickness>

  <Thickness x:Key="PadPanelThickness">16</Thickness>
  <Thickness x:Key="PadBarThickness">16,0,16,0</Thickness>
</ResourceDictionary>
