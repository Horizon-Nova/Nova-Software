<UserControl x:Class="Vaeron.HelixStudio.App.Views.SystemAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vaeron.HelixStudio.App.Controls">

  <UserControl.Resources>
    <!-- 以下每一組 DataTrigger 的 key 都是資料庫給的值：等級、狀態代碼、欄位可動狀態。 -->

    <Style x:Key="MetricText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,0,9,0" />
    </Style>

    <Style x:Key="CpuText" TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CpuLevel}" Value="warn">
          <Setter Property="Foreground" Value="{StaticResource StatusWarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding CpuLevel}" Value="hot">
          <Setter Property="Foreground" Value="{StaticResource StatusErrorText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NetText" TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding NetLevel}" Value="warn">
          <Setter Property="Foreground" Value="{StaticResource StatusWarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding NetLevel}" Value="hot">
          <Setter Property="Foreground" Value="{StaticResource StatusErrorText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SubText" TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
      <Setter Property="FontSize" Value="{StaticResource FsSm}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
    </Style>

    <Style x:Key="StateDot" TargetType="Ellipse">
      <Setter Property="Width" Value="6.4" />
      <Setter Property="Height" Value="6.4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{StaticResource Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="running">
          <Setter Property="Fill" Value="{StaticResource AccentSolid}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FieldInput" TargetType="TextBox">
      <Setter Property="Width" Value="144" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EditState}" Value="adjustable">
          <Setter Property="BorderBrush" Value="{StaticResource EditBorder}" />
          <Setter Property="Background" Value="{StaticResource EditBg}" />
          <Setter Property="Foreground" Value="{StaticResource Text1}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding EditState}" Value="modified">
          <Setter Property="BorderBrush" Value="{StaticResource EditBorderDirty}" />
          <Setter Property="Background" Value="{StaticResource EditBgDirty}" />
          <Setter Property="Foreground" Value="{StaticResource Text1}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FieldIcon" TargetType="c:IconControl">
      <Setter Property="IconName" Value="lock" />
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EditState}" Value="adjustable">
          <Setter Property="IconName" Value="sliders-horizontal" />
        </DataTrigger>
        <DataTrigger Binding="{Binding EditState}" Value="modified">
          <Setter Property="IconName" Value="check" />
          <Setter Property="Foreground" Value="{StaticResource EditIconDirty}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="FontSize" Value="{StaticResource FsSm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource BgHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Background" Value="{StaticResource AccentSolid}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentSolid}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Resources>

  <DockPanel LastChildFill="True">

    <!-- 工具列 -->
    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,9">
      <Border DockPanel.Dock="Left" Width="224" Height="30" BorderBrush="{StaticResource Border}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="9,0">
        <DockPanel LastChildFill="True">
          <c:IconControl DockPanel.Dock="Left" IconName="search" Foreground="{StaticResource Text3}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
          <Grid>
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                     Foreground="{StaticResource Text1}" FontSize="{StaticResource FsBase}" />
            <TextBlock Text="搜尋軟體" FontSize="{StaticResource FsBase}" Margin="2,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </Border>

      <Button DockPanel.Dock="Left" Margin="9,0,0,0" Command="{Binding CycleFilterCommand}"
              Content="{Binding FilterLabel}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding FilterOn}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentSolid}" />
                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>

      <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="34" Padding="0"
              ToolTip="重新取樣" Command="{Binding RescanCommand}">
        <c:IconControl IconName="refresh" />
      </Button>
      <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center"
                 Margin="0,0,9,0" FontSize="{StaticResource FsSm}" Foreground="{StaticResource Text3}" />
    </DockPanel>

    <!-- 配額工作面 -->
    <Border DockPanel.Dock="Bottom" Height="240" Margin="0,9,0,0" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusInner}">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,7">
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveName}" FontWeight="Bold"
                       FontSize="{StaticResource FsBase}" Foreground="{StaticResource Text1}"
                       VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveMeta}" Margin="8,0,0,0"
                       FontSize="{StaticResource FsSm}" Foreground="{StaticResource Text3}"
                       VerticalAlignment="Center" />

            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="24"
                    Content="套用變更" Command="{Binding ApplyAllCommand}"
                    Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="24" Margin="0,0,6,0"
                    Content="還原" Command="{Binding RevertAllCommand}"
                    Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock DockPanel.Dock="Right" Margin="0,0,9,0" VerticalAlignment="Center"
                       FontSize="{StaticResource FsSm}" FontWeight="SemiBold"
                       Foreground="{StaticResource EditIconDirty}"
                       Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}">
              <Run Text="{Binding ChangedCount, Mode=OneWay}" /><Run Text=" 項未套用" />
            </TextBlock>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="24" Margin="0,0,9,0"
                    Command="{Binding ToggleActiveCommand}"
                    Visibility="{Binding HasActive, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <c:IconControl IconName="{Binding ActiveToggleIcon}" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ActiveToggleLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="10,7">
                  <DockPanel LastChildFill="True">
                    <c:IconControl DockPanel.Dock="Right" Style="{StaticResource FieldIcon}"
                                   ToolTip="{Binding IconTitle}" VerticalAlignment="Center" Margin="5,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Width="42" Margin="5,0,0,0"
                               VerticalAlignment="Center" FontSize="{StaticResource FsSm}"
                               FontWeight="Medium" Foreground="{StaticResource Text3}" />
                    <Grid DockPanel.Dock="Right">
                      <TextBox x:Name="FieldBox" Style="{StaticResource FieldInput}"
                               Text="{Binding DisplayValue, Mode=OneWay}"
                               IsReadOnly="{Binding ReadOnly}" ToolTip="{Binding DisplayValue}"
                               LostFocus="OnFieldCommitted" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Placeholder}" Margin="9,0,0,0"
                                 FontSize="{StaticResource FsBase}" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=FieldBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <StackPanel MinWidth="0">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                 FontWeight="SemiBold" FontSize="{StaticResource FsBase}"
                                 Foreground="{StaticResource Text1}" />
                      <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Note}" FontSize="{StaticResource FsSm}"
                                 Foreground="{StaticResource Text3}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 軟體清單 -->
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusInner}">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="操作" Width="96" TextAlignment="Right" Margin="0,7,9,7"
                       FontWeight="Bold" FontSize="{StaticResource FsSm}" Foreground="{StaticResource Text2}" />
            <!-- 表頭與資料列共用資料庫給的欄寬，並以相同的由右往左停靠順序排列。 -->
            <ItemsControl ItemsSource="{Binding Header}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="DockPanel.Dock" Value="Right" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Cursor="Hand" Padding="9,7"
                          HorizontalContentAlignment="{Binding Alignment}">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Width" Value="{Binding Width}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Fills}" Value="True">
                            <Setter Property="Width" Value="Auto" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource BgHover}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="{StaticResource FsSm}"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text2}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSorted}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <c:IconControl IconName="{Binding Arrow}" Margin="3,0,0,0"
                                     Foreground="{StaticResource AccentText}"
                                     Visibility="{Binding IsSorted, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Surface" Background="Transparent"
                              BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Surface" Property="Background" Value="{StaticResource BgHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentTint}" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>

                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="24" Width="78"
                            Margin="9,4" Content="{Binding ToggleLabel}" ToolTip="{Binding ToggleTitle}"
                            IsEnabled="{Binding ToggleEnabled}"
                            Command="{Binding DataContext.ToggleStateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SubText}" Width="88"
                               Text="{Binding Disk}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource NetText}" Width="96"
                               Text="{Binding Net}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MetricText}" Width="104"
                               Text="{Binding Ram}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource CpuText}" Width="96"
                               Text="{Binding Cpu}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SubText}" Width="88"
                               Text="{Binding StateLabel}" />

                    <StackPanel Orientation="Horizontal" Margin="9,6" MinWidth="0">
                      <Ellipse Style="{StaticResource StateDot}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                 FontSize="{StaticResource FsBase}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text1}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Publisher}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 FontSize="{StaticResource FsSm}" Foreground="{StaticResource Text3}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                                 FontSize="{StaticResource FsSm}" Foreground="{StaticResource EditIconDirty}"
                                 Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="{Binding ChangedCount, Mode=OneWay}" /><Run Text=" 項待套用" />
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
