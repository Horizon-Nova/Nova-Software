<UserControl x:Class="Helix_Studio.Components.SkeletonShimmer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="96"
             d:DesignHeight="12"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <!--
        現代 Skeleton 設計原則：
        · 乾淨的色塊底色（BaseBackground），無模糊、無邊緣淡出
        · 一道細緻的白色光帶從左向右掃過
        · 光帶寬度約佔總寬 30%，以 SineEase 做緩入緩出
        · CornerRadius + ClipToBounds 確保圓角乾淨裁切
    -->

    <Border CornerRadius="{Binding CornerRadius, ElementName=Root}"
            Background="{Binding BaseBackground, ElementName=Root}"
            Height="{Binding SkeletonHeight, ElementName=Root}"
            ClipToBounds="True"
            IsHitTestVisible="False"
            Visibility="{Binding IsActive, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border.Style>
            <Style TargetType="Border">
                <!-- 預設：固定寬度，靠左對齊 -->
                <Setter Property="Width" Value="{Binding SkeletonWidth, ElementName=Root}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <!-- UseStretch=True：延伸填滿父容器 -->
                    <DataTrigger Binding="{Binding UseStretch, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="NaN"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- 掃光帶：細緻白色漸層，從左向右移動 -->
            <Rectangle Opacity="{Binding HighlightOpacity, ElementName=Root}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent"  Offset="0.00"/>
                        <GradientStop Color="#18FFFFFF"    Offset="0.35"/>
                        <GradientStop Color="#40FFFFFF"    Offset="0.50"/>
                        <GradientStop Color="#18FFFFFF"    Offset="0.65"/>
                        <GradientStop Color="Transparent"  Offset="1.00"/>
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="ShimmerTransform" X="-1"/>
                        </LinearGradientBrush.RelativeTransform>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="ShimmerTransform"
                                             Storyboard.TargetProperty="X"
                                             From="-1" To="1"
                                             Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Border>
</UserControl>
