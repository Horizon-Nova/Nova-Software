<UserControl x:Class="Helix_Studio.Components.ReadmeViewerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="700"
             Visibility="Collapsed">
    <StackPanel Margin="0,32,0,0">
        <Border BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="0,1,0,0"
                Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,16">
            <TextBlock Text="&#xE8A5;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="10"
                       Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center" />
            <TextBlock Text="README"
                       Margin="6,0,0,0"
                       FontSize="8"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Border MaxWidth="920"
                Padding="32,24"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderMedium}"
                BorderThickness="1"
                CornerRadius="6">
            <mdxaml:MarkdownScrollViewer x:Name="MarkdownHost"
                                         MaxHeight="560"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontFamily="Segoe UI, Microsoft JhengHei UI"
                                         FontSize="12"
                                         VerticalScrollBarVisibility="Auto"
                                         MarkdownStyle="{x:Static mdxaml:MarkdownStyle.GithubLike}" />
        </Border>
    </StackPanel>
</UserControl>
