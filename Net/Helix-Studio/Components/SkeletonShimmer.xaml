<UserControl x:Class="Helix_Studio.Components.SkeletonShimmer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="140"
             d:DesignHeight="30"
             Background="Transparent"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border x:Name="ShellBorder"
            CornerRadius="{Binding CornerRadius, ElementName=Root}"
            Background="{Binding BaseBackground, ElementName=Root}"
            Height="{Binding SkeletonHeight, ElementName=Root}"
            ClipToBounds="True"
            IsHitTestVisible="False"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Width" Value="{Binding SkeletonWidth, ElementName=Root}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UseStretch, ElementName=Root}" Value="True">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Width" Value="NaN"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid x:Name="ShimmerHost">
            <Rectangle x:Name="ShimmerBand"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       IsHitTestVisible="False"
                       RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ShimmerTransform"/>
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Border>
</UserControl>
