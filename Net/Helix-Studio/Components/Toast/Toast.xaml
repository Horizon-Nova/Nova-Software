<UserControl x:Class="Helix_Studio.Components.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="340" d:DesignHeight="100"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Width="340">
    <Border CornerRadius="4">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="White" Offset="0.99"/>
                <GradientStop Color="#0F4C81" Offset="0.99"/>
                <GradientStop Color="#0F4C81" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Button Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,6,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CloseButton_Click">
                <TextBlock Text="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"/>
            </Button>

            <StackPanel Margin="12,8,36,8">
                <TextBox x:Name="TitleBlock"
                        Text="{Binding Title, ElementName=Root, Mode=OneWay, FallbackValue='Notification'}"
                        BorderThickness="0"
                        Background="Transparent"/>

                <TextBox x:Name="MessageBlock"
                        Text="{Binding Message, ElementName=Root, Mode=OneWay, FallbackValue='Check layout in the designer.'}"
                        BorderThickness="0"
                        Background="Transparent"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

