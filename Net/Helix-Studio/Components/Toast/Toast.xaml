<UserControl x:Class="Helix_Studio.Components.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:Helix_Studio.Components"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="340" d:DesignHeight="100"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Width="340">
    <Border CornerRadius="6"
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SeverityBar"
                    Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Information">
                                <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Success">
                                <Setter Property="Background" Value="{DynamicResource StatusSuccess}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource StatusWarning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource StatusDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Button Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,6,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CloseButton_Click">
                <shell:SvgIcon Source="/Assets/lucide/x.svg"
                               Width="10" Height="10"
                               Foreground="{DynamicResource TextTertiary}"/>
            </Button>

            <StackPanel Grid.Column="1" Margin="12,8,36,8">
                <TextBox x:Name="TitleBlock"
                        Text="{Binding Title, ElementName=Root, Mode=OneWay, FallbackValue='Notification'}"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimary}"
                        FontWeight="SemiBold"
                        FontSize="12"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="False"/>

                <TextBox x:Name="MessageBlock"
                        Text="{Binding Message, ElementName=Root, Mode=OneWay, FallbackValue='Check layout in the designer.'}"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondary}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="False"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
