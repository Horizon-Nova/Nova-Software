<UserControl x:Class="Helix_Studio.Components.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="340" d:DesignHeight="100"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Width="340">
    <Border CornerRadius="6"
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AccentPrimary}"/>

            <Button Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,6,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CloseButton_Click">
                <TextBlock Text="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TextTertiary}"/>
            </Button>

            <StackPanel Grid.Column="1" Margin="12,8,36,8">
                <TextBox x:Name="TitleBlock"
                        Text="{Binding Title, ElementName=Root, Mode=OneWay, FallbackValue='Notification'}"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimary}"
                        FontWeight="SemiBold"
                        FontSize="12"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="False"/>

                <TextBox x:Name="MessageBlock"
                        Text="{Binding Message, ElementName=Root, Mode=OneWay, FallbackValue='Check layout in the designer.'}"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondary}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="False"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
