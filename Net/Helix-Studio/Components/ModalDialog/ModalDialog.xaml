<UserControl x:Class="Helix_Studio.Components.ModalDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="520"
             d:DesignHeight="260"
             FontFamily="Segoe UI, Microsoft JhengHei UI">

    <Grid Background="{DynamicResource OverlayScrim}">
        <Border Width="420"
                CornerRadius="4"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceSubtle}"
                        BorderBrush="{DynamicResource BorderLight}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="4,4,0,0"
                        Padding="16,0">

                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE783;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding Title, ElementName=Root, Mode=OneWay, FallbackValue=請確認操作}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="18,16">

                    <TextBlock Text="{Binding Message, ElementName=Root, Mode=OneWay, FallbackValue=請確認此操作後再繼續。}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>

                    <TextBlock Text="{Binding Description, ElementName=Root, Mode=OneWay, FallbackValue=此操作可能影響目前工作區資料。}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceSubtle}"
                        BorderBrush="{DynamicResource BorderLight}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,4,4"
                        Padding="16,0">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="{Binding CancelText, ElementName=Root, Mode=OneWay, FallbackValue=取消}"
                                Style="{DynamicResource GhostButton}"
                                Height="32"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Click="CancelButton_Click"/>

                        <Button Content="{Binding ConfirmText, ElementName=Root, Mode=OneWay, FallbackValue=確認}"
                                Style="{DynamicResource PrimaryButton}"
                                Height="32"
                                MinWidth="80"
                                Click="ConfirmButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
