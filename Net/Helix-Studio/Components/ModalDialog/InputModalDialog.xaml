<UserControl x:Class="Helix_Studio.Components.InputModalDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             IsHitTestVisible="False">

    <Grid Background="#99000000">
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                MinWidth="420">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="{Binding Input1Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="Input1Box"
                             Margin="0,6,0,0"
                             Text="{Binding Input1Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Input2Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="Input2Box"
                             Margin="0,6,0,0"
                             Text="{Binding Input2Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton"
                            Style="{DynamicResource GhostButton}"
                            MinWidth="90"
                            Content="{Binding CancelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{DynamicResource PrimaryButton}"
                            MinWidth="90"
                            Margin="10,0,0,0"
                            Content="{Binding ConfirmText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

