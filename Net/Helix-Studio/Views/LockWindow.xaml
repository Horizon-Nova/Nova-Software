<Window x:Class="Helix_Studio.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        Background="{StaticResource SurfaceBase}"
        FontFamily="Segoe UI, Microsoft JhengHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Border Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">
            <StackPanel>
                <TextBlock Text="已鎖定"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="因閒置時間過長，已自動鎖定。"
                           Margin="0,10,0,0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="按下「解除鎖定」即可繼續使用。"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiary}"/>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Width="120" Height="34"
                            Content="解除鎖定" Click="Unlock_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

