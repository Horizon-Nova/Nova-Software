<Window x:Class="Helix_Studio.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Lock_Title}"
        Icon="/Assets/image/AppLogo.png"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        Background="{DynamicResource SurfaceBase}"
        FontFamily="Segoe UI, Microsoft JhengHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc_Lock_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{DynamicResource Loc_Lock_Body1}"
                           Margin="0,10,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{DynamicResource Loc_Lock_Body2}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"/>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource PrimaryButton}"
                            Width="120"
                            Height="34"
                            Content="{DynamicResource Loc_Lock_Unlock}"
                            Click="Unlock_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

