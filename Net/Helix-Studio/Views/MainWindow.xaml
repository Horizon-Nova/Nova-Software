<Window x:Class="Helix_Studio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:Helix_Studio.Components"
        xmlns:conv="clr-namespace:Helix_Studio.Views.Converters"
        xmlns:notify="clr-namespace:Helix_Studio.Model.Notifications"
        mc:Ignorable="d"
        Title="{DynamicResource Loc_AppTitle}"
        Icon="/Assets/image/AppLogo.ico"
        Width="1280"
        Height="820"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBase}"
        FontFamily="Segoe UI, Microsoft JhengHei UI"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <conv:DynamicResourceProxy x:Key="LocShellLogoVersionProxy" Value="{DynamicResource Loc_Shell_LogoVersion}"/>
        <conv:DynamicResourceProxy x:Key="LocShellStatusModulesRunningProxy" Value="{DynamicResource Loc_Shell_Status_ModulesRunning}"/>
        <conv:DynamicResourceProxy x:Key="LocShellStatusDeviceProxy" Value="{DynamicResource Loc_Shell_Status_Device}"/>
        <conv:DynamicResourceProxy x:Key="LocShellStatusBuildProxy" Value="{DynamicResource Loc_Shell_Status_Build}"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="190" MaxWidth="420"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- 側欄 -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceSidebarDeep}" Padding="16,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource AccentPrimary}">
                            <TextBlock Text="H"
                                       Foreground="White"
                                       FontWeight="Black"
                                       FontSize="15"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HELIX"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnDark}"/>
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource TextOnDarkMuted}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatString}">
                                        <Binding Source="{StaticResource LocShellLogoVersionProxy}" Path="Value"/>
                                        <Binding Path="ProductVersion"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="12,10,12,6">
                    <Grid>
                        <Button x:Name="WorkspaceSwitchButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ToggleWorkspacePopupCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource BrandAccent}"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderMedium}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="22"
                                                    Height="22"
                                                    Background="{DynamicResource AccentPrimary}"
                                                    CornerRadius="3">
                                                <shell:SvgIcon IconSize="13"
                                                               Source="/Assets/lucide/layers.svg"
                                                               Foreground="{DynamicResource TextOnDark}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_Shell_WorkspaceLabel}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextOnDarkMuted}"/>
                                                <TextBlock Text="{Binding ActiveWorkspaceName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnDark}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <shell:SvgIcon Grid.Column="2"
                                                           x:Name="WsChevron"
                                                           IconSize="12"
                                                           Source="/Assets/lucide/chevron-down.svg"
                                                           Foreground="{DynamicResource TextOnDarkMuted}"
                                                           VerticalAlignment="Center">
                                                <shell:SvgIcon.RenderTransform>
                                                    <RotateTransform Angle="0" CenterX="6" CenterY="6"/>
                                                </shell:SvgIcon.RenderTransform>
                                            </shell:SvgIcon>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsWorkspacePopupOpen, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter TargetName="WsChevron" Property="UIElement.RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" CenterX="6" CenterY="6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup x:Name="WorkspacePopup"
                               PlacementTarget="{Binding ElementName=WorkspaceSwitchButton}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsWorkspacePopupOpen, Mode=TwoWay}"
                               VerticalOffset="4"
                               Width="196">
                            <Border Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel Margin="0,6">
                                    <TextBlock Text="{DynamicResource Loc_Shell_SwitchWorkspace}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Margin="14,4,14,6"/>
                                    <ItemsControl ItemsSource="{Binding Workspaces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="14,6"
                                                        Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.ActivateWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Margin="6,0,0,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Fill="{DynamicResource AccentPrimary}"
                                                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Description}"
                                                                               FontSize="10"
                                                                               Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource TextTertiary}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border BorderBrush="{DynamicResource BorderLight}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,4,0,0">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="14,8"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <shell:SvgIcon IconSize="12"
                                                               Source="/Assets/lucide/settings.svg"
                                                               Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="{DynamicResource Loc_Shell_ManageWorkspaces}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentPrimary}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,8">
                        <StackPanel Visibility="{Binding IsWorkspaceSwitching, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,4,0,4">
                            <shell:SkeletonShimmer SkeletonHeight="30"
                                                   SkeletonWidth="80"
                                                   CornerRadius="4"
                                                   Margin="22,0,0,6"
                                                   Opacity="0.65"
                                                   BaseBackground="{DynamicResource SurfaceSidebarDeep}"
                                                   IsActive="True"/>
                            <shell:SkeletonShimmer SkeletonHeight="30"
                                                   SkeletonWidth="140"
                                                   CornerRadius="4"
                                                   Margin="22,0,0,6"
                                                   Opacity="0.50"
                                                   BaseBackground="{DynamicResource SurfaceSidebarDeep}"
                                                   IsActive="True"/>
                            <shell:SkeletonShimmer SkeletonHeight="30"
                                                   SkeletonWidth="120"
                                                   CornerRadius="4"
                                                   Margin="22,0,0,0"
                                                   Opacity="0.35"
                                                   BaseBackground="{DynamicResource SurfaceSidebarDeep}"
                                                   IsActive="True"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorkspaceSwitching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{DynamicResource Loc_Shell_NavWorkspaceSection}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnDarkMuted}"
                                       Margin="22,10,22,6"/>

                            <RadioButton Style="{DynamicResource NavButton}"
                                         GroupName="ShellNav"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="overview"
                                         IsChecked="{Binding CurrentNavId, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=overview, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon IconSize="14" Source="/Assets/lucide/house.svg"/>
                                    <TextBlock Text="{DynamicResource Loc_ShellTab_Home}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="{DynamicResource Loc_Shell_NavSystemSection}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnDarkMuted}"
                                       Margin="22,20,22,6"/>

                            <RadioButton Style="{DynamicResource NavButton}"
                                         GroupName="ShellNav"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="eventlog"
                                         IsChecked="{Binding CurrentNavId, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=eventlog, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon IconSize="14" Source="/Assets/lucide/copy.svg"/>
                                    <TextBlock Text="{DynamicResource Loc_Activity_EventLog}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{DynamicResource NavButton}"
                                         GroupName="ShellNav"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="modules"
                                         IsChecked="{Binding CurrentNavId, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=modules, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon IconSize="14" Source="/Assets/lucide/package.svg"/>
                                    <TextBlock Text="{DynamicResource Loc_Activity_Modules}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{DynamicResource NavButton}"
                                         GroupName="ShellNav"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="settings"
                                         IsChecked="{Binding CurrentNavId, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=settings, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon IconSize="14" Source="/Assets/lucide/settings.svg"/>
                                    <TextBlock Text="{DynamicResource Loc_Activity_Settings}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3"
                        Margin="12"
                        Background="{DynamicResource SurfaceSidebarDeep}"
                        CornerRadius="4"
                        Padding="10,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceSwitching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Shell_FooterTitle}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextOnDarkMuted}"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusBuildText}"
                                       FontFamily="Consolas, Cascadia Mono"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextOnDark}"/>
                            <TextBlock Text=" · "
                                       FontSize="11"
                                       Foreground="{DynamicResource TextOnDarkMuted}"/>
                            <TextBlock Text="{Binding StatusDeviceText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextOnDarkMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="0"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderLight}"
                      Cursor="SizeWE"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- 主內容區 -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="3"
                          Visibility="{Binding IsWorkspaceSwitching, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{Binding ActiveWorkspaceName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock Text=" / "
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Opacity="0.5"/>
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentNavId}" Value="overview">
                                                <Setter Property="Text" Value="{DynamicResource Loc_ShellTab_Home}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentNavId}" Value="eventlog">
                                                <Setter Property="Text" Value="{DynamicResource Loc_Activity_EventLog}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentNavId}" Value="modules">
                                                <Setter Property="Text" Value="{DynamicResource Loc_Activity_Modules}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentNavId}" Value="settings">
                                                <Setter Property="Text" Value="{DynamicResource Loc_Activity_Settings}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentNavId}" Value="overview">
                                            <Setter Property="Text" Value="{DynamicResource Loc_ShellTab_Home}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentNavId}" Value="eventlog">
                                            <Setter Property="Text" Value="{DynamicResource Loc_Activity_EventLog}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentNavId}" Value="modules">
                                            <Setter Property="Text" Value="{DynamicResource Loc_Activity_Modules}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentNavId}" Value="settings">
                                            <Setter Property="Text" Value="{DynamicResource Loc_Activity_Settings}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Height="32"
                            Width="340"
                            Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource BorderMedium}"
                            BorderThickness="1"
                            CornerRadius="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <shell:SvgIcon Grid.Column="0"
                                           IconSize="13"
                                           Source="/Assets/lucide/search.svg"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            <TextBox Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimary}"
                                     VerticalContentAlignment="Center"
                                     FontSize="12"
                                     ToolTip="{DynamicResource Loc_GlobalSearch_Hint}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Button Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="{DynamicResource Loc_Shell_Tooltip_Notifications}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                            <Grid>
                                                <shell:SvgIcon IconSize="14"
                                                               Source="/Assets/lucide/bell.svg"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                <Border MinWidth="14"
                                                        Height="14"
                                                        Background="{DynamicResource StatusDanger}"
                                                        CornerRadius="7"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,4,2,0"
                                                        Padding="3,0"
                                                        Visibility="{Binding ShowNotificationBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding UnreadCount}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <Button Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                ToolTip="{DynamicResource Loc_Shell_Tooltip_Help}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                        <shell:SvgIcon IconSize="14"
                                                       Source="/Assets/lucide/circle-question-mark.svg"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    </Grid>

                    <Grid Grid.ColumnSpan="3"
                          Background="{DynamicResource SurfaceRaised}"
                          Visibility="{Binding IsWorkspaceSwitching, Converter={StaticResource BoolToVisibility}}"
                          IsHitTestVisible="False">
                        <shell:SkeletonShimmer SkeletonHeight="20"
                                               SkeletonWidth="260"
                                               CornerRadius="4"
                                               Margin="0,18,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               BaseBackground="{DynamicResource SkeletonBase}"
                                               IsActive="True"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="{DynamicResource SurfaceBase}">
                <ContentControl x:Name="MainContent"
                                Visibility="{Binding IsWorkspaceSwitching, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ScrollViewer Visibility="{Binding IsWorkspaceSwitching, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto"
                              Panel.ZIndex="20"
                              Background="{DynamicResource SurfaceBase}">
                    <StackPanel Margin="24">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Ellipse Width="14"
                                     Height="14"
                                     Stroke="{DynamicResource AccentPrimary}"
                                     StrokeThickness="2"
                                     StrokeDashArray="4 18"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LoadingSpinnerRotate"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LoadingSpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding WorkspaceLoadingText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{DynamicResource Card}" Margin="0,0,16,0" Padding="18" MinHeight="116">
                                <StackPanel>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="120" UseStretch="False" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="12" UseStretch="True" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource Card}" Margin="0,0,16,0" Padding="18" MinHeight="116">
                                <StackPanel>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="80" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="160" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource Card}" Padding="18" MinHeight="116">
                                <StackPanel>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="120" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="12" UseStretch="True" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="20" MinHeight="260">
                                <StackPanel>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="100" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="180" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="20" MinHeight="260">
                                <StackPanel>
                                    <shell:SkeletonShimmer SkeletonHeight="12" SkeletonWidth="120" Margin="0,0,0,10" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                    <shell:SkeletonShimmer SkeletonHeight="54" UseStretch="True" Margin="0,14,0,0" BaseBackground="{DynamicResource SkeletonBase}" IsActive="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 狀態列 -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{DynamicResource SurfaceStatusBar}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <shell:SvgIcon IconSize="11"
                                   Source="/Assets/lucide/layers.svg"
                                   Foreground="{DynamicResource TextOnDarkMuted}"
                                   Opacity="0.65"/>
                    <TextBlock Text="{Binding ActiveWorkspaceName}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnDark}"
                               Margin="5,0,0,0"/>
                    <Border Width="1"
                            Height="14"
                            Background="{DynamicResource TextOnDarkMuted}"
                            Opacity="0.35"
                            Margin="14,0"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusSuccess}" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextOnDark}"
                               Opacity="0.75"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource FormatString}">
                                            <Binding Source="{StaticResource LocShellStatusModulesRunningProxy}" Path="Value"/>
                                            <Binding Path="ModulesRunningCount"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkspaceSwitching}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Loc_Shell_Status_ModulesUnknown}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextOnDarkMuted}"
                               Opacity="0.75">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FormatString}">
                                <Binding Source="{StaticResource LocShellStatusDeviceProxy}" Path="Value"/>
                                <Binding Path="StatusDeviceText"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Border Width="1"
                            Height="14"
                            Background="{DynamicResource TextOnDarkMuted}"
                            Opacity="0.35"
                            Margin="14,0"/>
                    <TextBlock FontFamily="Consolas, Cascadia Mono"
                               FontSize="11"
                               Foreground="{DynamicResource TextOnDarkMuted}"
                               Opacity="0.75">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FormatString}">
                                <Binding Source="{StaticResource LocShellStatusBuildProxy}" Path="Value"/>
                                <Binding Path="StatusBuildText"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
