<Window x:Class="Helix_Studio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Helix_Studio.Components"
        xmlns:vm="clr-namespace:Helix_Studio.ViewModels"
        xmlns:pages="clr-namespace:Helix_Studio.Views.Pages"
        Title="Helix Studio"
        Width="1280" Height="820"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BrushSidebar}"
        FontFamily="Segoe UI, Microsoft JhengHei UI"
        FontSize="13"
        Foreground="{DynamicResource BrushForegroundPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AppListViewModel}"><pages:AppListPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppLibraryViewModel}"><pages:AppLibraryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventLogViewModel}"><pages:EventLogPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolHostViewModel}"><pages:ToolHostPage/></DataTemplate>

        <!-- 深藍工具列按鈕：hover 用側欄深色 -->
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualNone}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDarkMuted}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushSidebarHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 關閉按鈕：hover 變紅 -->
        <Style x:Key="ToolbarCloseButtonStyle" BasedOn="{StaticResource ToolbarIconButtonStyle}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushStatusRed}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.FontScale}" ScaleY="{Binding Settings.FontScale}"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ═══ 頂部工具列（Row 0，深藍，全寬） ═══ -->
        <Grid Grid.Row="0" Background="{DynamicResource BrushSidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- 0: ≡ 側欄切換 -->
                <ColumnDefinition Width="Auto"/>   <!-- 1: 工作區按鈕 + Popup -->
                <ColumnDefinition Width="Auto"/>   <!-- 2: Q 搜尋命令面板 -->
                <ColumnDefinition Width="Auto"/>   <!-- 3: ← 上一頁 -->
                <ColumnDefinition Width="Auto"/>   <!-- 4: → 下一頁 -->
                <ColumnDefinition Width="*"/>      <!-- 5: 可拖曳空白區 -->
                <ColumnDefinition Width="Auto"/>   <!-- 6: 🔔 通知 -->
                <ColumnDefinition Width="Auto"/>   <!-- 7: 視窗控制 − □ × -->
            </Grid.ColumnDefinitions>

            <!-- ≡ 側欄切換 -->
            <Button Grid.Column="0" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding ToggleSidebarCommand}" ToolTip="{DynamicResource L.Tooltip.CollapseSidebar}">
                <TextBlock Text="☰" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <!-- 工作區按鈕 + Popup -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Button x:Name="WorkspaceSwitchButton" Cursor="Hand" BorderThickness="0" Background="Transparent"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding ToggleWorkspacePopupCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,0"
                                    Height="40" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Workspace.Name}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextOnDark}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                    <shell:SvgIcon x:Name="WsChevron" IconSize="11" Margin="5,0,0,0"
                                                   Source="/Assets/lucide/chevron-down.svg"
                                                   Foreground="{DynamicResource BrushTextOnDarkMuted}" VerticalAlignment="Center">
                                        <shell:SvgIcon.RenderTransform>
                                            <RotateTransform Angle="0" CenterX="5.5" CenterY="5.5"/>
                                        </shell:SvgIcon.RenderTransform>
                                    </shell:SvgIcon>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSidebarHover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsWorkspacePopupOpen}" Value="True">
                                    <Setter TargetName="WsChevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="5.5" CenterY="5.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 工作區切換 Popup -->
                <Popup PlacementTarget="{Binding ElementName=WorkspaceSwitchButton}"
                       Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True"
                       StaysOpen="False" IsOpen="{Binding IsWorkspacePopupOpen, Mode=TwoWay}"
                       VerticalOffset="2" Width="220">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorderMedium}" BorderThickness="1" CornerRadius="4"
                            Margin="0,0,0,8">
                        <StackPanel Margin="0,6">
                            <TextBlock Text="{DynamicResource L.Workspace.Switch}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushForegroundMuted}" Margin="14,4,14,6"/>
                            <ItemsControl ItemsSource="{Binding Workspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 工作區列：選取按鈕（全寬）+ 刪除按鈕（右側覆蓋，平行 sibling） -->
                                        <Grid>
                                            <!-- 選取按鈕（全寬背景） -->
                                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.ActivateWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="14,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrushForegroundPrimary}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                                <Ellipse x:Name="ActiveDot" Width="6" Height="6"
                                                                         Fill="{DynamicResource BrushBrand}" Margin="8,0,0,0"
                                                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource BrushBrandActive}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- 刪除按鈕（覆蓋在右側，z-order 高於主按鈕） -->
                                            <Button x:Name="DeleteBtn" HorizontalAlignment="Right"
                                                    Width="24" Height="24" Margin="0,0,8,0"
                                                    BorderThickness="0" Background="Transparent" Cursor="Hand"
                                                    VerticalAlignment="Center" Visibility="Collapsed"
                                                    Command="{Binding DataContext.Settings.RemoveWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <shell:SvgIcon IconSize="12" Source="/Assets/lucide/trash-2.svg"
                                                               Foreground="{DynamicResource BrushForegroundMuted}"/>
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="DeleteBtn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- + 新增工作區 -->
                            <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                                <Button Background="Transparent" BorderThickness="0" Padding="14,8" Cursor="Hand"
                                        Command="{Binding Settings.AddWorkspaceCommand}"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="AddBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <shell:SvgIcon IconSize="12" Source="/Assets/lucide/plus.svg" Foreground="{DynamicResource BrushBrand}"/>
                                                    <TextBlock Text="{DynamicResource L.Workspace.Add}" FontSize="11" Foreground="{DynamicResource BrushBrand}"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AddBd" Property="Background" Value="{DynamicResource BrushBrandActive}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 可拖曳空白區（滑鼠左鍵拖動 / 雙擊最大化） -->
            <Border Grid.Column="5" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- Q 搜尋（開啟命令面板，Ctrl+K） -->
            <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding OpenCommandPaletteCommand}"
                    Click="OpenCommandPalette_Click"
                    ToolTip="{DynamicResource L.Tooltip.Search}">
                <shell:SvgIcon IconSize="15" Source="/Assets/lucide/search.svg"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <!-- ← 上一頁 -->
            <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}"
                    IsEnabled="{Binding CanGoBack}" Command="{Binding GoBackCommand}"
                    ToolTip="{DynamicResource L.Tooltip.Back}">
                <shell:SvgIcon IconSize="15" Source="/Assets/lucide/arrow-left.svg"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <!-- → 下一頁 -->
            <Button Grid.Column="4" Style="{StaticResource ToolbarIconButtonStyle}"
                    IsEnabled="{Binding CanGoForward}" Command="{Binding GoForwardCommand}"
                    ToolTip="{DynamicResource L.Tooltip.Forward}">
                <shell:SvgIcon IconSize="15" Source="/Assets/lucide/arrow-right.svg"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <!-- 🔔 通知按鈕 -->
            <Button Grid.Column="6" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding ShowNotificationsCommand}" ToolTip="{DynamicResource L.Tooltip.Notifications}">
                <Grid>
                    <shell:SvgIcon IconSize="15" Source="/Assets/lucide/bell.svg"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Border MinWidth="14" Height="14" Background="{DynamicResource BrushStatusRed}" CornerRadius="7"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Padding="3,0"
                            Visibility="{Binding EventLog.HasUnread, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding EventLog.UnreadCount}" FontSize="9" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>

            <!-- 視窗控制：− □ × -->
            <StackPanel Grid.Column="7" Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="MinimizeButton_Click" ToolTip="{DynamicResource L.Tooltip.Minimize}">
                    <TextBlock Text="—" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="MaximizeButton_Click" ToolTip="{DynamicResource L.Tooltip.MaximizeRestore}">
                    <shell:SvgIcon IconSize="12" Source="/Assets/lucide/square.svg"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource ToolbarCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{DynamicResource L.Tooltip.Close}">
                    <shell:SvgIcon IconSize="13" Source="/Assets/lucide/x.svg"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ 主內容區（Row 1）：側欄 + 內容 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 展開側欄（220px，完整導覽 + 工具清單） -->
            <Border Grid.Column="0" Width="220" Background="{DynamicResource BrushSidebar}"
                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <!-- 導覽項目 -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="apps"
                                     IsChecked="{Binding CurrentNavKey, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=apps, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <shell:SvgIcon IconSize="15" Source="/Assets/lucide/layout-grid.svg"/>
                                <TextBlock Text="{DynamicResource L.Nav.Apps}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="library"
                                     IsChecked="{Binding CurrentNavKey, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=library, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <shell:SvgIcon IconSize="15" Source="/Assets/lucide/package.svg"/>
                                <TextBlock Text="{DynamicResource L.Nav.Library}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 事件日誌（含未讀徽章） -->
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="events"
                                     IsChecked="{Binding CurrentNavKey, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=events, Mode=OneWay}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon IconSize="15" Source="/Assets/lucide/bell.svg"/>
                                    <TextBlock Text="{DynamicResource L.Nav.Events}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border MinWidth="16" Height="16" Background="{DynamicResource BrushStatusRed}" CornerRadius="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,0"
                                        Visibility="{Binding EventLog.HasUnread, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding EventLog.UnreadCount}" FontSize="9" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="settings"
                                     IsChecked="{Binding CurrentNavKey, Converter={StaticResource StringEqualsToBoolean}, ConverterParameter=settings, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <shell:SvgIcon IconSize="15" Source="/Assets/lucide/settings.svg"/>
                                <TextBlock Text="{DynamicResource L.Nav.Settings}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 工具清單 -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextOnDarkMuted}"
                                   Margin="22,6,22,4"/>
                        <ItemsControl ItemsSource="{Binding AppList.Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarToolButtonStyle}"
                                            Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Ellipse Grid.Column="1" Width="6" Height="6" Margin="6,0,0,0"
                                                     Fill="{Binding Status, Converter={StaticResource AppStatusToBrush}}"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 底部：系統資源 -->
                    <Border DockPanel.Dock="Bottom" Margin="12" Background="{DynamicResource BrushSidebarDeep}"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextOnDarkMuted}">
                            <Run Text="CPU "/>
                            <Run Text="{Binding Stats.CpuUsagePercent, StringFormat={}{0:0.0}%, Mode=OneWay}"
                                 Foreground="{DynamicResource BrushTextOnDark}"/>
                            <Run Text="  RAM "/>
                            <Run Text="{Binding Stats.MemoryUsedMb, StringFormat={}{0:0} MB, Mode=OneWay}"
                                 Foreground="{DynamicResource BrushTextOnDark}"/>
                        </TextBlock>
                    </Border>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- 收合側欄（48px，icon-only + tooltip） -->
            <Border Grid.Column="0" Width="48" Background="{DynamicResource BrushSidebar}"
                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SidebarCollapsedNavButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="apps"
                            ToolTip="{DynamicResource L.Nav.Apps}">
                        <shell:SvgIcon IconSize="16" Source="/Assets/lucide/layout-grid.svg"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource SidebarCollapsedNavButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="library"
                            ToolTip="{DynamicResource L.Nav.Library}">
                        <shell:SvgIcon IconSize="16" Source="/Assets/lucide/package.svg"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource SidebarCollapsedNavButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="events"
                            ToolTip="{DynamicResource L.Nav.Events}">
                        <shell:SvgIcon IconSize="16" Source="/Assets/lucide/bell.svg"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource SidebarCollapsedNavButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="settings"
                            ToolTip="{DynamicResource L.Nav.Settings}">
                        <shell:SvgIcon IconSize="16" Source="/Assets/lucide/settings.svg"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 主內容 + 工具宿主覆蓋層 -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushShellBar}">
                <ContentControl Content="{Binding CurrentPage}"/>
                <ContentControl Content="{Binding ToolHost}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="{Binding IsToolHostVisible, Converter={StaticResource BoolToVisibility}}"/>
                            <Style.Triggers>
                                <!-- 命令面板開啟時折疊 HwndHost，避免 Win32 HWND 蓋住 WPF 覆蓋層 -->
                                <DataTrigger Binding="{Binding IsCommandPaletteOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ═══ 狀態列（Row 2，藍色，全寬） ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBrand}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <shell:SvgIcon IconSize="11" Source="/Assets/lucide/layers.svg" Foreground="{DynamicResource BrushTextOnDarkMuted}"/>
                    <TextBlock Text="{Binding Workspace.Name}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextOnDark}" Margin="5,0,0,0"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BrushTextOnDarkMuted}" Opacity="0.4" Margin="14,0"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushStatusGreen}" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource BrushTextOnDark}" VerticalAlignment="Center">
                        <Run Text="{DynamicResource L.Status.RunningLabel}"/><Run Text=" "/><Run Text="{Binding AppList.RunningCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextOnDarkMuted}">
                        <Run Text="RAM "/><Run Text="{Binding Stats.MemoryUsedMb, StringFormat={}{0:0} MB, Mode=OneWay}"/>
                        <Run Text="  ·  CPU "/><Run Text="{Binding Stats.CpuUsagePercent, StringFormat={}{0:0.0}%, Mode=OneWay}"/>
                    </TextBlock>
                    <Border Width="1" Height="14" Background="{DynamicResource BrushTextOnDarkMuted}" Opacity="0.4" Margin="14,0"/>
                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrushTextOnDarkMuted}">
                        <Run Text="{DynamicResource L.Status.EventsLabel}"/><Run Text=" "/><Run Text="{Binding EventLog.TotalCount, Mode=OneWay}"/>
                        <Run Text="  ·  "/><Run Text="{Binding StatusBuildText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ═══ 命令面板覆蓋層（Ctrl+K） ═══ -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="200"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <!-- 半透明遮罩，點擊關閉 -->
            <Border Background="{DynamicResource BrushScrim}"
                    MouseLeftButtonDown="CommandPaletteScrim_MouseDown"/>
            <!-- 面板 -->
            <Border MaxWidth="640" Width="640"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                    Background="{DynamicResource BrushSidebarDeep}"
                    BorderBrush="{DynamicResource BrushSidebarHover}" BorderThickness="1"
                    CornerRadius="12">
                <DockPanel>
                    <!-- 搜尋列 -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BrushSidebarHover}" BorderThickness="0,0,0,1">
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <shell:SvgIcon Grid.Column="0" IconSize="16" Source="/Assets/lucide/search.svg"
                                           Foreground="{DynamicResource BrushTextOnDarkMuted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="CommandPaletteInput" Grid.Column="1"
                                     Margin="10,0,0,0" BorderThickness="0" Padding="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource BrushTextOnDark}"
                                     CaretBrush="{DynamicResource BrushTextOnDark}"
                                     SelectionBrush="{DynamicResource BrushBrand}"
                                     FontSize="14" VerticalContentAlignment="Center"
                                     FocusVisualStyle="{StaticResource FocusVisualNone}"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     Text="{Binding CommandPaletteSearch, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                    Padding="4" Margin="8,0,0,0" Cursor="Hand"
                                    FocusVisualStyle="{StaticResource FocusVisualNone}"
                                    Command="{Binding CloseCommandPaletteCommand}">
                                <shell:SvgIcon IconSize="14" Source="/Assets/lucide/x.svg"
                                               Foreground="{DynamicResource BrushTextOnDarkMuted}"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- 結果清單 -->
                    <ListBox x:Name="PaletteList"
                             ItemsSource="{Binding FilteredPaletteItems}"
                             SelectedIndex="{Binding CommandPaletteSelectedIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MaxHeight="400" Padding="6,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualNone}"/>
                                <Setter Property="Padding" Value="12,9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="6"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSidebarHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSidebarHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ExecutePaletteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>
                                    <shell:SvgIcon Grid.Column="0" IconSize="14" Source="{Binding IconPath}"
                                                   Foreground="{DynamicResource BrushTextOnDarkMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextOnDark}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Subtitle}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource BrushTextOnDarkMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
