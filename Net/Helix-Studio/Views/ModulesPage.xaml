<UserControl x:Class="Helix_Studio.Views.ModulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:modulesViews="clr-namespace:Helix_Studio.Components"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource SurfaceBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Modules  ·  模組管理"
                               Style="{DynamicResource SectionTitle}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ModulesDirectoryPath}"
                                   FontSize="11" FontFamily="Consolas, Cascadia Mono"
                                   Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="重新掃描"
                            Command="{Binding RescanCommand}"
                            Style="{DynamicResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,0"/>
                    <Button Style="{DynamicResource GhostButton}"
                            Command="{Binding ImportCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="導入模組" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceSubtle}"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已安裝模組" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource AccentSoft}"
                                    CornerRadius="10" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Items.Count}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimary}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="16"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="尚未安裝模組" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="點選「導入模組」以從本機資料夾安裝"
                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"   Value="0"/>
                                <Setter Property="Margin"    Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderLight}"
                                                    BorderThickness="0,0,0,1" Padding="14,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoft}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource AccentPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="32" Height="32"
                                            Background="{DynamicResource AccentSoft}"
                                            CornerRadius="6" VerticalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding Icon, Converter={StaticResource PngBytesToImageSource}}"
                                                   Width="20" Height="20"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}"/>
                                            <TextBlock Text="&#xECAA;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{DynamicResource AccentPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="10" FontFamily="Consolas, Cascadia Mono"
                                                       Foreground="{DynamicResource TextTertiary}"/>
                                            <Border Background="{DynamicResource StatusSuccessSoft}"
                                                    CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource StatusSuccess}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="選擇左側模組以查看詳細資訊"
                               FontSize="13" Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="32,28"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding SelectedItem}">

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52"
                                    Background="{DynamicResource AccentSoft}"
                                    CornerRadius="10" VerticalAlignment="Top">
                                <Grid>
                                    <Image Source="{Binding Icon, Converter={StaticResource PngBytesToImageSource}}"
                                           Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}"/>
                                    <TextBlock Text="&#xECAA;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="22"
                                               Foreground="{DynamicResource AccentPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="{DynamicResource AccentSoft}"
                                            CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding Version}"
                                                   FontSize="10" FontFamily="Consolas, Cascadia Mono"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimary}"/>
                                    </Border>
                                    <Border Background="{DynamicResource StatusSuccessSoft}"
                                            CornerRadius="3" Padding="6,2" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatusSuccess}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"
                                   LineHeight="20" Margin="0,0,0,20"/>

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                            <StackPanel Margin="16,14">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="開發者" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Author}"
                                               FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource BorderLight}"
                                        BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模組識別碼" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Id}"
                                               FontSize="11" FontFamily="Consolas, Cascadia Mono"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource BorderLight}"
                                        BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最低殼層版本" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MinHostVersion}"
                                               FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="開啟模組"
                                    Command="{Binding DataContext.OpenCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{DynamicResource PrimaryButton}"
                                    Padding="16,8" Margin="0,0,8,0"/>
                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding DataContext.DisableCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Padding="16,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="停用模組" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource DangerButton}"
                                    Command="{Binding DataContext.UninstallCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="移除模組" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <modulesViews:ReadmeViewerDialog MarkdownText="{Binding ReadmeText}"
                                                 AssetPathRoot="{Binding InstalledFolderPath}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
