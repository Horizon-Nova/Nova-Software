<UserControl x:Class="Helix_Studio.Views.EventLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             >

    <Grid Background="{DynamicResource SurfaceBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">

                    <RadioButton x:Name="FilterAll"
                                 Style="{DynamicResource LogFilterButton}"
                                 GroupName="LogFilter" IsChecked="True"
                                 Tag="All"
                                 Command="{Binding SetLevelFilterCommand}"
                                 CommandParameter="All">
                        <TextBlock Text="All" FontSize="12"/>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource LogFilterButton}"
                                 GroupName="LogFilter" Tag="Info"
                                 Command="{Binding SetLevelFilterCommand}"
                                 CommandParameter="Info"
                                 Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusSuccess}" VerticalAlignment="Center"/>
                            <TextBlock Text="Info" FontSize="12" Margin="5,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource LogFilterButton}"
                                 GroupName="LogFilter" Tag="Warning"
                                 Command="{Binding SetLevelFilterCommand}"
                                 CommandParameter="Warning"
                                 Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusWarning}" VerticalAlignment="Center"/>
                            <TextBlock Text="Warning" FontSize="12" Margin="5,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource LogFilterButton}"
                                 GroupName="LogFilter" Tag="Error"
                                 Command="{Binding SetLevelFilterCommand}"
                                 CommandParameter="Error"
                                 Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusDanger}" VerticalAlignment="Center"/>
                            <TextBlock Text="Error" FontSize="12" Margin="5,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource LogFilterButton}"
                                 GroupName="LogFilter" Tag="Debug"
                                 Command="{Binding SetLevelFilterCommand}"
                                 CommandParameter="Debug"
                                 Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="Debug" FontSize="12" Margin="5,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                        CornerRadius="3" Height="32" Width="280" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="8,0,8,0" FontSize="12"
                                 VerticalAlignment="Center"
                                 Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="Hint" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="{DynamicResource Loc_EventLog_SearchPlaceholder}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextTertiary}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Hint}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{DynamicResource GhostButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource GhostButton}" Command="{Binding ExportZipCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Download .zip" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="No log entries" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="System events will appear here as the shell operates."
                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <DataGrid x:Name="LogGrid"
                      AutoGenerateColumns="False"
                      ItemsSource="{Binding Entries}"
                      Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderLight}"
                      Background="{DynamicResource SurfaceRaised}"
                      RowBackground="{DynamicResource SurfaceRaised}"
                      AlternatingRowBackground="{DynamicResource SurfaceSubtle}"
                      BorderThickness="0"
                      FontSize="12">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"   Value="{DynamicResource SurfaceSubtle}"/>
                        <Setter Property="Foreground"   Value="{DynamicResource TextTertiary}"/>
                        <Setter Property="FontSize"     Value="11"/>
                        <Setter Property="FontWeight"   Value="SemiBold"/>
                        <Setter Property="Height"       Value="{DynamicResource UiDataGridHeaderHeight}"/>
                        <Setter Property="Padding"      Value="12,0"/>
                        <Setter Property="BorderBrush"  Value="{DynamicResource BorderLight}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="SeparatorBrush" Value="{DynamicResource BorderLight}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="{DynamicResource UiDataGridRowHeight}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIMESTAMP"
                                        Binding="{Binding TimestampText}"
                                        Width="170"
                                        FontFamily="Consolas, Cascadia Mono"
                                        FontSize="11"/>

                    <DataGridTemplateColumn Header="LEVEL" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="12,0" VerticalAlignment="Center">
                                    <Border x:Name="LvlBadge"
                                            CornerRadius="2" Padding="6,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="LvlText"
                                                   Text="{Binding LevelText}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                        <Setter TargetName="LvlBadge" Property="Background" Value="{DynamicResource StatusSuccessSoft}"/>
                                        <Setter TargetName="LvlText"  Property="Foreground" Value="{DynamicResource StatusSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                        <Setter TargetName="LvlBadge" Property="Background" Value="{DynamicResource StatusWarningSoft}"/>
                                        <Setter TargetName="LvlText"  Property="Foreground" Value="{DynamicResource StatusWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter TargetName="LvlBadge" Property="Background" Value="{DynamicResource StatusDangerSoft}"/>
                                        <Setter TargetName="LvlText"  Property="Foreground" Value="{DynamicResource StatusDanger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Debug">
                                        <Setter TargetName="LvlBadge" Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
                                        <Setter TargetName="LvlText"  Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="SOURCE"
                                        Binding="{Binding Source}"
                                        Width="120"/>

                    <DataGridTextColumn Header="MESSAGE"
                                        Binding="{Binding Message}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

