<Window x:Class="Helix_Studio.Views.WorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBase}"
        FontFamily="Segoe UI, Microsoft JhengHei UI">

    <Window.Resources>
        <Style x:Key="DialogInput" TargetType="TextBox">
            <Setter Property="Height"           Value="34"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background"       Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderMedium}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CaretBrush"       Value="{StaticResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitleText}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Name  ·  名稱"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="TbName"
                     Style="{StaticResource DialogInput}"
                     MaxLength="40"
                     Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Description  ·  描述（選填）"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="TbDesc"
                     Style="{StaticResource DialogInput}"
                     MaxLength="120"
                     Text="{Binding WorkspaceDescription, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <TextBlock Grid.Row="6"
                   Text="{Binding DescriptionCountText}"
                   FontSize="11"
                   Foreground="{StaticResource TextTertiary}"
                   HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="8"
                   Text="{Binding ErrorMessage}"
                   FontSize="12"
                   Foreground="#E53E3E"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    >

            <Button Content="Cancel  取消"
                    Width="100" Height="34"
                    FontSize="13"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderMedium}"
                    Foreground="{StaticResource TextSecondary}"
                    Cursor="Hand"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>

            <Button Content="Save  儲存"
                    Width="100" Height="34"
                    FontSize="13" FontWeight="SemiBold"
                    Background="{StaticResource AccentPrimary}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Window>

