<UserControl x:Class="Helix_Studio.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:Helix_Studio.Components"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1220"
             FontFamily="Segoe UI, Microsoft JhengHei UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             >

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SurfaceBase}">
        <StackPanel Margin="24">

            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Welcome" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TbMachineName" Text="{Binding MachineName}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPrimary}"
                               Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TbSubtitle"
                           Text="{Binding SubtitleText}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">

                <Border Style="{DynamicResource Card}" Margin="0,0,8,0">
                    <Grid Margin="18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/monitor.svg"
                                           Width="14" Height="14"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="SYSTEM" Style="{DynamicResource ColHeader}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TbOsInfo" Grid.Row="1"
                                   Text="{Binding OsInfoShort}"
                                   ToolTip="{Binding OsInfoFull}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TbUptime" Grid.Row="2"
                                   Text="{Binding UptimeText}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource Card}" Margin="4,0">
                    <Grid Margin="18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/layers.svg"
                                           Width="14" Height="14"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVE WORKSPACE" Style="{DynamicResource ColHeader}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TbWorkspaceName" Grid.Row="1"
                                   Text="{Binding WorkspaceName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TbWorkspaceDesc" Grid.Row="2"
                                   Text="{Binding WorkspaceDescription}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource Card}" Margin="8,0,0,0">
                    <Grid Margin="18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/package.svg"
                                           Width="14" Height="14"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="MODULES" Style="{DynamicResource ColHeader}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="TbModuleCount"
                                       Text="{Binding ModuleCountText}" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text=" loaded" FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                        </StackPanel>
                        <TextBlock x:Name="TbModuleStatus" Grid.Row="2"
                                   Text="{Binding ModuleStatusText}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,8,0">
                    <Grid Margin="20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="System Information" Style="{DynamicResource SectionTitle}"/>
                            <TextBlock Text="本機執行環境詳情"
                                       Style="{DynamicResource SectionSubtitle}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="2" Columns="2" Rows="3">

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="DEVICE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock x:Name="InfoDevice" Text="{Binding MachineName}"
                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="OPERATING SYSTEM" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock x:Name="InfoOs" Text="{Binding OsInfoFull}"
                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="BUILD VERSION" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock x:Name="InfoBuild" Text="{Binding BuildVersionText}"
                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="PLATFORM" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Text=".NET 8 · WPF · x64" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="DATA FOLDER" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock x:Name="InfoDataPath" Text="{Binding DataFolderPath}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Consolas, Cascadia Mono"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="LICENSE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusSuccess}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Active · Enterprise"
                                               FontSize="13" Foreground="{DynamicResource StatusSuccess}"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="8,0,0,0">
                    <Grid Margin="20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Quick Actions" Style="{DynamicResource SectionTitle}"/>
                            <TextBlock Text="常用操作"
                                       Style="{DynamicResource SectionSubtitle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">

                            <Button Style="{DynamicResource GhostButton}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Height="56"
                                    Padding="14,10"
                                    Margin="0,0,0,8"
                                    Click="GoToSettings_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <shell:SvgIcon Source="/Assets/lucide/settings.svg"
                                                   Width="14" Height="14"
                                                   Foreground="{DynamicResource AccentPrimary}"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="語言、主題、工作區管理" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource GhostButton}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Height="56"
                                    Padding="14,10"
                                    Margin="0,0,0,8"
                                    Click="GoToWorkspaces_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <shell:SvgIcon Source="/Assets/lucide/layers.svg"
                                                   Width="14" Height="14"
                                                   Foreground="{DynamicResource AccentPrimary}"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Manage Workspaces" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="新增、切換或刪除工作區" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource GhostButton}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Height="56"
                                    Padding="14,10"
                                    Margin="0,0,0,8"
                                    Click="GoToModules_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <shell:SvgIcon Source="/Assets/lucide/package.svg"
                                                   Width="14" Height="14"
                                                   Foreground="{DynamicResource AccentPrimary}"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Modules" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="擴充清單與模組目錄" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource GhostButton}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Height="56"
                                    Padding="14,10"
                                    Click="GoToEventLog_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <shell:SvgIcon Source="/Assets/lucide/scroll-text.svg"
                                                   Width="14" Height="14"
                                                   Foreground="{DynamicResource AccentPrimary}"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Event Log" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="查看系統活動與錯誤記錄" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{DynamicResource Card}" Margin="0,0,0,24">
                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Loaded Modules" Style="{DynamicResource SectionTitle}"/>
                        <TextBlock Text="已載入模組" Style="{DynamicResource SectionSubtitle}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <Border x:Name="ModuleEmptyState" Grid.Row="1"
                            Visibility="{Binding HasModules, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,24">
                            <shell:SvgIcon Source="/Assets/lucide/package.svg"
                                           Width="40" Height="40"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Text="No modules loaded" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Modules will appear here once a DLL is assigned to the active workspace and loaded by the shell."
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="440"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Modules}"
                                  Visibility="{Binding HasModules, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                                    <Grid Margin="14,10,14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36" Height="36"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoft}">
                                            <Grid>
                                                <Image Width="22" Height="22"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding Icon, Converter={StaticResource PngBytesToImageSource}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                </Image.Style>
                                            </Image>
                                            <shell:SvgIcon Source="/Assets/lucide/package.svg"
                                                           Width="16" Height="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentPrimary}">
                                                <shell:SvgIcon.Style>
                                                    <Style TargetType="shell:SvgIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </shell:SvgIcon.Style>
                                            </shell:SvgIcon>
                                        </Grid>
                                    </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Background="{DynamicResource SurfaceSubtle}"
                                                        CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version}" FontSize="9"
                                                               FontFamily="Consolas, Cascadia Mono"
                                                               Foreground="{DynamicResource TextTertiary}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{DynamicResource GhostButton}"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                Tag="{Binding Id}"
                                                Click="OpenModule_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <shell:SvgIcon Source="/Assets/lucide/external-link.svg"
                                                               Width="12" Height="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="開啟" FontSize="11"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

