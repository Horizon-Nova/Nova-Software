<Window x:Class="Helix_Studio.Views.ModuleLicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模組授權金鑰"
        Icon="/Assets/image/AppLogo.png"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBase}"
        FontFamily="Segoe UI, Microsoft JhengHei UI">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20" >
 
        <TextBlock Text="{Binding ModuleDisplayNameText}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>
        <TextBlock Text="此模組需要有效的授權金鑰才能開啟。"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,16"/>

        <Border Background="{DynamicResource StatusDangerSoft}"
                BorderBrush="{DynamicResource StatusDanger}"
                BorderThickness="0,0,0,2"
                CornerRadius="3"
                Padding="10,8"
                Margin="0,0,0,14"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource StatusDanger}"
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock Text="授權金鑰" Style="{StaticResource LabelStyle}"/>
        <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                 Height="32"
                 Padding="8,0"
                 FontSize="12"
                 FontFamily="Consolas, Cascadia Mono, Segoe UI"
                 VerticalContentAlignment="Center"
                 Background="{DynamicResource SurfaceRaised}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderMedium}"
                 BorderThickness="1"
                 Margin="0,0,0,4"
                 />
        <TextBlock Text="格式：GUID:SHA256（由 KeyTool 工具產生）"
                   FontSize="10"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    Width="80" Height="30"
                    FontSize="12"
                    Margin="0,0,8,0"
                    Style="{DynamicResource GhostButton}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding VerifyButtonText}"
                    Width="100" Height="30"
                    FontSize="12"
                    Style="{DynamicResource PrimaryButton}"
                    IsDefault="True"
                    Command="{Binding VerifyCommand}"/>
        </StackPanel>
 
    </StackPanel>
</Window>
