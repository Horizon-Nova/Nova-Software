<UserControl x:Class="Helix_Studio.Views.Pages.AppListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Helix_Studio.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頁首 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BrushShellSeparator}"
                BorderThickness="0,0,0,1" Padding="28,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Nav.Apps}"
                           Foreground="{DynamicResource BrushForegroundPrimary}"
                           FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource L.AppList.Subtitle}"
                           Foreground="{DynamicResource BrushForegroundSecondary}"
                           FontSize="{StaticResource FontSizeCaption}" Margin="0,3,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <!-- CPU 卡 -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushShellSeparator}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,10" MinWidth="160">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.AppList.CpuUsage}"
                                       Foreground="{DynamicResource BrushForegroundSecondary}"
                                       FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock FontSize="{StaticResource FontSizeStat}" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Run Text="{Binding Stats.CpuUsagePercent, StringFormat={}{0:0.0}%, Mode=OneWay}"
                                     Foreground="{DynamicResource BrushBrand}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- 記憶體卡 -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushShellSeparator}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,10" MinWidth="200" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.AppList.MemUsage}"
                                       Foreground="{DynamicResource BrushForegroundSecondary}"
                                       FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock FontSize="{StaticResource FontSizeStat}" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Run Text="{Binding Stats.MemoryUsedMb, StringFormat={}{0:0} MB, Mode=OneWay}"
                                     Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <Run Text="{Binding Stats.MemoryTotalGb, StringFormat={} / {0:0.00} GB, Mode=OneWay}"
                                     Foreground="{DynamicResource BrushForegroundMuted}"
                                     FontSize="{StaticResource FontSizeBody}" FontWeight="Normal"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具列 -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BrushShellSeparator}"
                BorderThickness="0,0,0,1" Padding="28,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource ContentSearchBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource DataToggleStyle}"
                                  IsChecked="{Binding ShowOnlyRunning}"/>
                    <TextBlock Text="{DynamicResource L.AppList.OnlyRunning}" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushForegroundSecondary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 欄標題 -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushShellInset}"
                BorderBrush="{DynamicResource BrushShellSeparator}"
                BorderThickness="0,0,0,1" Padding="16,0,28,0">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{DynamicResource L.Col.Name}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium"
                           Foreground="{DynamicResource BrushForegroundSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource L.Col.Status}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium"
                           Foreground="{DynamicResource BrushForegroundSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{DynamicResource L.Col.Cpu}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium"
                           Foreground="{DynamicResource BrushForegroundSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{DynamicResource L.Col.Memory}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium"
                           Foreground="{DynamicResource BrushForegroundSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{DynamicResource L.Col.LastStarted}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium"
                           Foreground="{DynamicResource BrushForegroundSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{DynamicResource L.Col.Actions}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium"
                           Foreground="{DynamicResource BrushForegroundSecondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 批次動作列：有勾選時浮現 -->
        <Border Grid.Row="3" Panel.ZIndex="1"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Background="{DynamicResource BrushShellBar}"
                BorderBrush="{DynamicResource BrushBrand}" BorderThickness="1"
                CornerRadius="10" Padding="16,8"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushForegroundPrimary}">
                    <Run Text="{DynamicResource L.Bulk.Selected}"/>
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource BrushBrand}" FontWeight="SemiBold"/>
                    <Run Text="{DynamicResource L.Bulk.Items}"/>
                </TextBlock>
                <Rectangle Width="1" Height="18" Fill="{DynamicResource BrushShellSeparator}" Margin="14,0"/>
                <Button Content="{DynamicResource L.Bulk.Start}" Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding BulkStartCommand}"/>
                <Button Content="{DynamicResource L.Bulk.Stop}" Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="6,0,0,0" Command="{Binding BulkStopCommand}"/>
                <Button Content="{DynamicResource L.Bulk.ClearSelection}" Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="6,0,0,0" Command="{Binding ClearSelectionCommand}"/>
            </StackPanel>
        </Border>

        <!-- 清單 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AppsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:InstalledTool}">
                        <Border BorderBrush="{DynamicResource BrushShellSeparator}"
                                BorderThickness="0,0,0,1" Padding="16,0,28,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowRunning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource DataCheckBoxStyle}"
                                          IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushForegroundPrimary}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding Status, Converter={StaticResource AppStatusToBrush}}"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource AppStatusToText}}"
                                               FontSize="{StaticResource FontSizeCaption}" Margin="7,0,0,0" FontWeight="Medium"
                                               Foreground="{Binding Status, Converter={StaticResource AppStatusToBrush}}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding CpuPercent, StringFormat={}{0:0.##}%}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundSecondary}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding MemoryMb, StringFormat={}{0:0} MB}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundSecondary}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="5"
                                           Text="{Binding LastStarted, Converter={StaticResource RelativeTime}}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundSecondary}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="6" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <!-- 詳細/設定 -->
                                    <Button Content="{DynamicResource L.Common.Detail}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- 執行中 / 啟動中：停止 -->
                                    <Button Content="{DynamicResource L.Common.Stop}"
                                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 已停止：啟動 -->
                                    <Button Content="{DynamicResource L.Common.Start}"
                                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 錯誤：重試（啟動） -->
                                    <Button Content="{DynamicResource L.Common.Retry}"
                                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空狀態：尚未安裝任何工具 -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{DynamicResource L.AppList.EmptyTitle}" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushForegroundSecondary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource L.AppList.EmptySubtitle}" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushForegroundMuted}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 工具詳細/設定抽屜：選擇某工具的「詳細」時浮現 -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="3"
              Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource BrushScrim}"/>
            <Border HorizontalAlignment="Right" Width="460"
                    Background="{DynamicResource BrushShellBar}"
                    BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20" DataContext="{Binding DetailTool}">
                        <!-- 標題列 + 關閉 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeDetailTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushForegroundPrimary}" TextWrapping="Wrap"/>
                                <TextBlock FontSize="{StaticResource FontSizeCaption}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource BrushForegroundMuted}">
                                    <Run Text="{Binding Manifest.Category, Mode=OneWay}"/>
                                    <Run Text="  ·  v"/><Run Text="{Binding Manifest.Version, Mode=OneWay}"/>
                                    <Run Text="  ·  "/><Run Text="{Binding Manifest.Author, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" VerticalAlignment="Top"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource BrushShellSeparator}" Margin="0,16"/>

                        <!-- 狀態 + 資源使用 -->
                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <!-- 狀態列 + 啟動/停止 -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource AppStatusToText}}"
                                                   FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium"
                                                   Foreground="{Binding Status, Converter={StaticResource AppStatusToBrush}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <!-- 啟動按鈕（未執行時顯示） -->
                                        <Button Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{DynamicResource L.Common.Start}"/>
                                        </Button>
                                        <!-- 停止按鈕（執行中 / 啟動中時顯示） -->
                                        <Button Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{DynamicResource L.Common.Stop}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- 資源使用（執行中才顯示） -->
                                <TextBlock Visibility="{Binding Status, Converter={StaticResource AppStatusToVisibility}}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundMuted}" Margin="0,4,0,0">
                                    <Run Text="CPU "/>
                                    <Run Text="{Binding CpuPercent, StringFormat={}{0:0.0}%, Mode=OneWay}"/>
                                    <Run Text="  "/><Run Text="{DynamicResource L.Col.Memory}"/><Run Text=" "/>
                                    <Run Text="{Binding MemoryMb, StringFormat={}{0:0} MB, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 工具資訊 -->
                        <TextBlock Text="{DynamicResource L.AppDetail.ToolInfo}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,16,0,8"/>
                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <!-- 上次執行 -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource L.AppDetail.LastRun}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushForegroundSecondary}"/>
                                    <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushForegroundMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding LastStarted, Converter={StaticResource RelativeTime}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastStarted}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{DynamicResource L.AppDetail.NeverRun}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <!-- 安裝日期 -->
                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource L.AppDetail.InstallDate}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushForegroundSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledAt, StringFormat={}{0:yyyy-MM-dd}}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushForegroundMuted}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 近期事件 -->
                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource L.AppDetail.RecentEvents}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushForegroundSecondary}"/>
                            <Button Grid.Column="1" Content="{DynamicResource L.AppDetail.ViewAll}" BorderThickness="0" Background="Transparent"
                                    FontSize="{StaticResource FontSizeCaption}" Cursor="Hand"
                                    Foreground="{DynamicResource BrushBrand}"
                                    Command="{Binding DataContext.ShowToolEventsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Name}"/>
                        </Grid>
                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14,8">
                            <StackPanel>
                                <!-- 事件清單 -->
                                <ItemsControl ItemsSource="{Binding DataContext.DetailToolRecentEvents, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource BrushForegroundMuted}"/>
                                                <Border Grid.Column="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                        Background="{Binding Level, Converter={StaticResource EventLevelToBrush}}">
                                                    <TextBlock Text="{Binding Level, Converter={StaticResource EventLevelToText}}"
                                                               FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource BrushForegroundSecondary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 無事件時 -->
                                <TextBlock Text="{DynamicResource L.AppDetail.NoEvents}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundMuted}"
                                           Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.HasDetailToolRecentEvents, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 啟動參數（真實生效：下次啟動套用） -->
                        <TextBlock Text="{DynamicResource L.AppDetail.LaunchArgs}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,20,0,4"/>
                        <TextBlock Text="{DynamicResource L.AppDetail.LaunchArgsHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushForegroundMuted}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding DataContext.ArgsText, RelativeSource={RelativeSource AncestorType=ScrollViewer}, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BrushShellInset}"
                                 Foreground="{DynamicResource BrushForegroundPrimary}"
                                 BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="1"
                                 CaretBrush="{DynamicResource BrushBrand}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBody}" Padding="8,6"/>
                        <Button Content="{DynamicResource L.Common.SaveSettings}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Command="{Binding DataContext.SaveSettingsCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>

                        <Rectangle Height="1" Fill="{DynamicResource BrushShellSeparator}" Margin="0,18"/>

                        <!-- 操作 -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource L.Common.OpenFolder}" Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                            <Button Content="{DynamicResource L.Common.Uninstall}" Style="{StaticResource DangerActionButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
