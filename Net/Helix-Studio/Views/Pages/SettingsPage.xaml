<UserControl x:Class="Helix_Studio.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Helix_Studio.Models"
             xmlns:shell="clr-namespace:Helix_Studio.Components">

    <UserControl.Resources>
        <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushForegroundSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="8,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBrandActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushBrand}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBrand}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushForegroundMuted}"/>
            <Setter Property="Margin" Value="22,10,22,4"/>
        </Style>

        <!-- 通用 List 行：左說明右控制項，行底分隔線 -->
        <Style x:Key="ListRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushShellSeparator}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,14"/>
        </Style>

        <!-- Toggle Switch（CheckBox 樣式） -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="20">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{DynamicResource BrushShellSeparator}"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="3,0,0,0"
                                     Fill="{DynamicResource BrushForegroundSecondary}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushBrand}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BrushTextOnDark}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="17,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="BrushStatusGreenSoft" Color="#E6F4ED"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BrushShellBar}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左側導覽面板 ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,0,1,0">
            <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}">
                <StackPanel Margin="0,12,0,16">

                    <TextBlock Text="GENERAL" Style="{StaticResource NavGroupHeaderStyle}"/>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource SettingsNavItemStyle}"
                                 GroupName="SettingsNav" IsChecked="True"
                                 Tag="General" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/settings.svg" IconSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L.Settings.Nav.General}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDisplay" Style="{StaticResource SettingsNavItemStyle}"
                                 GroupName="SettingsNav"
                                 Tag="Display" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/monitor.svg" IconSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L.Settings.Nav.Display}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="WORKSPACE" Style="{StaticResource NavGroupHeaderStyle}"/>
                    <RadioButton x:Name="NavWorkspaces" Style="{StaticResource SettingsNavItemStyle}"
                                 GroupName="SettingsNav"
                                 Tag="Workspaces" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/layers.svg" IconSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L.Settings.Nav.Workspaces}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="SYSTEM" Style="{StaticResource NavGroupHeaderStyle}"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource SettingsNavItemStyle}"
                                 GroupName="SettingsNav"
                                 Tag="Log" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/scroll-text.svg" IconSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L.Settings.Nav.Log}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAlerts" Style="{StaticResource SettingsNavItemStyle}"
                                 GroupName="SettingsNav"
                                 Tag="Alerts" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/bell.svg" IconSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L.Settings.Nav.Alerts}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource SettingsNavItemStyle}"
                                 GroupName="SettingsNav"
                                 Tag="About" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <shell:SvgIcon Source="/Assets/lucide/info.svg" IconSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource L.Settings.Nav.About}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右側內容區 ═══ -->
        <ScrollViewer x:Name="ContentScroller" Grid.Column="1"
                      Style="{StaticResource ThinScrollViewerStyle}"
                      Background="{DynamicResource BrushSurface}">
            <StackPanel Margin="32,28,40,28">

                <!-- ─ 一般 ─ -->
                <StackPanel x:Name="SectionGeneral" Margin="0,0,0,44">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource L.Settings.Nav.General}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundPrimary}"/>
                        <TextBlock Text="{DynamicResource L.Settings.General.Subtitle}"
                                   FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0"/>
                    <!-- FL-08 N-001: 介面語言 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Language.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Language.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                                <ComboBoxItem Content="English" Tag="en-US"/>
                                <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <!-- FL-08 N-002: 啟動設定 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.StartOnBoot.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.StartOnBoot.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartWithWindows}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.StartMin.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.StartMin.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartMinimized}"/>
                        </Grid>
                    </Border>
                    <!-- FL-09: 關閉視窗行為 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.CloseToTray.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.CloseToTray.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding CloseToTray}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.ToolStartup.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.ToolStartup.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding ToolStartupBehavior}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource L.Settings.ToolStartup.None}" Tag="none"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.ToolStartup.Restore}" Tag="restore"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.DefaultWorkspace.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.DefaultWorkspace.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      ItemsSource="{Binding Workspaces}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DefaultWorkspaceId}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ─ 顯示 ─ -->
                <StackPanel x:Name="SectionDisplay" Margin="0,0,0,44">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource L.Settings.Nav.Display}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundPrimary}"/>
                        <TextBlock Text="{DynamicResource L.Settings.Display.Subtitle}"
                                   FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0"/>
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Theme.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Theme.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding Theme, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource L.Settings.Theme.Light}" Tag="light"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.Theme.Dark}" Tag="dark"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.Theme.System}" Tag="system"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.FontScale.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.FontScale.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding FontScaleOption, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="90%" Tag="0.9"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.FontScale.Default}" Tag="1.0"/>
                                <ComboBoxItem Content="110%" Tag="1.1"/>
                                <ComboBoxItem Content="125%" Tag="1.25"/>
                                <ComboBoxItem Content="150%" Tag="1.5"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- FL-03 N-007: 工具清單排序 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.ToolSort.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.ToolSort.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding ToolSortRule}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource L.Settings.ToolSort.Custom}" Tag="custom"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.ToolSort.Name}" Tag="name"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.ToolSort.InstalledAt}" Tag="installedAt"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ─ 工作區 ─ -->
                <StackPanel x:Name="SectionWorkspaces" Margin="0,0,0,44">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource L.Settings.Nav.Workspaces}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundPrimary}"/>
                        <TextBlock Text="{DynamicResource L.Settings.Workspaces.Subtitle}"
                                   FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0"/>

                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WorkspaceInfo}">
                                <Border Style="{StaticResource ListRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushForegroundPrimary}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource BrushStatusGreenSoft}"
                                                    CornerRadius="3" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushStatusGreen}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Margin="0,0,6,0"
                                                    Command="{Binding DataContext.SwitchWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <shell:SvgIcon Source="/Assets/lucide/check.svg" IconSize="13"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                   VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource L.Common.Switch}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerActionButtonStyle}"
                                                    Command="{Binding DataContext.RemoveWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <shell:SvgIcon Source="/Assets/lucide/trash-2.svg" IconSize="13"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                   VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource L.Common.Remove}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource ListRowStyle}">
                        <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding AddWorkspaceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <shell:SvgIcon Source="/Assets/lucide/plus.svg" IconSize="13"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource L.Workspace.Add}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- FL-08 N-004: 切換行為 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.SwitchBehavior.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.SwitchBehavior.Desc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding WorkspaceSwitchBehavior}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource L.Settings.SwitchBehavior.StopAll}" Tag="StopAll"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.SwitchBehavior.StopNone}" Tag="StopNone"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ─ 日誌 ─ -->
                <StackPanel x:Name="SectionLog" Margin="0,0,0,44">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource L.Settings.Nav.Log}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundPrimary}"/>
                        <TextBlock Text="{DynamicResource L.Settings.Log.Subtitle}"
                                   FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0"/>

                    <!-- 輸出位置 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.OutputTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.OutputDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,0" Height="34"
                                         Text="{Binding LogOutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding BrowseLogFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <shell:SvgIcon Source="/Assets/lucide/folder.svg" IconSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.Common.Browse}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-005: 記錄格式 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.FormatTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.FormatDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding LogFormat}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="JSONL" Tag="jsonl"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.Log.FormatText}" Tag="text"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-005: 檔案編碼 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.EncodingTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.EncodingDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding LogEncoding, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="UTF-8" Tag="utf8"/>
                                <ComboBoxItem Content="UTF-8 BOM" Tag="utf8bom"/>
                                <ComboBoxItem Content="UTF-16 LE" Tag="utf16le"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- 時間戳記時區 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.TzTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.TzDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding LogTimeFormat, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource L.Settings.Log.TzLocal}" Tag="local"/>
                                <ComboBoxItem Content="UTC" Tag="utc"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-005: 保留期限 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.RetentionTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.RetentionDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      SelectedValue="{Binding LogRetentionOption}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource L.Settings.Log.Days7}" Tag="7"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.Log.Days30}" Tag="30"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.Log.Days90}" Tag="90"/>
                                <ComboBoxItem Content="{DynamicResource L.Settings.Log.Days180}" Tag="180"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-005: 顯示毫秒 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.MsTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.MsDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding LogMilliseconds}"/>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-005: 開啟日誌資料夾 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Log.FolderTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Log.FolderDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding OpenLogFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon Source="/Assets/lucide/folder-open.svg" IconSize="13"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource L.Common.OpenFolder}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ─ 資源警報 ─ -->
                <StackPanel x:Name="SectionAlerts" Margin="0,0,0,44">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource L.Settings.Nav.Alerts}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushForegroundPrimary}"/>
                        <TextBlock Text="{DynamicResource L.Settings.Alerts.Subtitle}"
                                   FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0"/>

                    <!-- FL-08 N-006: CPU 警報 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Alerts.CpuTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Alerts.CpuDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="52" Margin="0,0,4,0" VerticalAlignment="Center"
                                         IsEnabled="{Binding CpuAlertEnabled}"
                                         Text="{Binding CpuAlertThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="%" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushForegroundSecondary}"/>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding CpuAlertEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-006: 記憶體警報 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Alerts.MemTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Alerts.MemDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="52" Margin="0,0,4,0" VerticalAlignment="Center"
                                         IsEnabled="{Binding MemoryAlertEnabled}"
                                         Text="{Binding MemoryAlertThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="%" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushForegroundSecondary}"/>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding MemoryAlertEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FL-08 N-006: 工具層級警報 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.Alerts.ToolTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.Alerts.ToolDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ToolLevelAlertsEnabled}"/>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ─ 關於 ─ -->
                <StackPanel x:Name="SectionAbout" Margin="0,0,0,40">
                    <TextBlock Text="{DynamicResource L.Settings.Nav.About}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushForegroundPrimary}" Margin="0,0,0,12"/>
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,1,0,0"/>

                    <!-- 4 欄版本資訊（label 在上、value 在下） -->
                    <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,0,0,1" Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VERSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushForegroundMuted}"/>
                                <TextBlock Text="{Binding AppVersion}" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{DynamicResource BrushForegroundPrimary}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PLATFORM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushForegroundMuted}"/>
                                <TextBlock Text=".NET 8 · WPF" FontSize="13"
                                           Foreground="{DynamicResource BrushForegroundPrimary}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EDITION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushForegroundMuted}"/>
                                <TextBlock Text="Enterprise" FontSize="13"
                                           Foreground="{DynamicResource BrushForegroundPrimary}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushForegroundMuted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushStatusGreen}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Active" FontSize="13"
                                               Foreground="{DynamicResource BrushStatusGreen}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource L.Settings.About.DataPath}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{Binding HomePath}" FontSize="12" FontFamily="Consolas"
                                           Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding OpenHomeFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <shell:SvgIcon Source="/Assets/lucide/folder-open.svg" IconSize="13"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource L.Common.OpenFolder}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- FL-02 N-007: 備份與還原 -->
                    <Border Style="{StaticResource ListRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource L.Settings.About.BackupTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <TextBlock Text="{DynamicResource L.Settings.About.BackupDesc}" FontSize="12" Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding ExportBackupCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <shell:SvgIcon Source="/Assets/lucide/download.svg" IconSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.Settings.About.BackupExport}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding ImportBackupCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <shell:SvgIcon Source="/Assets/lucide/upload.svg" IconSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.Settings.About.BackupImport}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
