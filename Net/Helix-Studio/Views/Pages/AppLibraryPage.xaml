<UserControl x:Class="Helix_Studio.Views.Pages.AppLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Helix_Studio.Models">
    <UserControl.Resources>
        <!-- 目錄清單項目（頁面專屬） -->
        <Style x:Key="CatalogItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualNone}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,10" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurface}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushShellHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頁首 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BrushShellSeparator}"
                BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.Nav.Library}"
                               Foreground="{DynamicResource BrushForegroundPrimary}"
                               FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource L.Library.Subtitle}"
                               Foreground="{DynamicResource BrushForegroundSecondary}"
                               FontSize="{StaticResource FontSizeCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource L.Library.Import}" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding ImportCommand}"/>
                    <TextBlock Text="{Binding ImportStatus}" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushBrand}" HorizontalAlignment="Right"
                               TextWrapping="Wrap" MaxWidth="300" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主從版面：左清單、右詳細 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：工具清單 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="12,12,12,6"
                             Style="{StaticResource ContentSearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding ToolsView}"
                             SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CatalogItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CatalogTool}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                        <TextBlock Text="{Binding Manifest.Category}" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource BrushForegroundMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- 已安裝勾選標記 -->
                                    <Path Grid.Column="1" Data="M3,8 L6.5,11.5 L13,4.5"
                                          Stroke="{DynamicResource BrushBrand}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="{StaticResource IconSizeNav}" Height="{StaticResource IconSizeNav}" Stretch="Uniform" VerticalAlignment="Center"
                                          Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：詳細介紹 + 裝卸 + 設定 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="28,24" DataContext="{Binding SelectedTool}">
                    <!-- 標題列 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeDetailTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                <Border Background="{DynamicResource BrushBrandActive}" CornerRadius="4"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Manifest.Category}" FontSize="{StaticResource FontSizeMicro}"
                                               Foreground="{DynamicResource BrushBrand}" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource BrushForegroundMuted}">
                                <Run Text="v"/><Run Text="{Binding Manifest.Version, Mode=OneWay}"/>
                                <Run Text="  ·  "/><Run Text="{Binding Manifest.Author, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- 安裝 / 解除安裝 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{DynamicResource L.Common.Install}"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource L.Common.Uninstall}" Style="{StaticResource DangerActionButtonStyle}"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 權限預告：安裝前告知所需權限 -->
                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0"
                            Visibility="{Binding Manifest.RequiresAdmin, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource L.Library.UacWarning}"
                                   FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushStatusAmber}"/>
                    </Border>

                    <Rectangle Height="1" Fill="{DynamicResource BrushShellSeparator}" Margin="0,18"/>

                    <!-- 詳細介紹 -->
                    <TextBlock Text="{DynamicResource L.Library.Description}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushForegroundSecondary}"/>
                    <TextBlock Text="{Binding Manifest.Description}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"
                               LineHeight="22" Foreground="{DynamicResource BrushForegroundPrimary}"
                               Margin="0,8,0,0"/>

                    <!-- 執行資訊 -->
                    <TextBlock Text="{DynamicResource L.Library.RunInfo}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushForegroundSecondary}" Margin="0,20,0,8"/>
                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.Library.EntryPoint}" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Manifest.Entry}" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushForegroundPrimary}" FontFamily="Consolas"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
