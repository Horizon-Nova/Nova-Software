<UserControl x:Class="Helix_Studio.Views.Pages.EventLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Helix_Studio.Models">
    <UserControl.Resources>
        <!-- 等級篩選 chip -->
        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualNone}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="EventLevel"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushForegroundSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="{DynamicResource BrushSurface}" CornerRadius="6"
                                BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="1"
                                Padding="12,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BrushBrandActive}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource BrushBrand}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushBrand}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource BrushBrand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 單列：點擊展開（無按鈕外框） -->
        <Style x:Key="LogRowToggleStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualNone}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushShellHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 容器右上角複製圖示鈕 -->
        <Style x:Key="CopyIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualNone}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{DynamicResource L.Common.Copy}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="Transparent" CornerRadius="6" Padding="5">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="12" Height="12"
                                               RadiusX="2" RadiusY="2"
                                               Stroke="{DynamicResource BrushForegroundSecondary}" StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="12" Height="12"
                                               RadiusX="2" RadiusY="2"
                                               Stroke="{DynamicResource BrushForegroundSecondary}" StrokeThickness="1.8"
                                               Fill="{DynamicResource BrushShellInset}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="{DynamicResource BrushShellHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頁首 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BrushShellSeparator}"
                BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.Nav.Events}"
                               Foreground="{DynamicResource BrushForegroundPrimary}"
                               FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource L.EventLog.Subtitle}"
                               Foreground="{DynamicResource BrushForegroundSecondary}"
                               FontSize="{StaticResource FontSizeCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource L.EventLog.MarkAllRead}" Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding MarkAllReadCommand}"/>
                    <Button Content="{DynamicResource L.EventLog.Export}" Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="8,0,0,0" Command="{Binding ExportCommand}"/>
                    <Button Content="{DynamicResource L.EventLog.Clear}" Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="8,0,0,0" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具列：搜尋 + 類別/等級篩選 -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BrushShellSeparator}"
                BorderThickness="0,0,0,1" Padding="28,10">
            <StackPanel>
                <TextBox Style="{StaticResource ContentSearchBoxStyle}" Width="280" HorizontalAlignment="Left"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 類別 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.EventLog.CategoryLabel}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushForegroundMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="EventCategory" Content="{DynamicResource L.Common.All}" IsChecked="True"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="all"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="EventCategory" Content="{DynamicResource L.Event.Category.System}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="system"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="EventCategory" Content="{DynamicResource L.Event.Category.Install}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="install"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="EventCategory" Content="{DynamicResource L.Event.Category.Runtime}" Margin="0"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="runtime"/>
                    </StackPanel>
                    <!-- 等級 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.EventLog.LevelLabel}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushForegroundMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" Content="{DynamicResource L.Common.All}" IsChecked="True"
                                     Command="{Binding SetLevelCommand}" CommandParameter="all"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" Content="{DynamicResource L.Event.Level.Info}"
                                     Command="{Binding SetLevelCommand}" CommandParameter="info"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" Content="{DynamicResource L.Event.Level.Warning}"
                                     Command="{Binding SetLevelCommand}" CommandParameter="warning"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" Content="{DynamicResource L.Event.Level.Error}" Margin="0"
                                     Command="{Binding SetLevelCommand}" CommandParameter="error"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 日誌清單：單列 + 右側 chevron 展開 code block 容器 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EntriesView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:EventLogEntry}">
                        <Border BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <!-- 單列 -->
                                <ToggleButton x:Name="Row" Style="{StaticResource LogRowToggleStyle}">
                                    <Grid Margin="28,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Background="{Binding Level, Converter={StaticResource EventLevelToBrush}}">
                                            <TextBlock Text="{Binding Level, Converter={StaticResource EventLevelToText}}"
                                                       FontSize="{StaticResource FontSizeMicro}" FontWeight="Medium" Foreground="White"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeCaption}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Category, Converter={StaticResource EventCategoryToText}, Mode=OneWay}"
                                                 Foreground="{DynamicResource BrushForegroundMuted}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Source, Mode=OneWay}" FontWeight="Medium"
                                                 Foreground="{DynamicResource BrushForegroundPrimary}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushForegroundSecondary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource BrushForegroundMuted}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <!-- 右側 chevron（展開時轉向） -->
                                        <Path Grid.Column="4" Data="M0,0 L4,4 L8,0"
                                              Stroke="{DynamicResource BrushForegroundMuted}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="8" Height="4" Stretch="Fill"
                                              VerticalAlignment="Center" Margin="14,0,0,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=Row}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ToggleButton>

                                <!-- 展開：code block 容器（完整內容 + 複製，過長水平捲動） -->
                                <Border Background="{DynamicResource BrushSurface}" Padding="28,0,28,14"
                                        Visibility="{Binding IsChecked, ElementName=Row, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{DynamicResource BrushShellInset}" CornerRadius="8"
                                            BorderBrush="{DynamicResource BrushShellSeparator}" BorderThickness="1">
                                        <Grid>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled" Padding="14,12">
                                                <TextBlock Text="{Binding Message}" FontFamily="Consolas"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource BrushForegroundPrimary}"
                                                           TextWrapping="NoWrap" Margin="0,0,32,0"/>
                                            </ScrollViewer>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                    Style="{StaticResource CopyIconButtonStyle}"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
