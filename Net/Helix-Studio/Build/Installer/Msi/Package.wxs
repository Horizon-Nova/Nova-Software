<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode 一經發佈即不得變更：它是 Windows 辨識「同一個產品的不同版本」的依據。 -->
  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="B91554BB-88A6-4BE4-8809-15F8FBFB5469"
           Scope="perMachine"
           Compressed="yes"
           Codepage="65001">

    <MajorUpgrade DowngradeErrorMessage="已安裝較新版本的 $(var.ProductName)。" />

    <!-- cab 內嵌進 msi，散佈時只有一個檔案。 -->
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="$(var.ProductName)" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishRoot)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Directory="ShortcutFolder" Guid="7C1D5E28-3A94-4F60-B2D7-6E8A0C4B9153">
        <Shortcut Id="StartMenuShortcut"
                  Name="$(var.ProductName)"
                  Target="[INSTALLFOLDER]Vaeron.HelixStudio.App.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
