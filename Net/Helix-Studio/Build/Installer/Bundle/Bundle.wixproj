<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>HelixStudio-Setup</OutputName>
    <OutputPath>$(ArtifactsDir)\</OutputPath>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants>MsiFile=$(ArtifactsDir)\HelixStudio.msi;ProductName=$(Product);Manufacturer=$(Company);ProductVersion=$(VersionPrefix);Copyright=$(Copyright);IconFile=$(MSBuildThisFileDirectory)..\..\..\Assets\Vaeron_icon.ico;LogoFile=$(MSBuildThisFileDirectory)..\..\..\Assets\Vaeron_logo_64.png</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
