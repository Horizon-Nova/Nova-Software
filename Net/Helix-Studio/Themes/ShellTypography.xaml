<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="ColHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource Ui_FontSize_ColHeader}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource Ui_FontSize_SectionTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="SectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource Ui_FontSize_SectionSubtitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="Margin"     Value="0,2,0,0"/>
    </Style>

    <Style x:Key="SettingsLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource Ui_FontSize_SettingsLabel}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="SettingsLabelZh" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="{DynamicResource Ui_FontSize_SettingsLabelZh}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextTertiary}"/>
        <Setter Property="Margin"           Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsDescription" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="{DynamicResource Ui_FontSize_SettingsDescription}"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin"      Value="0,4,0,0"/>
        <Setter Property="LineHeight"  Value="{DynamicResource Ui_LineHeight_SettingsDescription}"/>
    </Style>

    <Style x:Key="SettingsMeta" TargetType="TextBlock">
        <Setter Property="FontSize"  Value="{DynamicResource Ui_FontSize_SettingsMeta}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="Margin"    Value="0,8,0,0"/>
    </Style>

    <Style x:Key="SettingsNavGroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource Ui_FontSize_SettingsNavGroupHeader}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="Margin"     Value="24,16,16,6"/>
    </Style>

</ResourceDictionary>
