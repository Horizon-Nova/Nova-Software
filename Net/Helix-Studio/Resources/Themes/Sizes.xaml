<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ─── 字級（改這裡，全 app 對應字體一起變） ─── -->
    <sys:Double x:Key="FontSizeDetailTitle">22</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeStat">18</sys:Double>
    <sys:Double x:Key="FontSizeHeading">15</sys:Double>
    <sys:Double x:Key="FontSizeLabel">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeTiny">9</sys:Double>

    <!-- ─── Icon／圓點尺寸 ─── -->
    <sys:Double x:Key="IconSizeLogo">32</sys:Double>
    <sys:Double x:Key="IconSizeTopBar">18</sys:Double>
    <sys:Double x:Key="IconSizeNav">16</sys:Double>
    <sys:Double x:Key="IconSizeInline">14</sys:Double>
    <sys:Double x:Key="DotSize">8</sys:Double>
    <sys:Double x:Key="DotSizeSmall">7</sys:Double>

</ResourceDictionary>
