<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        色彩 token：主色取自舊版(深藍側欄 + 藍色強調 + 淺底白卡 + 深色文字)。
        改此處即全域換色。每個 key 只定義一次，不重複。
    -->

    <!-- ── 品牌/強調(藍) ── -->
    <SolidColorBrush x:Key="BrushBrand"        Color="#0F4C81"/>
    <SolidColorBrush x:Key="BrushBrandHover"   Color="#0D5F9E"/>
    <SolidColorBrush x:Key="BrushBrandActive"  Color="#E7EEF5"/>
    <SolidColorBrush x:Key="BrushBrandPressed" Color="#0A3A63"/>

    <!-- ── 側欄(深藍) ── -->
    <SolidColorBrush x:Key="BrushSidebar"      Color="#1E2530"/>
    <SolidColorBrush x:Key="BrushSidebarDeep"  Color="#151A23"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#252D3A"/>

    <!-- ── 內容表面(淺) ── -->
    <SolidColorBrush x:Key="BrushShellBar"    Color="#F5F6F8"/>
    <SolidColorBrush x:Key="BrushSurface"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurfaceAlt"  Color="#FAFBFC"/>
    <SolidColorBrush x:Key="BrushShellInset"  Color="#EEF1F5"/>
    <SolidColorBrush x:Key="BrushShellHover"  Color="#E9EDF3"/>
    <SolidColorBrush x:Key="BrushRowRunning"  Color="#E3F0E8"/>

    <!-- ── 邊框 ── -->
    <SolidColorBrush x:Key="BrushShellSeparator" Color="#E3E6EC"/>
    <SolidColorBrush x:Key="BrushBorderMedium"   Color="#CDD3DC"/>

    <!-- ── 文字(淺底深字 / 深底亮字) ── -->
    <SolidColorBrush x:Key="BrushForegroundPrimary"   Color="#1A1F2C"/>
    <SolidColorBrush x:Key="BrushForegroundSecondary" Color="#5A6576"/>
    <SolidColorBrush x:Key="BrushForegroundMuted"     Color="#8A94A6"/>
    <SolidColorBrush x:Key="BrushTextOnDark"          Color="#E8ECF2"/>
    <SolidColorBrush x:Key="BrushTextOnDarkMuted"     Color="#8994A8"/>

    <!-- ── 狀態色 ── -->
    <SolidColorBrush x:Key="BrushStatusGreen" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="BrushStatusAmber" Color="#C88400"/>
    <SolidColorBrush x:Key="BrushStatusRed"   Color="#B3261E"/>

    <!-- ── 危險互動態 ── -->
    <SolidColorBrush x:Key="BrushDangerHover"   Color="#C0392B"/>
    <SolidColorBrush x:Key="BrushDangerPressed" Color="#922B21"/>

    <!-- ── 模態遮罩 ── -->
    <SolidColorBrush x:Key="BrushScrim" Color="#66000000"/>

</ResourceDictionary>
