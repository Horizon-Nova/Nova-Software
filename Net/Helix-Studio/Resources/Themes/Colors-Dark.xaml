<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主題 token：側欄保持深藍不變（品牌元素），內容區改為深色背景與淺色文字。
        改此處即全域換色。每個 key 與 Colors.xaml 一一對應。
    -->

    <!-- ── 品牌/強調(藍) ── -->
    <SolidColorBrush x:Key="BrushBrand"        Color="#0F4C81"/>
    <SolidColorBrush x:Key="BrushBrandHover"   Color="#0D5F9E"/>
    <SolidColorBrush x:Key="BrushBrandActive"  Color="#1A3050"/>
    <SolidColorBrush x:Key="BrushBrandPressed" Color="#0A3A63"/>

    <!-- ── 側欄(深藍，與淺色主題相同) ── -->
    <SolidColorBrush x:Key="BrushSidebar"      Color="#1E2530"/>
    <SolidColorBrush x:Key="BrushSidebarDeep"  Color="#151A23"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#252D3A"/>

    <!-- ── 內容表面(深) ── -->
    <SolidColorBrush x:Key="BrushShellBar"    Color="#1E2434"/>
    <SolidColorBrush x:Key="BrushSurface"     Color="#252C3A"/>
    <SolidColorBrush x:Key="BrushSurfaceAlt"  Color="#1E2530"/>
    <SolidColorBrush x:Key="BrushShellInset"  Color="#161C28"/>
    <SolidColorBrush x:Key="BrushShellHover"  Color="#2A3448"/>
    <SolidColorBrush x:Key="BrushRowRunning"  Color="#1A2D24"/>

    <!-- ── 邊框 ── -->
    <SolidColorBrush x:Key="BrushShellSeparator" Color="#2A3448"/>
    <SolidColorBrush x:Key="BrushBorderMedium"   Color="#3A4A62"/>

    <!-- ── 文字(深底亮字) ── -->
    <SolidColorBrush x:Key="BrushForegroundPrimary"   Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushForegroundSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushForegroundMuted"     Color="#64748B"/>
    <SolidColorBrush x:Key="BrushTextOnDark"          Color="#E8ECF2"/>
    <SolidColorBrush x:Key="BrushTextOnDarkMuted"     Color="#8994A8"/>

    <!-- ── 狀態色 ── -->
    <SolidColorBrush x:Key="BrushStatusGreen" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="BrushStatusAmber" Color="#C88400"/>
    <SolidColorBrush x:Key="BrushStatusRed"   Color="#B3261E"/>

    <!-- ── 危險互動態 ── -->
    <SolidColorBrush x:Key="BrushDangerHover"   Color="#C0392B"/>
    <SolidColorBrush x:Key="BrushDangerPressed" Color="#922B21"/>

    <!-- ── 模態遮罩 ── -->
    <SolidColorBrush x:Key="BrushScrim" Color="#80000000"/>

</ResourceDictionary>
