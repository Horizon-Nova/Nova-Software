    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#FF111416" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#FF060809" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#FF212528" />
