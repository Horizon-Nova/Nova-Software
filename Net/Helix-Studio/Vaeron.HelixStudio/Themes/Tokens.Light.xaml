<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        亮色主題的可替換 token——同一組 Key 也存在於 Tokens.Dark.xaml，執行期由
        Settings（外觀 > 主題模式）觸發 App.xaml.cs 的 MergedDictionaries 整包替換。
        套用畫面一律用 DynamicResource 引用這些 Key（見 xaml-style.md 判準：主題可切換 → DynamicResource）。
    -->

    <SolidColorBrush x:Key="BgPageBrush" Color="#FFFBFCFD" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#FFFCFEFF" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#FFF1F4F6" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#FFE4E8EB" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FFD4D8DB" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE2E5E8" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#FFDBDFE2" />
    <SolidColorBrush x:Key="Text1Brush" Color="#FF171B1F" />
    <SolidColorBrush x:Key="Text2Brush" Color="#FF595E63" />
    <SolidColorBrush x:Key="Text3Brush" Color="#FF82878B" />
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#FFFFD9D1" />
    <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#FFAC3225" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#FFFAE1B8" />
    <SolidColorBrush x:Key="StatusWarningTextBrush" Color="#FF7B4D00" />

</ResourceDictionary>
