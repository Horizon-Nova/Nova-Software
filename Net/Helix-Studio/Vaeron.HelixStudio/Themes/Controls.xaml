<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:Vaeron.HelixStudio.Themes">

    <!-- 跨畫面共用控制項樣式——按鈕/輸入框/卡片/開關，7 個畫面共用同一組視覺語言。 -->

    <!-- 跨畫面共用轉換器，見 CommonConverters.cs -->
    <themes:InverseBoolConverter x:Key="InverseBoolConverter" />
    <themes:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <themes:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <themes:CountToEmptyVisibilityConverter x:Key="CountToEmptyVisibilityConverter" />
    <themes:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <themes:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

    <!-- 鍵盤焦點框——對應 blueprint 全站一致的 style-focus="outline:2px solid accent 色；
         outline-offset:2px"，取代 WPF 預設的黑色虛線焦點框（兩者是完全不同的視覺語言，
         不覆寫的話每個互動元素 Tab focus 起來都是虛線框，跟 blueprint 對不上）。 -->
    <Style x:Key="AccentFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentSolidBrush}" BorderThickness="2"
                            Margin="-2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 沒有指定具名 Style 的一般控制項（畫面裡直接寫 &lt;CheckBox&gt;/&lt;ComboBox&gt; 沒有套用
         AppTextBoxStyle 這類具名樣式的）預設走這裡——implicit Style（無 x:Key，用 TargetType 當隱含鍵）
         只在元素沒有明確 Style 屬性時生效，具名樣式（PrimaryButtonStyle 那條鏈）各自另外設。 -->
    <Style TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
    </Style>

    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentOnSolidBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSolidHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 對齊 blueprint 頂部列圖示按鈕：無邊框、預設透明背景，只有 hover 才出現底色，
         不是 SecondaryButtonStyle 那種常駐邊框卡片按鈕。繼承 SecondaryButtonStyle 只是為了
         共用 Template 結構與 hover/disabled triggers，這裡要覆寫掉 Background／BorderThickness，
         否則每個圖示按鈕（選單/搜尋/上下頁/通知鈴鐺/重新整理…）都會多一個不該出現的方框。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Width" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 破壞性動作按鈕（移除/刪除）——對應 blueprint AppsScreen.dc.html 的「移除」按鈕：
         danger-border 邊框、status-error-text 文字色，不是一般 SecondaryButtonStyle
         的黑框黑字，要讓使用者一眼看出這顆按鈕的動作不可逆。 -->
    <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>

    <!-- 次要按鈕的「已選取」視覺——對齊 blueprint app.selectedStyle（accent-tint 底、
         accent-border 框、accent-text 字），目前只有 AppsManagement 的「詳細」按鈕在用，
         但這是通用的「可選取項目」樣式（跟篩選 pill 的 Primary/Secondary 二選一不同，
         這裡選中態要維持 outline 而非填滿），放共用 Controls.xaml 供未來同類情境延用。 -->
    <Style x:Key="SecondarySelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>

    <!-- 分頁按鈕（摘要／設定這類 tab）——扁平文字＋底線指示目前選取項，跟一般按鈕
         （常駐邊框/底色）是不同的視覺語彙，故獨立一份樣式，不從 SecondaryButtonStyle 派生。
         選中態的顏色/底線由呼叫端用 DataTrigger 覆寫（見 AppsManagementView.xaml），這裡只
         定義未選中的預設樣子跟共用的排版/游標。 -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,5">
                        <ContentPresenter HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 「整列可點擊」的欄位按鈕——AppsManagement 設定 tab 的自動啟動/自動修復兩列，
         整列（含右側開關）都要能接收點擊才能攔截「鎖定欄位」的情境（見 fieldClick 判準），
         不能只有開關本身可點。無邊框無底色，行為上是按鈕、視覺上不像按鈕。 -->
    <Style x:Key="FieldRowButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 骨架屏跳動動畫與色塊樣式——對齊 blueprint 的 skeletonPulse（1.4s ease-in-out
         infinite，透明度來回跳動），單一定義處供 AppsManagement／EventLog 等清單畫面共用，
         不必每個畫面各自刻一份 Storyboard。 -->
    <Storyboard x:Key="SkeletonPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.45" Duration="0:0:0.7" />
    </Storyboard>
    <Style x:Key="SkeletonBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SkeletonBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource SkeletonPulseStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- 提示文字疊在 TextBox 底層，只在 Text 為空時顯示——標準 TextBox 沒有內建
         PlaceholderText，用附加屬性（TextBoxPlaceholder.Text，見同名 .cs）+ 自訂 Template
         補上，畫面端只要設 themes:TextBoxPlaceholder.Text="搜尋..." 就好，不用逐個畫面
         各自刻一份疊字技巧。 -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock Text="{Binding Path=(themes:TextBoxPlaceholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- PasswordBox 版的輸入框樣式——跟 AppTextBoxStyle 同一套邊框/字型 chrome，PasswordBox
         同樣有 PART_ContentHost 可以走 ScrollViewer 樣板，差別只在沒有 TextBoxPlaceholder
         那層疊字（密碼框不適合疊明文提示），呼叫端改用一般 TextBlock 標籤放在上方。 -->
    <Style x:Key="AppPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 開關（ToggleButton 樣式化成 switch 外觀）：對應 blueprint 大量出現的 toggle 控制（autoStart/autoRepair/通知等） -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource BorderBrush2}">
                        <Border x:Name="Knob" Width="16" Height="16" Margin="2" CornerRadius="8"
                                Background="{DynamicResource BgSurfaceBrush}" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
