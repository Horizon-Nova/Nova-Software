<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        21 個圖示，直接從 .claude/blueprint/components/Icon.dc.html 的 <svg> 原始座標資料轉成
        WPF PathGeometry——不是憑記憶猜 Segoe Fluent Icons 字元碼（先前那版的問題就是這樣來的）。
        WPF 的 Path 迷你語言（M/L/H/V/C/A/Z 大寫絕對、小寫相對）跟 SVG path 語法幾乎一致，
        <path> 元素的 d 屬性可以近乎逐字轉過來；<line>/<rect> 這類基本圖形換算成等價的 path 片段，
        多個子圖形用空白分隔的多組 "M...Z" 串接在同一個 Figures 字串裡（WPF 支援同一個
        PathGeometry 內有多個不相連的子圖形，跟 SVG 一個 d 屬性可以有多個 M 一樣）。

        rect 的圓角（rx=1／2，原始 24 單位 viewBox）在最終渲染尺寸（App 內約 15–18px）幾乎看不出來，
        這裡簡化成直角矩形，刻意的簡化不是漏做。

        用法：<components:IconGlyph IconData="{StaticResource IconMenuGeometry}" Width="16" Height="16" />
        （IconGlyph 定義在 Components/IconGlyph.xaml，統一套 Stroke=目前 Foreground、
        StrokeThickness=2、圓端點/圓轉角，對應 blueprint Icon.dc.html 的
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"。）
    -->

    <PathGeometry x:Key="IconMenuGeometry" Figures="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18" />

    <PathGeometry x:Key="IconSearchGeometry"
                  Figures="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 M21,21 l-4.3,-4.3" />

    <PathGeometry x:Key="IconChevronLeftGeometry" Figures="M15,18 l-6,-6 l6,-6" />
    <PathGeometry x:Key="IconChevronRightGeometry" Figures="M9,18 l6,-6 l-6,-6" />
    <PathGeometry x:Key="IconChevronDownGeometry" Figures="M6,9 l6,6 l6,-6" />

    <PathGeometry x:Key="IconBellGeometry"
                  Figures="M6,8 a6,6 0 0 1 12,0 c0,7 3,9 3,9 H3 s3,-2 3,-9 M10.3,21 a1.94,1.94 0 0 0 3.4,0" />

    <PathGeometry x:Key="IconSlidersHorizontalGeometry"
                  Figures="M21,4 L14,4 M10,4 L3,4 M21,12 L12,12 M8,12 L3,12 M21,20 L16,20 M12,20 L3,20 M14,2 L14,6 M8,10 L8,14 M16,18 L16,22" />

    <PathGeometry x:Key="IconLayoutGridGeometry"
                  Figures="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M14,14 H21 V21 H14 Z M3,14 H10 V21 H3 Z" />

    <PathGeometry x:Key="IconGrid3x3Geometry"
                  Figures="M3,3 H21 V21 H3 Z M3,9 h18 M3,15 h18 M9,3 v18 M15,3 v18" />

    <PathGeometry x:Key="IconMinusGeometry" Figures="M5,12 L19,12" />
    <PathGeometry x:Key="IconSquareGeometry" Figures="M5,5 H19 V19 H5 Z" />
    <PathGeometry x:Key="IconXGeometry" Figures="M18,6 L6,18 M6,6 l12,12" />

    <PathGeometry x:Key="IconRefreshCwGeometry"
                  Figures="M3,12 a9,9 0 0 1 15,-6.7 L21,8 M21,3 v5 h-5 M21,12 a9,9 0 0 1 -15,6.7 L3,16 M8,16 H3 v5" />

    <PathGeometry x:Key="IconUploadGeometry"
                  Figures="M12,3 v12 M7,8 l5,-5 l5,5 M20.4,18.5 A2,2 0 0 1 18.5,21 H5.5 a2,2 0 0 1 -1.9,-2.5" />

    <PathGeometry x:Key="IconPencilGeometry"
                  Figures="M21.174,6.812 a1,1 0 0 0 -3.986,-3.987 L3.842,16.174 a2,2 0 0 0 -.5,.83 l-1.321,4.352 a.5,.5 0 0 0 .623,.622 l4.353,-1.32 a2,2 0 0 0 .83,-.497 Z M15,5 l4,4" />

    <PathGeometry x:Key="IconTrashGeometry"
                  Figures="M3,6 h18 M19,6 v14 a2,2 0 0 1 -2,2 H7 a2,2 0 0 1 -2,-2 V6 M8,6 V4 a2,2 0 0 1 2,-2 h4 a2,2 0 0 1 2,2 v2 M10,11 L10,17 M14,11 L14,17" />

    <PathGeometry x:Key="IconCheckGeometry" Figures="M20,6 L9,17 l-5,-5" />

