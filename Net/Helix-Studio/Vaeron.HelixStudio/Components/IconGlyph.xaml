<UserControl x:Class="Vaeron.HelixStudio.Components.IconGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsHitTestVisible="False">
    <!--
        跨功能共用「啞」元件（feature-structure.md 判準）：把 Icons.xaml 的 PathGeometry 資源畫成
        線條圖示，對應 blueprint Icon.dc.html 的 stroke-width="2" stroke-linecap="round"
        stroke-linejoin="round"、fill="none"（線條圖示，不是實心填色）。IsHitTestVisible=False，
        點擊事件穿透到外層 Button，圖示本身不搶焦點/點擊。
    -->
    <Viewbox Stretch="Uniform">
        <Path Data="{Binding IconData, ElementName=Root}"
              Stroke="{Binding Foreground, ElementName=Root}"
              StrokeThickness="2"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Fill="Transparent" />
    </Viewbox>
</UserControl>
