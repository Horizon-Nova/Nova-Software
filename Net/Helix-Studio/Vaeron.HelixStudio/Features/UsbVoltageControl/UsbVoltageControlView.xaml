<UserControl x:Class="Vaeron.HelixStudio.Features.UsbVoltageControl.UsbVoltageControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.Features.UsbVoltageControl"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <local:DeviceStatusToDotBrushConverter x:Key="DeviceStatusToDotBrush" />
        <local:ShowApplyButtonConverter x:Key="ShowApplyButton" />
        <local:ConnectedToBrushConverter x:Key="ConnectedToBrushConverter" />
        <local:ConnectedToTextConverter x:Key="ConnectedToTextConverter" />
        <local:NoPowerControlTooltipConverter x:Key="NoPowerControlTooltipConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="USB 防休眠控制" Style="{StaticResource BaseTextStyle}"
                   FontSize="{StaticResource FontSizeH1}" FontWeight="Bold" Margin="0,0,0,8" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,8"
                Background="{DynamicResource StatusWarningBgBrush}"
                Visibility="{Binding ShowRiskBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding RiskBannerText}" Style="{StaticResource BaseTextStyle}"
                       Foreground="{DynamicResource StatusWarningTextBrush}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,8"
                Visibility="{Binding HardwareStatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding HardwareStatusMessage}" Style="{StaticResource BaseTextStyle}"
                       Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,4">
            <TextBlock Text="電壓修正" FontWeight="700" FontSize="{StaticResource FontSizeXs}"
                       Foreground="{DynamicResource AccentLabelBrush}" Margin="0,0,0,4" />
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" IsEnabled="{Binding IsServiceRunning}"
                              IsChecked="{Binding GlobalAutoCorrectEnabled, Mode=OneWay}"
                              Command="{Binding ApplyToggleGlobalAutoCorrectCommand}" />
                <StackPanel>
                    <TextBlock Text="自動電壓修正（全域）" FontWeight="600" Style="{StaticResource BaseTextStyle}" />
                    <TextBlock Text="開啟後，系統會自動偵測並修正電壓偏離目標的裝置，不需逐台手動套用；僅套用於驅動程式回報支援電源管理的裝置。"
                               Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource Text2Brush}"
                               FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding CorrectedSummary}" FontWeight="600" Style="{StaticResource BaseTextStyle}"
                   Foreground="{DynamicResource Text2Brush}" Margin="0,4,0,8" />

        <Grid Grid.Row="5">
            <TextBlock Text="載入中…" Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Center" Margin="0,24,0,0"
                       Visibility="{Binding DevicesLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

            <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Devices}"
                      Visibility="{Binding DevicesLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                        <Setter Property="DetailsVisibility">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource ReferenceEqualsToVisibilityConverter}">
                                    <Binding Path="." />
                                    <Binding Path="DataContext.ExpandedDevice" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header=" " Width="24">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" Fill="{Binding ., Converter={StaticResource DeviceStatusToDotBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="名稱" Width="140" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="種類" Width="100" Binding="{Binding Kind}" />
                    <DataGridTextColumn Header="上次中斷" Width="120" Binding="{Binding LastInterruption}" />
                    <DataGridTemplateColumn Header="連線" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="6,1"
                                        Background="{Binding Connected, Converter={StaticResource ConnectedToBrushConverter}}">
                                    <TextBlock Text="{Binding Connected, Converter={StaticResource ConnectedToTextConverter}}"
                                               FontSize="{StaticResource FontSizeXs}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="電壓" Width="80" Binding="{Binding Voltage, StringFormat={}{0:F2}V}" />
                    <DataGridTextColumn Header="目標" Width="70" Binding="{Binding Target, StringFormat={}{0:F2}V}" />
                    <DataGridTemplateColumn Header="不支援電源管理" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="不支援電源管理" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource Text3Brush}"
                                           Visibility="{Binding SupportsPowerControl, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="套用修正" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.ApplyQuickApplyCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource ShowApplyButton}">
                                                <Binding Path="." />
                                                <Binding Path="DataContext.GlobalAutoCorrectEnabled" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                <Binding Path="DataContext.IsServiceRunning" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>
                                    <Button Content="詳細" Style="{StaticResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding SupportsPowerControl}"
                                            ToolTip="{Binding SupportsPowerControl, Converter={StaticResource NoPowerControlTooltipConverter}}"
                                            Command="{Binding DataContext.ApplyToggleExpandCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TableRowDetailsBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80" Style="{StaticResource AppTextBoxStyle}"
                                         Text="{Binding DataContext.ManualTargetVoltage, RelativeSource={RelativeSource AncestorType=DataGrid}, StringFormat=F2}" />
                                <Button Content="5V" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ApplySetPresetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="5" />
                                <Button Content="9V" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ApplySetPresetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="9" />
                                <Button Content="12V" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ApplySetPresetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="12" />
                                <Button Content="20V" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ApplySetPresetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="20" />
                                <Button Content="套用" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ApplySetTargetVoltageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
