<UserControl x:Class="Vaeron.HelixStudio.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:eventLog="clr-namespace:Vaeron.HelixStudio.Features.EventLog"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.Features.Settings"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <eventLog:SeverityToTextConverter x:Key="SeverityToText" />
        <local:CategoryKeyToButtonStyleConverter x:Key="CategoryKeyToButtonStyle" />
        <local:WorkspaceRowMatchesConverter x:Key="WorkspaceRowMatches" />
        <local:DeleteConfirmEnabledConverter x:Key="DeleteConfirmEnabled" />
        <local:CountGreaterThanOneConverter x:Key="CountGreaterThanOne" />
        <local:CheckUpdateLabelConverter x:Key="CheckUpdateLabel" />

        <DataTemplate x:Key="CategoryNavTemplate">
            <Button Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1,0,0"
                    Command="{Binding DataContext.ApplySelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Key}">
                <Button.Style>
                    <MultiBinding Converter="{StaticResource CategoryKeyToButtonStyle}">
                        <Binding Path="Key" />
                        <Binding Path="DataContext.SelectedCategoryKey" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                    </MultiBinding>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側分類導覽＋搜尋 -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="設定" Style="{StaticResource BaseTextStyle}"
                       FontSize="{StaticResource FontSizeH1}" FontWeight="Bold" Margin="0,0,0,12" />
            <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜尋設定項目" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryNavTemplate}" />
            <TextBlock Text="沒有符合條件的設定項目" Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource Text3Brush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasNoCategoryMatch, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640">

                <!-- 工作區管理 -->
                <Border x:Name="Section_workspace" Visibility="{Binding IsWorkspaceCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="工作區（產線）管理" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button Content="切換" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ApplySwitchWorkspaceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Workspace}" />
                                                    <Button Content="編輯" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ApplyStartEditWorkspaceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Workspace}" />
                                                    <Button Content="刪除" Style="{StaticResource SecondaryButtonStyle}"
                                                            ToolTip="至少要保留一個工作區"
                                                            Command="{Binding DataContext.ApplyRequestDeleteWorkspaceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Workspace}">
                                                        <Button.IsEnabled>
                                                            <Binding Path="DataContext.Workspaces.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                                     Converter="{StaticResource CountGreaterThanOne}" />
                                                        </Button.IsEnabled>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource BaseTextStyle}">
                                                        <Run Text="{Binding Workspace.Name, Mode=OneWay}" FontWeight="Bold" />
                                                        <Run Text=" · " Foreground="{DynamicResource Text3Brush}" />
                                                        <Run Text="{Binding EventCount, Mode=OneWay, StringFormat={}{0} 筆事件}" Foreground="{DynamicResource Text3Brush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Workspace.Description}" Style="{StaticResource BaseTextStyle}"
                                                               Foreground="{DynamicResource Text2Brush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- 編輯表單 -->
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,2,0,0">
                                            <Border.Visibility>
                                                <MultiBinding Converter="{StaticResource WorkspaceRowMatches}">
                                                    <Binding Path="Workspace.Id" />
                                                    <Binding Path="DataContext.EditingWorkspace" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Visibility>
                                            <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Orientation="Horizontal">
                                                <TextBox Width="140" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Width="200" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0"
                                                         Text="{Binding EditWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="儲存" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                                        Command="{Binding ApplySaveEditWorkspaceCommand}" />
                                                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                                        Command="{Binding ApplyCancelEditWorkspaceCommand}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 刪除確認：輸入完整名稱才能刪除 -->
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,2,0,0"
                                                Background="{DynamicResource StatusErrorBgBrush}">
                                            <Border.Visibility>
                                                <MultiBinding Converter="{StaticResource WorkspaceRowMatches}">
                                                    <Binding Path="Workspace.Id" />
                                                    <Binding Path="DataContext.DeleteTarget" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Visibility>
                                            <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock Style="{StaticResource BaseTextStyle}" TextWrapping="Wrap">
                                                    <Run Text="此動作無法復原，且會一併刪除此工作區底下的所有事件記錄。請輸入「" />
                                                    <Run Text="{Binding DeleteTarget.Name, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text="」以確認刪除。" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBox Width="160" Style="{StaticResource AppTextBoxStyle}" Text="{Binding DeleteConfirmText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Content="確認刪除" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                                            Command="{Binding ApplyConfirmDeleteWorkspaceCommand}">
                                                        <Button.IsEnabled>
                                                            <MultiBinding Converter="{StaticResource DeleteConfirmEnabled}">
                                                                <Binding Path="DeleteConfirmText" />
                                                                <Binding Path="DeleteTarget" />
                                                            </MultiBinding>
                                                        </Button.IsEnabled>
                                                    </Button>
                                                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                                            Command="{Binding ApplyCancelDeleteWorkspaceCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                            <TextBox Width="140" Style="{StaticResource AppTextBoxStyle}" Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="200" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0"
                                     Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="新增工作區" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                    Command="{Binding ApplyAddWorkspaceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 外觀 -->
                <Border x:Name="Section_appearance" Visibility="{Binding IsAppearanceCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="外觀" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,16,0,4" />
                        <TextBlock Text="以下設定套用到整個軟體，所有工作區共用" Style="{StaticResource BaseTextStyle}"
                                   Foreground="{DynamicResource Text3Brush}" FontSize="{StaticResource FontSizeXs}" Margin="0,0,0,8" />

                        <TextBlock Text="主題模式" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="72" Height="44" CornerRadius="6" Background="#FFF7F5F2" Margin="0,0,8,0" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ApplySelectThemeCommand}" CommandParameter="light" />
                                </Border.InputBindings>
                                <TextBlock Text="淺色" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF1E1B18" />
                            </Border>
                            <Border Width="72" Height="44" CornerRadius="6" Background="#FF1E1B18" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ApplySelectThemeCommand}" CommandParameter="dark" />
                                </Border.InputBindings>
                                <TextBlock Text="深色" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <CheckBox Content="精簡密度" IsChecked="{Binding IsCompactDensity}" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="介面縮放" VerticalAlignment="Center" Width="120" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="80" ItemsSource="{Binding UiScaleOptions}" SelectedItem="{Binding UiScalePercent}" />
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource BaseTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="強調色 Hue" VerticalAlignment="Center" Width="120" Style="{StaticResource BaseTextStyle}" />
                            <Slider Width="160" Minimum="0" Maximum="360" Value="{Binding AccentHue}" />
                        </StackPanel>
                        <!-- 沒有「套用」按鈕——每個控件一改就立刻生效並存檔，對齊 blueprint 沒有
                             套用步驟的即時套用模型（見 ViewModel 的 On*Changed 局部方法）。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="重設外觀為預設值" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ApplyResetAppearanceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 電源（僅供展示） -->
                <Border x:Name="Section_power" Visibility="{Binding IsPowerCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="電源（僅供展示，無實際 OS API 接入）" FontWeight="Bold" Style="{StaticResource BaseTextStyle}"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,16,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="電源模式" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding PowerModeOptions}" SelectedItem="{Binding PowerMode}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="插電時進入睡眠（分鐘，0＝永不）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding SleepMinutesOptions}" SelectedItem="{Binding AcSleepMinutes}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="電池電力時進入睡眠（分鐘）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding SleepMinutesOptions}" SelectedItem="{Binding BatterySleepMinutes}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="螢幕逾時（分鐘）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding SleepMinutesOptions}" SelectedItem="{Binding ScreenTimeoutMinutes}" />
                        </StackPanel>
                        <CheckBox Content="休眠" IsChecked="{Binding HibernateEnabled}" Margin="0,8,0,0" />
                        <CheckBox Content="快速啟動" IsChecked="{Binding FastStartupEnabled}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="按下電源按鈕時" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="120" ItemsSource="{Binding PowerButtonActionOptions}" SelectedItem="{Binding PowerButtonAction}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="闔上筆電螢幕時" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="120" ItemsSource="{Binding PowerButtonActionOptions}" SelectedItem="{Binding LidCloseAction}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 一般 -->
                <Border x:Name="Section_general" Visibility="{Binding IsGeneralCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="一般" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,16,0,4" />
                        <CheckBox Content="預設摺疊側邊欄" IsChecked="{Binding SidebarCollapsedByDefault}" Margin="0,4,0,0" />
                        <CheckBox Content="開機時自動啟動本軟體" IsChecked="{Binding StartWithWindows}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="啟動時開啟頁面（僅供展示）" VerticalAlignment="Center" Width="180" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding StartupPageOptions}" SelectedItem="{Binding StartupPage}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="介面語言（僅供展示）" VerticalAlignment="Center" Width="180" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="閒置鎖定（分鐘，0＝永不，僅供展示）" VerticalAlignment="Center" Width="180" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding IdleLockMinutesOptions}" SelectedItem="{Binding IdleLockMinutes}" />
                        </StackPanel>
                        <Button Content="儲存" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                                Command="{Binding ApplySaveGeneralCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- 通知 -->
                <Border x:Name="Section_notifications" Visibility="{Binding IsNotificationsCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="通知" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,16,0,4" />
                        <CheckBox Content="顯示未讀事件徽章" IsChecked="{Binding ShowEventBadge}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 日誌 -->
                <Border x:Name="Section_log" Visibility="{Binding IsLogCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="日誌" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,16,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="最低記錄等級（全域）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="180" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding MinLogLevel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SeverityToText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="記錄保留期限（天，-1＝永久）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding RetentionDaysOptions}" SelectedItem="{Binding RetentionDays}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="輸出位置" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <TextBlock Text="{Binding ExportPathDisplay}" VerticalAlignment="Center" Style="{StaticResource BaseTextStyle}"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" />
                            <Button Content="瀏覽…" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                    ToolTip="原型範疇未提供資料夾選擇對話框" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="編碼（僅供展示）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <ComboBox Width="100" ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding Encoding}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="時區（僅供展示）" VerticalAlignment="Center" Width="160" Style="{StaticResource BaseTextStyle}" />
                            <TextBox Width="160" Style="{StaticResource AppTextBoxStyle}" Text="{Binding TimeZone}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="儲存日誌設定" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplySaveLogSettingsCommand}" />
                            <Button Content="匯出事件記錄" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding ApplyExportEventsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 關於 -->
                <Border x:Name="Section_about" Visibility="{Binding IsAboutCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="關於" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,16,0,4" />
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="版本：" /><Run Text="{Binding VersionText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="建置日期：" /><Run Text="{Binding BuildDateText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="平台：" /><Run Text="{Binding PlatformText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="授權：" /><Run Text="已啟用（一般金鑰／無到期欄位）" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="到期日：" /><Run Text="無到期日" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="工作區 ID：" /><Run Text="{Binding ActiveWorkspaceId, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="法律與授權文件" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                ToolTip="原型範疇：內容待補" />
                        <Button Content="{Binding IsCheckingUpdate, Converter={StaticResource CheckUpdateLabel}, FallbackValue=檢查更新}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}"
                                Command="{Binding ApplyCheckUpdateCommand}" />
                    </StackPanel>
                </Border>

                <!-- 使用說明 -->
                <Border x:Name="Section_help" Visibility="{Binding IsHelpCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="使用說明（原型範圍：內容待補）" FontWeight="Bold" Style="{StaticResource BaseTextStyle}"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,16,0,4" />
                        <Button Content="操作手冊" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="常見問題 FAQ" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="鍵盤快速鍵" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="版本更新紀錄 Changelog" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="系統需求" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="意見回饋／錯誤回報" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="聯絡技術支援" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- 法律 -->
                <Border x:Name="Section_legal" Visibility="{Binding IsLegalCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="法律（原型範圍：內容待補）" FontWeight="Bold" Style="{StaticResource BaseTextStyle}"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,16,0,4" />
                        <Button Content="隱私權政策" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="服務條款／使用條款" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="第三方軟體授權清單" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <Button Content="資料保留與稽核政策" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,2,0,16" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
