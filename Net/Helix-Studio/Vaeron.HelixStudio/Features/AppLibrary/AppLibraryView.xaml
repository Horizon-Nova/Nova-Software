<UserControl x:Class="Vaeron.HelixStudio.Features.AppLibrary.AppLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.Features.AppLibrary"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop">
    <UserControl.Resources>
        <local:ReadmeToFlowDocumentConverter x:Key="ReadmeToFlowDocument" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="工具庫" Style="{StaticResource BaseTextStyle}"
                   FontSize="{StaticResource FontSizeH1}" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="240" Style="{StaticResource AppTextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="匯入工具..." Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                    Command="{Binding ApplyImportCommand}" />
            <TextBlock Text="（或直接把 .exe/.msi/.zip 拖放到本頁面匯入）" VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource Text3Brush}"
                       FontSize="{StaticResource FontSizeXs}" />
            <TextBlock Text="{Binding ImportFeedback}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource Text2Brush}" />
        </StackPanel>

        <ListBox Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Categories}"
                 SelectedValue="{Binding SelectedCategoryId}" SelectedValuePath="Id"
                 DisplayMemberPath="Label" BorderThickness="0" Background="Transparent" />

        <ListView Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Apps}" BorderThickness="0" Background="Transparent">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名稱" Width="150" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="版本" Width="60" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="說明" Width="220" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="開發者" Width="90" DisplayMemberBinding="{Binding Developer}" />
                    <GridViewColumn Header="大小" Width="60" DisplayMemberBinding="{Binding FileSize}" />
                    <GridViewColumn Header="更新日期" Width="90" DisplayMemberBinding="{Binding LastUpdated, StringFormat=yyyy-MM-dd}" />
                    <GridViewColumn Header="操作" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="999" Padding="6,1" Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                    <Button Content="更新" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ApplyAddToWorkspaceCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="加入工作區" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"
                                            Visibility="{Binding IsInstalledInActiveWorkspace,
                                                         Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ApplyAddToWorkspaceCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                    <!-- 已加入只在「已安裝且沒有更新可用」顯示——有更新可用時上面的「更新」
                                         按鈕已經涵蓋這個工具的操作，不需要「已加入」再重複出現。 -->
                                    <Button Content="已加入" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                            ToolTip="點擊從目前工作區移除"
                                            Visibility="{Binding IsInstalledWithoutUpdate,
                                                         Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ApplyRemoveFromWorkspaceCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="詳細" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.ApplyToggleExpandCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="移除" Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="從工具庫刪除此目錄項目（僅限使用者匯入的工具）"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ApplyRemoveImportedCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0"
                Visibility="{Binding ExpandedApp, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel>
                <TextBlock Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="需求：" /><Run Text="{Binding ExpandedApp.Requirements, Mode=OneWay}" />
                    <Run Text="　更新日期：" /><Run Text="{Binding ExpandedApp.LastUpdated, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="說明文件" FontWeight="Bold" Style="{StaticResource BaseTextStyle}" Margin="0,8,0,4"
                           Visibility="{Binding ExpandedApp.Readme, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                <!-- README 是簡化 markdown（## 標題／- 條列／```程式碼區塊```），直接塞進 TextBlock
                     只會把語法符號原封不動印出來，改用 FlowDocumentScrollViewer 顯示解析後的
                     版面（見 ReadmeToFlowDocumentConverter），對齊 blueprint 的 parseReadme 行為。 -->
                <FlowDocumentScrollViewer Document="{Binding ExpandedApp.Readme, Converter={StaticResource ReadmeToFlowDocument}}"
                                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
