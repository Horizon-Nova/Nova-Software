<Application x:Class="Helix_Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Helix_Studio"
             xmlns:conv="clr-namespace:Helix_Studio.Views.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:NullToVisibleConverter x:Key="NullToVisible" />
            <conv:PngBytesToImageSourceConverter x:Key="PngBytesToImageSource" />
            <ResourceDictionary.MergedDictionaries>
                <!-- Design-time defaults; runtime is controlled by AppearanceCore/ThemeCore. -->
                <ResourceDictionary Source="Themes/ShellChromeStyles.xaml" />
                <ResourceDictionary Source="Themes/ShellTypography.xaml" />
                <ResourceDictionary Source="Themes/ShellScrollStyles.xaml" />
                <ResourceDictionary Source="Themes/ShellSettingsStyles.xaml" />
                <ResourceDictionary Source="Themes/ShellMarkdownStyles.xaml" />
                <ResourceDictionary Source="Themes/ShellColors.xaml" />
                <ResourceDictionary Source="Themes/Locale/Strings.zh-Hant.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

