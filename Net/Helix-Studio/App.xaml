<Application x:Class="Helix_Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 設計 token（顏色取自舊版主色，整理於新結構） -->
                <ResourceDictionary Source="Resources/Themes/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Themes/Sizes.xaml"/>
                <!-- 值轉換器 -->
                <ResourceDictionary Source="Resources/Converters.xaml"/>
                <!-- 共用基礎 -->
                <ResourceDictionary Source="Resources/Components/FocusVisual.xaml"/>
                <!-- 通用元件（一元件一檔） -->
                <ResourceDictionary Source="Resources/Components/NavItem.xaml"/>
                <ResourceDictionary Source="Resources/Components/SearchBox.xaml"/>
                <ResourceDictionary Source="Resources/Components/ActionButton.xaml"/>
                <ResourceDictionary Source="Resources/Components/DataCheckBox.xaml"/>
                <ResourceDictionary Source="Resources/Components/DataToggle.xaml"/>
                <ResourceDictionary Source="Resources/Components/ScrollBar.xaml"/>
                <ResourceDictionary Source="Resources/Components/ComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
