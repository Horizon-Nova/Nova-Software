<Project>
  <!-- 獨立工作區的預設值層。不含 vaeron-skeleton 的 S001-S013 結構檢查與 VAE 分析器——
       那套機制服務單一工作區內管理多個 App 的邊界問題，本工作區只有一個 App，不套用。 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 產品中繼資料。寫進每個組件的版本資源，檔案總管的「詳細資料」與安裝程式都讀這裡。 -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Company>Vaeron</Company>
    <Product>Helix Studio</Product>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Vaeron</Copyright>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
  </PropertyGroup>
</Project>
