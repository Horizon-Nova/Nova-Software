<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>Helix_Studio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- SvgIcon 渲染 lucide 線條圖示 -->
    <PackageReference Include="SharpVectors" Version="1.8.5" />
  </ItemGroup>

  <!-- lucide SVG 圖示內嵌供 SvgIcon 以 pack URI 載入 -->
  <ItemGroup>
    <None Remove="Assets\**\*.svg" />
    <Resource Include="Assets\**\*.svg" />
  </ItemGroup>

  <!-- 內建推薦工具目錄：複製到輸出供 ToolCatalogService 讀取 -->
  <ItemGroup>
    <Content Include="Catalog\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
