<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Helix_Studio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**\*.*" />
    <Resource Include="Assets\**\*.svg" />
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\**\*.ico" />
    <Resource Include="Assets\**\*.jpg" />
    <Resource Include="Assets\**\*.jpeg" />
    <Resource Include="Assets\**\*.webp" />
    <Resource Include="Assets\**\*.html" />
    <Resource Include="Assets\**\*.css" />
    <Resource Include="Assets\**\*.js" />
    <Resource Include="Assets\**\*.txt" Exclude="Assets\Legal\*.txt" />
    <Content Include="Assets\Legal\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_tools\**\*.cs" />
    <None Remove="_tools\**\*.*" />
    <Page Remove="_tools\**\*.xaml" />
    <Resource Remove="_tools\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
  </ItemGroup>

</Project>
