<UserControl x:Class="Vaeron.HelixStudio.Features.EventLog.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.Features.EventLog"
             xmlns:themes="clr-namespace:Vaeron.HelixStudio.Themes"
             xmlns:components="clr-namespace:Vaeron.HelixStudio.Components"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <local:SeverityToTextConverter x:Key="SeverityToText" />
        <local:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <local:CopyFeedbackToLabelConverter x:Key="CopyFeedbackToLabelConverter" />

        <DataTemplate x:Key="TimeRangePillTemplate">
            <Button Content="{Binding}" Margin="0,0,4,0"
                    Command="{Binding DataContext.ApplySetTimeRangeFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <MultiBinding Converter="{StaticResource ObjectEqualsToButtonStyle}">
                        <Binding Path="." />
                        <Binding Path="DataContext.TimeRangeFilter" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                    </MultiBinding>
                </Button.Style>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SeverityPillTemplate">
            <Button Content="{Binding}" Margin="0,0,4,0"
                    Command="{Binding DataContext.ApplySetSeverityFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <MultiBinding Converter="{StaticResource ObjectEqualsToButtonStyle}">
                        <Binding Path="." />
                        <Binding Path="DataContext.SeverityFilter" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                    </MultiBinding>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="事件日誌" Style="{StaticResource BaseTextStyle}"
                   FontSize="{StaticResource FontSizeH1}" FontWeight="{DynamicResource FontWeightStrong}" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="240" Style="{StaticResource AppSearchBoxStyle}"
                     themes:TextBoxPlaceholder.Text="搜尋工具名稱或訊息"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsControl ItemsSource="{Binding TimeRangeOptions}" ItemTemplate="{StaticResource TimeRangePillTemplate}" Margin="8,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SeverityOptions}" ItemTemplate="{StaticResource SeverityPillTemplate}" Margin="8,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding MinLevelBannerText}" Style="{StaticResource BaseTextStyle}"
                       FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>

        <Grid Grid.Row="3">
            <components:TableSkeletonView Columns="{x:Static local:EventLogViewModel.SkeletonColumns}"
                                          RowCount="6" RowHeight="{Binding RowHeight}"
                                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

            <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Events}"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <!-- 整列可點擊展開 -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                        <Setter Property="Height" Value="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="DetailsVisibility">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource ReferenceEqualsToVisibilityConverter}">
                                    <Binding Path="." />
                                    <Binding Path="DataContext.ExpandedEvent" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnRowMouseLeftButtonUp" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header=" " Width="4">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Width="4" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="等級" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToText}}"
                                               Foreground="{DynamicResource AccentOnSolidBrush}" FontSize="{StaticResource FontSizeXs}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="工具" Width="140" Binding="{Binding ToolName}" />
                    <DataGridTextColumn Header="訊息" Width="356" Binding="{Binding Message}" />
                    <DataGridTextColumn Header="時間" Width="140" Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm:ss}" />
                    <!-- 展開提示圖示 -->
                    <DataGridTemplateColumn Header=" " Width="32">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <components:IconGlyph IconData="{StaticResource IconChevronDownGeometry}"
                                                       Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border Style="{StaticResource TableRowDetailsBorderStyle}" Background="{DynamicResource TerminalBgBrush}"
                                    Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Command, StringFormat={}$ {0}}"
                                               Foreground="{DynamicResource TerminalTextBrush}"
                                               FontFamily="Consolas" FontSize="{StaticResource FontSizeSm}"
                                               Visibility="{Binding Command, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                    <TextBlock Text="{Binding Output}" TextWrapping="Wrap"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                               FontFamily="Consolas" FontSize="{StaticResource FontSizeSm}" Margin="0,4,0,0"
                                               Visibility="{Binding Output, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                    <TextBlock Text="{Binding ExitCode, StringFormat=exit code {0}}"
                                               Foreground="{DynamicResource TerminalTextBrush}"
                                               FontFamily="Consolas" FontSize="{StaticResource FontSizeXs}" Margin="0,4,0,0"
                                               Visibility="{Binding ExitCode, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{Binding DataContext.CopyFeedback, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource CopyFeedbackToLabelConverter}, FallbackValue=複製}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="複製"
                                                Command="{Binding DataContext.ApplyCopyOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TableRowDetailsBorderStyle}"
                                    Visibility="{Binding HasDetails, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="此事件無指令輸出記錄" Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TableEmptyStateTextStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding Events.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="沒有符合條件的事件" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
