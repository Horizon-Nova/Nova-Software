<UserControl x:Class="Vaeron.HelixStudio.ToolHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Background="{DynamicResource BgPageBrush}">
        <!-- 工具視窗嵌入容器：由 code-behind 依 ViewModel.WindowHandle 動態塞入 EmbeddedWindowHost -->
        <Border x:Name="HostArea" />

        <!-- 尚未有可嵌入視窗（工具剛啟動、主視窗還沒就緒）時的等待提示 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ToolName, StringFormat=正在啟動「{0}」…}" Style="{StaticResource BaseTextStyle}"
                       FontSize="{StaticResource FontSizeLg}" HorizontalAlignment="Center" />
            <TextBlock Text="視窗就緒後會自動顯示在這裡" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{StaticResource FontSizeSm}" Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
