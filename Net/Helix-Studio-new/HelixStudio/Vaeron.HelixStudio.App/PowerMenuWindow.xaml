<Window x:Class="Vaeron.HelixStudio.PowerMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="電源" Width="320" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource BgPageBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}">
    <!-- 闔螢幕觸發時彈出，只在有外接螢幕或使用者重新打開螢幕蓋時看得到——見藍圖_設定.md 已知限制 -->
    <StackPanel Margin="20">
        <TextBlock Text="電源" FontWeight="{DynamicResource FontWeightStrong}" FontSize="{StaticResource FontSizeH1}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBlock Text="筆電螢幕已闔上，選擇要執行的動作" Style="{StaticResource BaseTextStyle}"
                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <Button Content="睡眠" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                Click="OnSleepClick" />
        <Button Content="休眠" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"
                Click="OnHibernateClick" />
        <Button Content="關機" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"
                Click="OnShutdownClick" />
        <Button Content="取消" Style="{StaticResource TextButtonStyle}"
                Click="OnCancelClick" />
    </StackPanel>
</Window>
