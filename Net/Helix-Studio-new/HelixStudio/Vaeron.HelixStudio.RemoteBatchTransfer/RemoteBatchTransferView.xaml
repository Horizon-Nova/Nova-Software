<UserControl x:Class="Vaeron.HelixStudio.RemoteBatchTransfer.RemoteBatchTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.RemoteBatchTransfer"
             xmlns:contracts="clr-namespace:Vaeron.HelixStudio.RemoteBatchTransfer"
             xmlns:runtime="clr-namespace:Vaeron.HelixStudio.Internal.Runtime.Themes;assembly=Vaeron.HelixStudio.Internal.Runtime"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <local:BoolToActionButtonStyleConverter x:Key="BoolToActionButtonStyleConverter" />
        <local:ConnectionStatusToTextConverter x:Key="ConnectionStatusToText" />
        <local:ConnectionStatusToBrushConverter x:Key="ConnectionStatusToBrush" />
        <local:ConnectionStatusConnectedConverter x:Key="ConnectionStatusConnected" />
        <local:AuthMethodToTextConverter x:Key="AuthMethodToText" />
        <local:OverrideBadgeConverter x:Key="OverrideBadge" />
        <local:TaskLogToggleLabelConverter x:Key="TaskLogToggleLabelConverter" />
        <local:TaskTargetPairConverter x:Key="TaskTargetPairConverter" />

        <ObjectDataProvider x:Key="AuthMethodValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="contracts:AuthMethod" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="遠端批次傳檔" Style="{StaticResource BaseTextStyle}"
                       FontSize="{StaticResource FontSizeH1}" FontWeight="{DynamicResource FontWeightStrong}" Margin="0,0,0,8" />

            <!-- 遠端連線 -->
            <TextBlock Text="遠端連線" FontWeight="{DynamicResource FontWeightStrong}" Style="{StaticResource BaseTextStyle}" Margin="0,8,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox Width="200" Style="{StaticResource AppSearchBoxStyle}" runtime:TextBoxPlaceholder.Text="搜尋連線名稱或位址"
                         Text="{Binding ConnectionSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="全選已連線" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplySelectAllConnectedCommand}" />
                <Button Content="清除選取" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplyClearSelectionCommand}" />
                <Button Content="全部重新測試" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplyTestAllCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ConnectionsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding Connection.Status, Converter={StaticResource ConnectionStatusConnected}}" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="測試" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ApplyTestConnectionCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,4,0" />
                                        <Button Content="編輯" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ApplyStartEditConnectionCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,4,0" />
                                        <Button Content="刪除" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ApplyDeleteConnectionCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource BaseTextStyle}">
                                            <Run Text="{Binding Connection.Name, Mode=OneWay}" FontWeight="{DynamicResource FontWeightStrong}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Connection.Host, Mode=OneWay}" />
                                            <Run Text=":" />
                                            <Run Text="{Binding Connection.Port, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Connection.AuthMethod, Mode=OneWay, Converter={StaticResource AuthMethodToText}}"
                                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeXs}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{Binding Connection.Status, Converter={StaticResource ConnectionStatusToBrush}}"
                                                    CornerRadius="6" Padding="6,1">
                                                <TextBlock Text="{Binding Connection.Status, Converter={StaticResource ConnectionStatusToText}}"
                                                           FontSize="{StaticResource FontSizeXs}" />
                                            </Border>
                                            <TextBlock Text="{Binding Connection.LastResultMessage, StringFormat=上次任務：{0}}"
                                                       FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Connection.LastResultMessage, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <TextBox Width="200" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding DestPathOverride, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 新增連線 -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="新增連線" FontWeight="600" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="140" Style="{StaticResource AppTextBoxStyle}" Text="{Binding NewConnectionName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Width="140" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0" Text="{Binding NewConnectionHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Width="60" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0" Text="{Binding NewConnectionPort, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Width="100" Margin="4,0,0,0" ItemsSource="{Binding Source={StaticResource AuthMethodValues}}"
                                  SelectedItem="{Binding NewConnectionAuthMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource AuthMethodToText}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Width="100" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0"
                                 Text="{Binding NewConnectionAccount, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="新增連線" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplyAddConnectionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 編輯連線（單一表單，跟目前正在編輯的連線綁定） -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,4,0,0"
                    Visibility="{Binding EditingConnection, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="編輯連線" FontWeight="600" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="140" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditConnectionName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Width="140" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0" Text="{Binding EditConnectionHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Width="60" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0" Text="{Binding EditConnectionPort, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Width="100" Margin="4,0,0,0" ItemsSource="{Binding Source={StaticResource AuthMethodValues}}"
                                  SelectedItem="{Binding EditConnectionAuthMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource AuthMethodToText}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Width="100" Style="{StaticResource AppTextBoxStyle}" Margin="4,0,0,0"
                                 Text="{Binding EditConnectionAccount, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="儲存" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplySaveEditConnectionCommand}" />
                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplyCancelEditConnectionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 發布設定 -->
            <TextBlock Text="發布設定" FontWeight="{DynamicResource FontWeightStrong}" Style="{StaticResource BaseTextStyle}" Margin="0,16,0,4"
                       Visibility="{Binding HasSelectedTargets, Converter={StaticResource BoolToVisibilityConverter}}" />
            <StackPanel Visibility="{Binding HasSelectedTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="動作" VerticalAlignment="Center" Width="120" Style="{StaticResource BaseTextStyle}" />
                    <Button Content="複製" Margin="0,0,4,0"
                            Style="{Binding IsCopySelected, Converter={StaticResource BoolToActionButtonStyleConverter}}"
                            Command="{Binding ApplySelectActionCommand}" CommandParameter="{x:Static contracts:TransferAction.Copy}" />
                    <Button Content="移動"
                            Style="{Binding IsMoveSelected, Converter={StaticResource BoolToActionButtonStyleConverter}}"
                            Command="{Binding ApplySelectActionCommand}" CommandParameter="{x:Static contracts:TransferAction.Move}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="來源路徑（本機）" VerticalAlignment="Center" Width="120" Style="{StaticResource BaseTextStyle}" />
                    <TextBox Width="300" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="上一層" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Command="{Binding ApplyBrowseUpCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SourceBrowseEntries}" Margin="120,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                    Command="{Binding DataContext.ApplyBrowseIntoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="目的路徑（遠端，預設）" VerticalAlignment="Center" Width="120" Style="{StaticResource BaseTextStyle}" />
                    <TextBox Width="300" Style="{StaticResource AppTextBoxStyle}" Text="{Binding DefaultDestPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 逐台目的路徑覆寫 -->
                <TextBlock Text="{Binding OverrideCount, StringFormat={}{0} 台已覆寫}" FontSize="{StaticResource FontSizeXs}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="120,4,0,0" />
                <ItemsControl ItemsSource="{Binding Connections}" Margin="120,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Connection.Name}" Width="100" VerticalAlignment="Center" Style="{StaticResource BaseTextStyle}" />
                                <TextBlock Text="{Binding DestPathOverride, Converter={StaticResource OverrideBadge}}" Width="60"
                                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" />
                                <Button Content="重設" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ApplyResetOverrideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DestPathOverride, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{Binding DispatchLabel}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                        HorizontalAlignment="Left" IsEnabled="{Binding CanDispatch}" Command="{Binding ApplyDispatchCommand}" />
            </StackPanel>

            <!-- 任務紀錄 -->
            <DockPanel Margin="0,16,0,4">
                <Button DockPanel.Dock="Left" Content="{Binding TaskLogOpen, Converter={StaticResource TaskLogToggleLabelConverter}, FallbackValue=收合}"
                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyToggleTaskLogCommand}" Margin="0,0,8,0" />
                <TextBlock Text="任務紀錄" FontWeight="{DynamicResource FontWeightStrong}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Visibility="{Binding TaskLogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="尚未發布任何任務" Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding Tasks.Count, Converter={StaticResource CountToEmptyVisibilityConverter}, FallbackValue=Visible}" />
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="全部重試失敗"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ApplyRetryAllFailedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Style="{StaticResource BaseTextStyle}">
                                            <Run Text="{Binding Action, Mode=OneWay}" FontWeight="{DynamicResource FontWeightStrong}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding SourcePath, Mode=OneWay}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding DefaultDestPath, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="8,2,0,0">
                                                    <Button DockPanel.Dock="Right" Content="重試" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.ApplyRetryTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Button.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource TaskTargetPairConverter}">
                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                <Binding Path="." />
                                                            </MultiBinding>
                                                        </Button.CommandParameter>
                                                    </Button>
                                                    <TextBlock Style="{StaticResource BaseTextStyle}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding Status, Mode=OneWay}" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding Message, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
