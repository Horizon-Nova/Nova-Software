<UserControl x:Class="Vaeron.HelixStudio.AppLibrary.AppLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.AppLibrary"
             xmlns:runtime="clr-namespace:Vaeron.HelixStudio.Internal.Runtime.Themes;assembly=Vaeron.HelixStudio.Internal.Runtime"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop">
    <UserControl.Resources>
        <local:ReadmeToFlowDocumentConverter x:Key="ReadmeToFlowDocument" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="工具庫" Style="{StaticResource BaseTextStyle}"
                   FontSize="{StaticResource FontSizeH1}" FontWeight="{DynamicResource FontWeightStrong}" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="240" Style="{StaticResource AppSearchBoxStyle}"
                     runtime:TextBoxPlaceholder.Text="搜尋工具名稱"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="匯入工具..." Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                    Command="{Binding ApplyImportCommand}" />
            <TextBlock Text="（或直接把 .exe/.msi/.zip 拖放到本頁面匯入）" VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{StaticResource FontSizeXs}" />
            <TextBlock Text="{Binding ImportFeedback}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <ListBox Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Categories}"
                 SelectedValue="{Binding SelectedCategoryId}" SelectedValuePath="Id"
                 DisplayMemberPath="Label" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource SidebarNavListBoxItemStyle}" />

        <TextBlock Grid.Row="2" Grid.Column="1" Text="載入中…" Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,24,0,0"
                   Visibility="{Binding AppsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

        <DataGrid Grid.Row="2" Grid.Column="1" Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Apps}"
                  Visibility="{Binding AppsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource ExpandableDataGridRowStyle}" />
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="名稱" Width="150" Binding="{Binding Item.Name}" />
                <DataGridTextColumn Header="版本" Width="60" Binding="{Binding Item.Version}" />
                <DataGridTextColumn Header="說明" Width="220" Binding="{Binding Item.Description}" />
                <DataGridTextColumn Header="開發者" Width="90" Binding="{Binding Item.Developer}" />
                <DataGridTextColumn Header="大小" Width="60" Binding="{Binding Item.FileSize}" />
                <DataGridTextColumn Header="更新日期" Width="90" Binding="{Binding Item.LastUpdated, StringFormat=yyyy-MM-dd}" />
                <DataGridTemplateColumn Header="操作" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Padding="6,1" Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Item.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Item.UpdateBadgeText}" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                                <Button Content="更新" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                        Visibility="{Binding Item.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.ApplyAddToWorkspaceCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Item}" />
                                <Button Content="加入工作區" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"
                                        Visibility="{Binding Item.IsInstalledInActiveWorkspace,
                                                     Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.ApplyAddToWorkspaceCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Item}" />
                                <!-- 已安裝且無更新時顯示 -->
                                <Button Content="已加入" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                        ToolTip="點擊從目前工作區移除"
                                        Visibility="{Binding Item.IsInstalledWithoutUpdate,
                                                     Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.ApplyRemoveFromWorkspaceCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Item}" />
                                <Button Content="詳細" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                        Command="{Binding DataContext.ApplyToggleExpandCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Item}" />
                                <Button Content="移除" Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="從工具庫刪除此目錄項目（僅限使用者匯入的工具）"
                                        Visibility="{Binding Item.IsBuiltIn, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.ApplyRemoveImportedCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Item}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource TableRowDetailsBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="需求：" /><Run Text="{Binding Item.Requirements, Mode=OneWay}" />
                                <Run Text="　更新日期：" /><Run Text="{Binding Item.LastUpdated, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="說明文件" FontWeight="{DynamicResource FontWeightStrong}" Style="{StaticResource BaseTextStyle}" Margin="0,8,0,4"
                                       Visibility="{Binding Item.Readme, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                            <!-- README 簡化 markdown 解析後版面 -->
                            <FlowDocumentScrollViewer Document="{Binding Item.Readme, Converter={StaticResource ReadmeToFlowDocument}}"
                                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</UserControl>
