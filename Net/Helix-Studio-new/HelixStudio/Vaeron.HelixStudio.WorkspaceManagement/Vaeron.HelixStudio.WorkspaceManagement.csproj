<Project Sdk="Microsoft.NET.Sdk">
  <!-- 基礎 Feature：不依賴其他 Feature，被 EventLog／AppsManagement／AppLibrary／UsbVoltageControl／
       RemoteBatchTransfer／Settings 依賴。無畫面——由呼叫方承載工作區 CRUD 的 UI。
       TargetFramework 仍需為 net9.0-windows（無 UseWPF）：純 net9.0 專案無法參考 net9.0-windows 的
       Vaeron.HelixStudio.Internal.Runtime（NU1201），即使本專案不使用任何 WPF 型別。 -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Vaeron.Kernel\Vaeron.Kernel.csproj" />
    <ProjectReference Include="..\Vaeron.HelixStudio.Internal.Runtime\Vaeron.HelixStudio.Internal.Runtime.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
