<UserControl x:Class="Vaeron.HelixStudio.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:eventLog="clr-namespace:Vaeron.HelixStudio.EventLog;assembly=Vaeron.HelixStudio.EventLog"
             xmlns:local="clr-namespace:Vaeron.HelixStudio.Settings"
             xmlns:root="clr-namespace:Vaeron.HelixStudio.Internal.Runtime;assembly=Vaeron.HelixStudio.Internal.Runtime"
             xmlns:components="clr-namespace:Vaeron.HelixStudio.Internal.Runtime.Components;assembly=Vaeron.HelixStudio.Internal.Runtime"
             xmlns:runtime="clr-namespace:Vaeron.HelixStudio.Internal.Runtime.Themes;assembly=Vaeron.HelixStudio.Internal.Runtime"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <eventLog:SeverityToTextConverter x:Key="SeverityToText" />
        <root:NavKeyEqualsConverter x:Key="NavKeyEquals" />
        <local:WorkspaceRowMatchesConverter x:Key="WorkspaceRowMatches" />
        <local:WorkspaceIsActiveConverter x:Key="WorkspaceIsActive" />
        <local:WorkspaceRowExpandedConverter x:Key="WorkspaceRowExpanded" />
        <local:DeleteConfirmEnabledConverter x:Key="DeleteConfirmEnabled" />
        <local:CountGreaterThanOneConverter x:Key="CountGreaterThanOne" />
        <local:CheckUpdateLabelConverter x:Key="CheckUpdateLabel" />
        <local:RetentionDaysToLabelConverter x:Key="RetentionDaysToLabel" />
        <local:SleepMinutesToLabelConverter x:Key="SleepMinutesToLabel" />
        <local:IdleLockMinutesToLabelConverter x:Key="IdleLockMinutesToLabel" />

        <DataTemplate x:Key="SleepMinutesItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource SleepMinutesToLabel}}" />
        </DataTemplate>
        <DataTemplate x:Key="IdleLockMinutesItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource IdleLockMinutesToLabel}}" />
        </DataTemplate>
        <DataTemplate x:Key="RetentionDaysItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource RetentionDaysToLabel}}" />
        </DataTemplate>

        <!-- 設定列標籤＋說明文字，統一放列的左半邊 -->
        <Style x:Key="SettingRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SettingRowSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- 「僅供展示」這類小標籤：對齊 blueprint SettingsScreen.dc.html 無邊框、底色 bg-hover。
             CornerRadius 刻意不用 999——WPF 的 Border.CornerRadius 不像 CSS border-radius 會自動夾到
             「不超過邊長一半」，徽章實際高度只有約 13~15px，設 999 會讓兩端圓角弧線互相重疊蓋過直邊，
             視覺上塌成橢圓形；6 已低於此徽章任何合理字型渲染下高度的一半，兩端仍呈現全圓角的膠囊形。 -->
        <Style x:Key="InlineBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 「全域」標籤：套用警示色而非中性灰，對齊 blueprint 第 313 行 -->
        <Style x:Key="InlineBadgeWarningStyle" TargetType="Border" BasedOn="{StaticResource InlineBadgeStyle}">
            <Setter Property="Background" Value="{DynamicResource StatusWarningBgBrush}" />
        </Style>
        <!-- 分類標題（工作區管理／外觀／電源…）：對齊 blueprint 各 settings-cat-* 節點，
             fs-xs／700／accent-label，不是頁面主標題那種大字體黑體 -->
        <Style x:Key="CategorySectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLabelBrush}" />
        </Style>

        <DataTemplate x:Key="CategoryNavTemplate">
            <Button Content="{Binding Label}"
                    Command="{Binding DataContext.ApplySelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Key}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource NavKeyEquals}">
                                        <Binding Path="Key" />
                                        <Binding Path="DataContext.SelectedCategoryKey" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側分類導覽＋搜尋 -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="設定" Style="{StaticResource BaseTextStyle}"
                       FontSize="{StaticResource FontSizeH1}" FontWeight="{DynamicResource FontWeightStrong}" Margin="0,0,0,12" />
            <TextBox Style="{StaticResource AppSearchBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     runtime:TextBoxPlaceholder.Text="搜尋設定項目" ToolTip="搜尋設定項目" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryNavTemplate}" />
            <TextBlock Text="沒有符合條件的設定項目" Style="{StaticResource BaseTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasNoCategoryMatch, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720">

                <!-- 工作區管理 -->
                <Border x:Name="Section_workspace" Visibility="{Binding IsWorkspaceCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="工作區（產線）管理" Style="{StaticResource CategorySectionHeaderStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="＋ 新增工作區" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                    Command="{Binding ApplyToggleAddWorkspaceCommand}" />
                        </Grid>
                        </Border>

                        <!-- 新增工作區表單：點「＋新增工作區」才展開 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,8"
                                Visibility="{Binding IsAddingWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource AppTextBoxStyle}" runtime:TextBoxPlaceholder.Text="名稱"
                                         Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" runtime:TextBoxPlaceholder.Text="描述（選填）"
                                         Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="4" Content="新增" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ApplyAddWorkspaceCommand}" />
                                <Button Grid.Column="6" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ApplyToggleAddWorkspaceCommand}" />
                            </Grid>
                        </Border>

                        <!-- 工作區清單表格：比照「已安裝工具」的表格結構，DataGrid 包一層 CardBorderStyle -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Workspaces}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                                        <Setter Property="DetailsVisibility">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource WorkspaceRowExpanded}">
                                                    <Binding Path="Workspace.Id" />
                                                    <Binding Path="DataContext.EditingWorkspace" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                    <Binding Path="DataContext.DeleteTarget" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="使用中" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 點圓點切換工作區，範圍僅限這一欄，不會誤觸展開列內的動作 -->
                                                <Border Cursor="Hand" Background="Transparent" Padding="8,0">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ApplySwitchWorkspaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                      CommandParameter="{Binding Workspace}" />
                                                    </Border.InputBindings>
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentSolidBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Ellipse.Visibility>
                                                            <MultiBinding Converter="{StaticResource WorkspaceIsActive}">
                                                                <Binding Path="Workspace.Id" />
                                                                <Binding Path="DataContext.ActiveWorkspaceId" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                            </MultiBinding>
                                                        </Ellipse.Visibility>
                                                    </Ellipse>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="名稱" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Workspace.Name, Mode=OneWay}" FontWeight="{DynamicResource FontWeightStrong}" Style="{StaticResource BaseTextStyle}" />
                                                    <TextBlock Text="{Binding Workspace.Description}" Style="{StaticResource BaseTextStyle}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="事件數" Width="80" Binding="{Binding EventCount, Mode=OneWay}" />
                                    <DataGridTemplateColumn Header="操作" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="編輯工作區"
                                                            Command="{Binding DataContext.ApplyStartEditWorkspaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Workspace}">
                                                        <components:IconGlyph IconData="{StaticResource IconPencilGeometry}" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                                            ToolTip="刪除此工作區（至少要保留一個工作區）"
                                                            Command="{Binding DataContext.ApplyRequestDeleteWorkspaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Workspace}">
                                                        <Button.IsEnabled>
                                                            <Binding Path="DataContext.Workspaces.Count" RelativeSource="{RelativeSource AncestorType=DataGrid}"
                                                                     Converter="{StaticResource CountGreaterThanOne}" />
                                                        </Button.IsEnabled>
                                                        <components:IconGlyph IconData="{StaticResource IconTrashGeometry}" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowDetailsBorderStyle}">
                                            <StackPanel>
                                                <!-- 編輯表單 -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource WorkspaceRowMatches}">
                                                            <Binding Path="Workspace.Id" />
                                                            <Binding Path="DataContext.EditingWorkspace" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Column="2" Style="{StaticResource AppTextBoxStyle}"
                                                                 Text="{Binding EditWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="4" Content="儲存" Style="{StaticResource PrimaryButtonStyle}"
                                                                Command="{Binding ApplySaveEditWorkspaceCommand}" />
                                                        <Button Grid.Column="6" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding ApplyCancelEditWorkspaceCommand}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- 刪除確認：輸入完整名稱才能刪除 -->
                                                <StackPanel>
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource WorkspaceRowMatches}">
                                                            <Binding Path="Workspace.Id" />
                                                            <Binding Path="DataContext.DeleteTarget" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <TextBlock Style="{StaticResource BaseTextStyle}" TextWrapping="Wrap" Foreground="{DynamicResource StatusErrorTextBrush}">
                                                            <Run Text="此動作無法復原，且會一併刪除此工作區底下的所有事件記錄。請輸入「" />
                                                            <Run Text="{Binding DeleteTarget.Name, Mode=OneWay}" FontWeight="{DynamicResource FontWeightStrong}" />
                                                            <Run Text="」以確認刪除。" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBox Width="160" Style="{StaticResource AppTextBoxStyle}" Text="{Binding DeleteConfirmText, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Content="確認刪除" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                                                    Command="{Binding ApplyConfirmDeleteWorkspaceCommand}">
                                                                <Button.IsEnabled>
                                                                    <MultiBinding Converter="{StaticResource DeleteConfirmEnabled}">
                                                                        <Binding Path="DeleteConfirmText" />
                                                                        <Binding Path="DeleteTarget" />
                                                                    </MultiBinding>
                                                                </Button.IsEnabled>
                                                            </Button>
                                                            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"
                                                                    Command="{Binding ApplyCancelDeleteWorkspaceCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 外觀 -->
                <Border x:Name="Section_appearance" Visibility="{Binding IsAppearanceCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="外觀" Style="{StaticResource CategorySectionHeaderStyle}" Margin="0,16,0,0" />
                        <TextBlock Text="以下設定套用到整個軟體，所有工作區共用，不是單一工作區各自的設定" Style="{StaticResource SettingRowSubtitleStyle}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="介面縮放（Zoom）" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="以畫面縮放調整整體介面大小，非個別元件尺寸" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="80" ItemsSource="{Binding UiScaleOptions}" SelectedItem="{Binding UiScalePercent}" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource BaseTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- 主題：卡片由掃描主題資料夾動態產生，不是寫死的選項 -->
                        <StackPanel Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="主題" Style="{StaticResource SettingRowLabelStyle}" />
                                    <TextBlock Text="套用到全部畫面的顏色與文字樣式；把主題包資料夾放進主題資料夾即可新增"
                                               Style="{StaticResource SettingRowSubtitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="開啟主題資料夾" Style="{StaticResource TextButtonStyle}"
                                            Command="{Binding ApplyOpenThemeFolderCommand}" />
                                    <Button Content="重新掃描" Style="{StaticResource TextButtonStyle}" Margin="12,0,0,0"
                                            Command="{Binding ApplyRefreshThemePacksCommand}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="背景動畫" Style="{StaticResource SettingRowLabelStyle}" />
                                    <TextBlock Text="關閉後，主題宣告的動態背景不會播放（優先於主題設定）"
                                               Style="{StaticResource SettingRowSubtitleStyle}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                              IsChecked="{Binding BackgroundAnimationEnabled}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ThemePacks}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 迷你視窗樣本：側邊欄色條＋主背景＋強調色塊＋文字色，四色同呈才看得出主題長相 -->
                                        <Button Width="148" Height="96" Margin="0,0,12,12" Cursor="Hand"
                                                Command="{Binding DataContext.ApplySelectThemePackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="6" ClipToBounds="True"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            BorderBrush="{TemplateBinding BorderBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 側邊欄樣本 -->
                                                            <Border Grid.Column="0" Background="{Binding PreviewSidebar}" />

                                                            <!-- 主背景樣本 -->
                                                            <Grid Grid.Column="1" Background="{Binding PreviewBackground}" Margin="8">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- 強調色塊樣本 -->
                                                                <Border Grid.Row="0" Background="{Binding PreviewAccent}" CornerRadius="3"
                                                                        Width="34" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" />

                                                                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BaseTextStyle}"
                                                                           Foreground="{Binding PreviewText}"
                                                                           FontWeight="{DynamicResource FontWeightStrong}" TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource NavKeyEquals}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.ThemePackId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderThickness" Value="2.5" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="資料密度" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="表格與清單的每列高度" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentedButtonGroupBorderStyle}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="舒適" Tag="7,0,0,7"
                                            Command="{Binding ApplySelectDensityCommand}" CommandParameter="comfortable">
                                        <Button.Style>
                                            <MultiBinding Converter="{StaticResource ObjectEqualsToSegmentedButtonStyle}">
                                                <Binding Path="DensityKey" />
                                                <Binding Source="comfortable" />
                                            </MultiBinding>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="精簡" Tag="0,7,7,0"
                                            Command="{Binding ApplySelectDensityCommand}" CommandParameter="compact">
                                        <Button.Style>
                                            <MultiBinding Converter="{StaticResource ObjectEqualsToSegmentedButtonStyle}">
                                                <Binding Path="DensityKey" />
                                                <Binding Source="compact" />
                                            </MultiBinding>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="重設外觀為預設值" Style="{StaticResource TextButtonStyle}"
                                    Command="{Binding ApplyResetAppearanceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 電源 -->
                <Border x:Name="Section_power" Visibility="{Binding IsPowerCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="電源" Style="{StaticResource CategorySectionHeaderStyle}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource InlineBadgeWarningStyle}" Margin="0"><TextBlock Text="全域" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource StatusWarningTextBrush}" /></Border>
                            <TextBlock Text="以下設定會直接變更本機 Windows 電源設定，套用到整台電腦，不限本軟體視窗；休眠與快速啟動需要系統管理員權限才能生效" Style="{StaticResource SettingRowSubtitleStyle}" Margin="6,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="目前電源模式" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="影響 CPU 效能與整體省電程度" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentedButtonGroupBorderStyle}" HorizontalAlignment="Right">
                                <!-- AlternationCount 開啟 AlternationIndex（預設 0 時停用），設大於實際項目數避免被 mod 循環，
                                     搭配 SegmentCornerRadiusConverter 讓頭尾兩顆自己畫圓角（理由見 SegmentedButtonStyle 註解）。 -->
                                <ItemsControl ItemsSource="{Binding PowerModeOptions}" AlternationCount="100">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.ApplySelectPowerModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Tag>
                                                    <MultiBinding Converter="{StaticResource SegmentCornerRadiusConverter}">
                                                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                                                        <Binding Path="DataContext.PowerModeOptions.Length" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.Tag>
                                                <Button.Style>
                                                    <MultiBinding Converter="{StaticResource ObjectEqualsToSegmentedButtonStyle}">
                                                        <Binding Path="." />
                                                        <Binding Path="DataContext.PowerMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="插電時，進入睡眠" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="接上電源時，閒置多久後進入睡眠" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding SleepMinutesOptions}" SelectedItem="{Binding AcSleepMinutes}"
                                      ItemTemplate="{StaticResource SleepMinutesItemTemplate}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="電池電力時，進入睡眠" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="使用電池時，閒置多久後進入睡眠" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding SleepMinutesOptions}" SelectedItem="{Binding BatterySleepMinutes}"
                                      ItemTemplate="{StaticResource SleepMinutesItemTemplate}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="螢幕逾時" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="閒置多久後關閉螢幕（不影響是否進入睡眠）" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding SleepMinutesOptions}" SelectedItem="{Binding ScreenTimeoutMinutes}"
                                      ItemTemplate="{StaticResource SleepMinutesItemTemplate}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="休眠（Hibernate）" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="允許系統在深度省電時將記憶體內容寫入磁碟並關機" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="休眠（Hibernate）" IsChecked="{Binding HibernateEnabled}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="快速啟動（Fast Startup）" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="縮短開機時間；產線設備建議關閉，避免週邊裝置未正確重新初始化" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="快速啟動（Fast Startup）" IsChecked="{Binding FastStartupEnabled}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="按下電源按鈕時" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="實體電源鍵被按下時執行的動作" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center" ItemsSource="{Binding PowerButtonActionOptions}" SelectedItem="{Binding PowerButtonAction}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="闔上筆電螢幕時" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="僅適用於筆記型電腦；桌上型主機無此項目可忽略" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center" ItemsSource="{Binding PowerButtonActionOptions}" SelectedItem="{Binding LidCloseAction}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 一般 -->
                <Border x:Name="Section_general" Visibility="{Binding IsGeneralCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="一般" Style="{StaticResource CategorySectionHeaderStyle}" Margin="0,16,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="介面語言" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeStyle}"><TextBlock Text="僅供展示" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="套用到全部畫面與選單的顯示語言" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="啟動時開啟頁面" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeStyle}"><TextBlock Text="僅供展示" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="軟體啟動後預設顯示的畫面" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding StartupPageOptions}" SelectedItem="{Binding StartupPage}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="閒置鎖定" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeStyle}"><TextBlock Text="僅供展示" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="無操作一段時間後鎖定畫面" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding IdleLockMinutesOptions}" SelectedItem="{Binding IdleLockMinutes}"
                                      ItemTemplate="{StaticResource IdleLockMinutesItemTemplate}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="預設摺疊側邊欄" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="立即套用，也會是下次開啟時的狀態" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="預設摺疊側邊欄" IsChecked="{Binding SidebarCollapsedByDefault}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="開機時自動啟動本軟體" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="隨系統啟動，於背景待命" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="開機時自動啟動本軟體" IsChecked="{Binding StartWithWindows}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 通知 -->
                <Border x:Name="Section_notifications" Visibility="{Binding IsNotificationsCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="通知" Style="{StaticResource CategorySectionHeaderStyle}" Margin="0,16,0,0" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="顯示未讀事件徽章" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="關閉後，上方通知鈴鐺不會再顯示紅點數字" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="顯示未讀事件徽章" IsChecked="{Binding ShowEventBadge}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 日誌 -->
                <Border x:Name="Section_log" Visibility="{Binding IsLogCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="日誌" Style="{StaticResource CategorySectionHeaderStyle}" Margin="0,16,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="最低記錄等級" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeWarningStyle}"><TextBlock Text="全域" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource StatusWarningTextBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="低於此等級的事件不會被記錄，套用到所有工作區——調低門檻會讓其他工作區的事件也一起停止記錄，不限於目前選取的工作區" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding MinLogLevel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SeverityToText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="記錄保留期限" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeStyle}"><TextBlock Text="僅供展示" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="超過此天數的日誌會自動清除" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding RetentionDaysOptions}" SelectedItem="{Binding RetentionDays}"
                                      ItemTemplate="{StaticResource RetentionDaysItemTemplate}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="輸出位置" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="匯出日誌與事件記錄時的存放資料夾" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExportPathDisplay}" VerticalAlignment="Center" Style="{StaticResource BaseTextStyle}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                <Button Content="瀏覽…" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ApplyChooseExportPathCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="編碼" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeStyle}"><TextBlock Text="僅供展示" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="匯出檔案使用的文字編碼" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="100" VerticalAlignment="Center" ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding Encoding}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="時區" Style="{StaticResource SettingRowLabelStyle}" />
                                    <Border Style="{StaticResource InlineBadgeStyle}"><TextBlock Text="僅供展示" FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextMutedBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Text="匯出記錄之時間戳記所使用的時區" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" ItemsSource="{Binding TimeZoneOptions}" SelectedItem="{Binding TimeZone}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="匯出事件記錄" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="依上述設定，下載目前工作區的完整事件記錄，不受「事件日誌」頁面當下的搜尋／篩選影響" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="匯出" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                    Command="{Binding ApplyExportEventsCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

