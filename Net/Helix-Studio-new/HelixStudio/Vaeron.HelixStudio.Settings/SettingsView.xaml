                            </StackPanel>
                            <Button Grid.Column="1" Content="查看" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" VerticalAlignment="Center" ToolTip="原型範圍：內容待補" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="系統需求" Style="{StaticResource SettingRowLabelStyle}" />
