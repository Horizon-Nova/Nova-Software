                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="版本：" /><Run Text="{Binding VersionText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="建置日期：" /><Run Text="{Binding BuildDateText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BaseTextStyle}">
                            <Run Text="平台：" /><Run Text="{Binding PlatformText, Mode=OneWay}" />
                        </TextBlock>

