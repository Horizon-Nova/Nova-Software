                                <TextBlock Text="授權類型" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="隨此軟體安裝提供，不需另外啟用" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="已啟用（一般金鑰／無到期欄位）" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="到期日" Style="{StaticResource SettingRowLabelStyle}" />
                                <TextBlock Text="系統啟動時自動驗證授權狀態" Style="{StaticResource SettingRowSubtitleStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="無到期日" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
