<Window x:Class="Vaeron.InSpecTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vaeron.InSpecTool"
        Title="InSpec 量測助手" Height="640" Width="920" MinHeight="480" MinWidth="720"
        Background="{DynamicResource BgPageBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
        ShowInTaskbar="False" WindowStartupLocation="Manual" Left="-32000" Top="-32000">
        <!-- 定位在螢幕外＋不進工作列：這個視窗永遠不該以獨立浮窗形式讓使用者看到，
             一律等 Helix Studio 端 SetParent 把它嵌進殼層畫面後才會出現在螢幕上。 -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <TextBlock Grid.Row="0" Text="InSpec 量測助手" FontSize="{StaticResource FontSizeH1}"
                   FontWeight="{DynamicResource FontWeightStrong}" Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,12" />

        <!-- 連線狀態列 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ConnectionStatus.Connected}">
                                        <Setter Property="Fill" Value="{DynamicResource StatusSuccessSolidBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ConnectionStatus.Scanning}">
                                        <Setter Property="Fill" Value="{DynamicResource AccentSolidBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ConnectionStatus.LaunchFailed}">
                                        <Setter Property="Fill" Value="{DynamicResource SeverityErrorSolidBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}" FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDetail, StringFormat=（{0}）}" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="啟動 InSpec" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LaunchCommand}" Margin="0,0,8,0" />
                    <Button Content="掃描並連接" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主體：左側檔案搜尋，右側結果 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左側：搜尋 .iwp -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="量測程式（.iwp）" FontWeight="{DynamicResource FontWeightMedium}"
                               Margin="0,0,0,10" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBoxStyle}" IsReadOnly="True"
                                 Text="{Binding SearchDirectory, Mode=OneWay}"
                                 Tag="選擇搜尋目錄…" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="瀏覽…" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseFolderCommand}" />
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBoxStyle}"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="篩選檔名…" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="搜尋" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SearchCommand}" />
                    </Grid>

                    <Grid>
                        <ListBox ItemsSource="{Binding IwpFiles}" SelectedItem="{Binding SelectedIwp}"
                                 BorderThickness="0" Background="Transparent" />
                        <TextBlock Text="尚無搜尋結果" Style="{StaticResource TableEmptyStateTextStyle}"
                                   Visibility="{Binding IwpFiles.Count, Converter={StaticResource CountToEmptyVisibilityConverter}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右側：執行與結果 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="量測結果" FontWeight="{DynamicResource FontWeightMedium}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="執行" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunCommand}" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding RunFeedback}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSm}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Results}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="欄位 1" Binding="{Binding Column1}" Width="*" />
                                <DataGridTextColumn Header="欄位 2" Binding="{Binding Column2}" Width="*" />
                                <DataGridTextColumn Header="欄位 3" Binding="{Binding Column3}" Width="*" />
                                <DataGridTextColumn Header="欄位 4" Binding="{Binding Column4}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="尚無結果，選擇量測程式後點擊「執行」" Style="{StaticResource TableEmptyStateTextStyle}"
                                   Visibility="{Binding Results.Count, Converter={StaticResource CountToEmptyVisibilityConverter}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部工具列 -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleMainWindowCommand}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="隱藏 InSpec 主視窗" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainWindowVisible}" Value="False">
                                        <Setter Property="Text" Value="顯示 InSpec 主視窗" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
