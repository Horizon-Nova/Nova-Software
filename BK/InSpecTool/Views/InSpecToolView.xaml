<UserControl x:Class="ExternalModules.InSpecTool.Views.InSpecToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ExternalModules.InSpecTool.Core"
             xmlns:converters="clr-namespace:ExternalModules.InSpecTool.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InSpecTool;component/Themes/InSpecToolTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:FilePathEqualsConverter x:Key="FilePathEqualsConverter"/>

            <Style x:Key="InSpecFileListItemStyle" TargetType="ListViewItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="4,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ShellPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
                                </Trigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource FilePathEqualsConverter}">
                                            <Binding Path="FilePath"/>
                                            <Binding ElementName="Root" Path="LastClickedFilePath"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ShellPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.42*"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="0.58*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="條碼解析"
                           Style="{StaticResource InSpecPageTitleStyle}"/>
                <TextBlock x:Name="AutomationStatusText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource ShellMutedForegroundBrush}"
                           Text="自動監控：關閉"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MinHeight="28">
                    <TextBox x:Name="BarcodeInputBox"
                             Style="{StaticResource InSpecBarcodeTextFieldStyle}"
                             GotKeyboardFocus="BarcodeInputBox_OnFocusChanged"
                             LostKeyboardFocus="BarcodeInputBox_OnFocusChanged"
                             TextChanged="BarcodeInputBox_OnTextChanged"/>
                    <TextBlock x:Name="BarcodeInputPlaceholderText"
                               Text="請輸入或掃描完整條碼"
                               Margin="8,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellMutedForegroundBrush}"
                               IsHitTestVisible="False"/>
                </Grid>
                <Button Grid.Column="2"
                        Content="清除"
                        VerticalAlignment="Center"
                        Style="{StaticResource InSpecJavaButtonStyle}"
                        Click="ClearButton_OnClick"/>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          Margin="0,20,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          BorderThickness="0">
                <ItemsControl ItemsSource="{Binding ElementName=Root, Path=Fields}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:PreviewFieldItem}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label, StringFormat={}{0}:}"
                                           Style="{StaticResource InSpecFieldLabelStyle}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         Style="{StaticResource InSpecParsedFieldTextBoxStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Style="{StaticResource InSpecSplitDividerStyle}"/>

        <Grid Grid.Column="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileListTitleText"
                           Grid.Column="0"
                           Text="檔案結果"
                           VerticalAlignment="Center"
                           Style="{StaticResource InSpecPageTitleStyle}"/>
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Content="重新搜尋"
                        VerticalAlignment="Center"
                        Style="{StaticResource InSpecJavaRefreshButtonStyle}"
                        Click="QueryRefreshButton_OnClick"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ListView x:Name="FileResultListView"
                          Style="{StaticResource InSpecFileListViewStyle}"
                          ItemContainerStyle="{StaticResource InSpecFileListItemStyle}"
                          ItemsSource="{Binding ElementName=Root, Path=Results}"
                          PreviewMouseLeftButtonDown="FileResultListView_OnPreviewMouseLeftButtonDown"
                          MouseDoubleClick="FileResultListView_OnMouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:PreviewResultItem}">
                            <TextBlock Text="{Binding FileName}"
                                       Style="{StaticResource InSpecFileNameBoldStyle}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="FileListPlaceholderText"
                           Text="尚未找到檔案"
                           Style="{StaticResource InSpecPlaceholderTextStyle}"
                           Panel.ZIndex="1"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
