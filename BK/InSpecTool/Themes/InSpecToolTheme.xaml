<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="InSpecPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSize400}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}"/>
    </Style>

    <Style x:Key="InSpecFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSize350}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="InSpecFileNameBoldStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSize350}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}"/>
    </Style>

    <Style x:Key="InSpecPlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedForegroundBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSize350}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InSpecJavaButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellSettingsActionButtonStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="InSpecJavaRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellSettingsActionButtonStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="InSpecJavaTextFieldStyle" TargetType="TextBox" BasedOn="{StaticResource ShellSettingsTextBoxStyle}">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InSpecBarcodeTextFieldStyle" TargetType="TextBox" BasedOn="{StaticResource InSpecJavaTextFieldStyle}">
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style x:Key="InSpecParsedFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InSpecJavaTextFieldStyle}">
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style x:Key="InSpecFileListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource ShellPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="InSpecSplitDividerStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource ShellLineBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShellInteractiveBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
