<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="InSpecPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="InSpecFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="12"/>
        <Setter Property="FontWeight"        Value="Medium"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="InSpecFileNameBoldStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="InSpecPlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"         Value="{DynamicResource TextTertiary}"/>
        <Setter Property="FontSize"           Value="12"/>
        <Setter Property="TextAlignment"      Value="Center"/>
        <Setter Property="VerticalAlignment"  Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Base text-field: plain bordered TextBox consistent with Helix-Studio settings inputs -->
    <Style x:Key="InSpecBaseTextFieldStyle" TargetType="TextBox">
        <Setter Property="Background"              Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="BorderBrush"             Value="{DynamicResource BorderMedium}"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="Foreground"              Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding"                 Value="8,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize"                Value="12"/>
    </Style>

    <Style x:Key="InSpecJavaTextFieldStyle" TargetType="TextBox"
           BasedOn="{StaticResource InSpecBaseTextFieldStyle}">
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="InSpecBarcodeTextFieldStyle" TargetType="TextBox"
           BasedOn="{StaticResource InSpecJavaTextFieldStyle}">
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style x:Key="InSpecParsedFieldTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource InSpecJavaTextFieldStyle}">
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <!-- Action buttons: map to shell GhostButton -->
    <Style x:Key="InSpecJavaButtonStyle" TargetType="Button"
           BasedOn="{StaticResource GhostButton}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding"   Value="12,6"/>
    </Style>

    <Style x:Key="InSpecJavaRefreshButtonStyle" TargetType="Button"
           BasedOn="{StaticResource GhostButton}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding"   Value="12,6"/>
    </Style>

    <!-- File ListView -->
    <Style x:Key="InSpecFileListViewStyle" TargetType="ListView">
        <Setter Property="Background"                             Value="{DynamicResource SurfaceBase}"/>
        <Setter Property="BorderBrush"                            Value="{DynamicResource BorderLight}"/>
        <Setter Property="BorderThickness"                        Value="1"/>
        <Setter Property="Foreground"                             Value="{DynamicResource TextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="Padding"                                Value="0"/>
    </Style>

    <!-- Splitter divider -->
    <Style x:Key="InSpecSplitDividerStyle" TargetType="GridSplitter">
        <Setter Property="Width"              Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background"         Value="{DynamicResource BorderLight}"/>
        <Setter Property="BorderThickness"    Value="0"/>
        <Setter Property="ShowsPreview"       Value="False"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
