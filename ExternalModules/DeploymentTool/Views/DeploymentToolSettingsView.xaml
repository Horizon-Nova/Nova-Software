<UserControl x:Class="ExternalModules.DeploymentTool.Views.DeploymentToolSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,8">
        <TextBlock Text="部署工具設定"
                   FontSize="{DynamicResource ShellFontSize500}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellForegroundBrush}"/>
        <TextBlock Margin="0,6,0,0"
                   Text="第一版先定義部署專案的預設模板、資源與 Docker 描述方式，後續再接虛擬機建立與實際部署流程。"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ShellMutedForegroundBrush}"/>

        <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style x:Key="DeploymentSettingsRowStyle" TargetType="Grid">
                    <Setter Property="Margin" Value="0,0,0,14"/>
                </Style>
            </Grid.Resources>

            <Grid Grid.Row="0" Style="{StaticResource DeploymentSettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" MaxWidth="320"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,18,0"
                           Text="Linux 模板"
                           Style="{DynamicResource ShellSettingsRowTitleStyle}"/>
                <ComboBox Grid.Column="1"
                          x:Name="TemplateComboBox"
                          Style="{DynamicResource ShellSettingsComboBoxStyle}"
                          SelectionChanged="TemplateComboBox_OnSelectionChanged"/>
            </Grid>

            <Grid Grid.Row="1" Style="{StaticResource DeploymentSettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" MaxWidth="320"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,18,0"
                           Text="預設 vCPU"
                           Style="{DynamicResource ShellSettingsRowTitleStyle}"/>
                <ComboBox Grid.Column="1"
                          x:Name="DefaultCpuComboBox"
                          Style="{DynamicResource ShellSettingsComboBoxStyle}"
                          SelectionChanged="DefaultCpuComboBox_OnSelectionChanged"/>
            </Grid>

            <Grid Grid.Row="2" Style="{StaticResource DeploymentSettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" MaxWidth="320"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,18,0"
                           Text="預設 RAM (MB)"
                           Style="{DynamicResource ShellSettingsRowTitleStyle}"/>
                <ComboBox Grid.Column="1"
                          x:Name="DefaultMemoryComboBox"
                          Style="{DynamicResource ShellSettingsComboBoxStyle}"
                          SelectionChanged="DefaultMemoryComboBox_OnSelectionChanged"/>
            </Grid>

            <Grid Grid.Row="3" Style="{StaticResource DeploymentSettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" MaxWidth="320"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,18,0"
                           Text="Docker 模式"
                           Style="{DynamicResource ShellSettingsRowTitleStyle}"/>
                <ComboBox Grid.Column="1"
                          x:Name="DockerModeComboBox"
                          Style="{DynamicResource ShellSettingsComboBoxStyle}"
                          SelectionChanged="DockerModeComboBox_OnSelectionChanged"/>
            </Grid>

            <Grid Grid.Row="4" Style="{StaticResource DeploymentSettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" MaxWidth="320"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,18,0"
                           Text="專案工作目錄"
                           Style="{DynamicResource ShellSettingsRowTitleStyle}"/>
                <TextBox Grid.Column="1"
                         x:Name="WorkspaceTextBox"
                         Style="{DynamicResource ShellSettingsTextBoxStyle}"
                         LostKeyboardFocus="WorkspaceTextBox_OnLostKeyboardFocus"/>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" MaxWidth="320"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,18,0"
                           Text="建立後自動啟動部署"
                           Style="{DynamicResource ShellSettingsRowTitleStyle}"/>
                <CheckBox Grid.Column="1"
                          x:Name="AutoStartCheckBox"
                          Content="建立部署專案後直接帶入下一步"
                          Foreground="{DynamicResource ShellForegroundBrush}"
                          Checked="AutoStartCheckBox_OnChanged"
                          Unchecked="AutoStartCheckBox_OnChanged"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ShellMutedForegroundBrush}"/>
    </StackPanel>
</UserControl>
