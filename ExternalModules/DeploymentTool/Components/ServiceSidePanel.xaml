<UserControl x:Class="ExternalModules.DeploymentTool.Components.ServiceSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource ShellSecondaryBrush}"
            BorderBrush="{DynamicResource ShellLineBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="28,24,28,18"
                    BorderBrush="{DynamicResource ShellLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="42"
                                Height="42"
                                Background="#F5F5F3"
                                CornerRadius="21"
                                VerticalAlignment="Center"/>

                        <TextBlock Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title, ElementName=Root}"
                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            Click="CloseButton_OnClick">
                        <TextBlock Text="X"
                                   FontSize="16"
                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="28,0,28,0"
                    BorderBrush="{DynamicResource ShellLineBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,24,14"
                               Text="Deployments"
                               Foreground="{DynamicResource ShellForegroundBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,0,24,14"
                               Text="Variables"
                               Foreground="{DynamicResource ShellMutedForegroundBrush}"
                               FontSize="14"/>
                    <TextBlock Margin="0,0,24,14"
                               Text="Metrics"
                               Foreground="{DynamicResource ShellMutedForegroundBrush}"
                               FontSize="14"/>
                    <TextBlock Margin="0,0,0,14"
                               Text="Settings"
                               Foreground="{DynamicResource ShellMutedForegroundBrush}"
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,28">
                    <Border Padding="18"
                            Background="{DynamicResource ShellPrimaryBrush}"
                            BorderBrush="{DynamicResource ShellLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="Deployment details"
                                       Foreground="{DynamicResource ShellForegroundBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,8,0,0"
                                       Text="這裡先保留側欄骨架，之後再接真實服務內容。"
                                       Foreground="{DynamicResource ShellMutedForegroundBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
