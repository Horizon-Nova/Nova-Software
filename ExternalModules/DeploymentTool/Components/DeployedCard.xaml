<UserControl x:Class="ExternalModules.DeploymentTool.Components.DeployedCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Padding="20"
            Background="#121826"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Ellipse Width="32"
                         Height="32"
                         Fill="#F5F5F3"/>

                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding Title, ElementName=Root, TargetNullValue=Horizon_Nova, FallbackValue=Horizon_Nova}"
                               Foreground="#F7F4ED"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding Subtitle, ElementName=Root, TargetNullValue=horizonnova.up.railway.app, FallbackValue=horizonnova.up.railway.app}"
                               Foreground="#A5A8B7"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,20,0,0"
                        Orientation="Horizontal">
                <Ellipse Width="10"
                         Height="10"
                         Fill="#65D39B"
                         VerticalAlignment="Center"/>

                <TextBlock Margin="8,0,0,0"
                           Text="{Binding StatusText, ElementName=Root, TargetNullValue=Online, FallbackValue=Online}"
                           Foreground="#65D39B"
                           FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
