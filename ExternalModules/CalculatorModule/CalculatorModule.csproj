<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ExternalModules.CalculatorModule</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ModulePackageDirectory>$(MSBuildProjectDirectory)\PackageOutput\CalculatorModule</ModulePackageDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Net\HN-Studio.ModuleSdk\HN-Studio.ModuleSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Package\module.json" CopyToOutputDirectory="Never" />
    <None Include="Package\README.md" CopyToOutputDirectory="Never" />
    <None Include="Package\icon.svg" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="BuildModulePackage" AfterTargets="Build">
    <MakeDir Directories="$(ModulePackageDirectory)" />
    <MakeDir Directories="$(ModulePackageDirectory)\bin" />
    <Copy SourceFiles="Package\module.json" DestinationFiles="$(ModulePackageDirectory)\module.json" />
    <Copy SourceFiles="Package\README.md" DestinationFiles="$(ModulePackageDirectory)\README.md" />
    <Copy SourceFiles="Package\icon.svg" DestinationFiles="$(ModulePackageDirectory)\icon.svg" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(ModulePackageDirectory)\bin\$(TargetFileName)" />
    <Copy SourceFiles="$(TargetDir)HN-Studio.ModuleSdk.dll" DestinationFiles="$(ModulePackageDirectory)\bin\HN-Studio.ModuleSdk.dll" Condition="Exists('$(TargetDir)HN-Studio.ModuleSdk.dll')" />
  </Target>

</Project>
